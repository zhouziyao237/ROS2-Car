#!/usr/bin/env python3
import json
import math
from pathlib import Path

import rclpy
from rclpy.node import Node
from rclpy.time import Time

from geometry_msgs.msg import PoseStamped
from robot_logistics_interfaces.msg import SemanticObservation

import tf2_ros


class SemanticRegistrarNode(Node):
    """
    Register semantic shelf observations into semantic_library.json.

    Input:
      /vision/semantic_observation

    Output:
      semantic_library.json

    Policy:
      - QR decides shelf_id / column_id / layer_id.
      - Depth camera pose orientation gives QR plane normal.
      - The normal is transformed into map frame.
      - The normal is forced to face robot side.
      - Yaw jump guard prevents single-frame yaw flips.
      - Approach pose is generated from shelf pose and face normal.
      - No lidar-line yaw refinement is used.
    """

    def __init__(self):
        super().__init__('semantic_registrar_node')

        self.declare_parameter('semantic_map_path', '/host-home/maps/semantic_library.json')
        self.declare_parameter('input_topic', '/vision/semantic_observation')
        self.declare_parameter('map_frame', 'map')
        self.declare_parameter('robot_frame', 'base_link')
        self.declare_parameter('tf_timeout_sec', 0.5)

        self.declare_parameter('shelf_width', 1.85)
        self.declare_parameter('shelf_depth', 0.35)
        self.declare_parameter('shelf_height', 1.50)
        self.declare_parameter('approach_distance', 1.10)
        self.declare_parameter('default_cols', 3)

        self.declare_parameter('min_confidence', 0.20)
        self.declare_parameter('max_yaw_jump_deg', 30.0)
        self.declare_parameter('yaw_smooth_alpha', 0.35)
        self.declare_parameter('column_side_yaw_offset_deg', 90.0)

        self.semantic_map_path = Path(self.get_parameter('semantic_map_path').value)
        self.input_topic = str(self.get_parameter('input_topic').value)
        self.map_frame = str(self.get_parameter('map_frame').value)
        self.robot_frame = str(self.get_parameter('robot_frame').value)
        self.tf_timeout_sec = float(self.get_parameter('tf_timeout_sec').value)

        self.shelf_width = float(self.get_parameter('shelf_width').value)
        self.shelf_depth = float(self.get_parameter('shelf_depth').value)
        self.shelf_height = float(self.get_parameter('shelf_height').value)
        self.approach_distance = float(self.get_parameter('approach_distance').value)
        self.default_cols = int(self.get_parameter('default_cols').value)

        self.min_confidence = float(self.get_parameter('min_confidence').value)
        self.max_yaw_jump = math.radians(float(self.get_parameter('max_yaw_jump_deg').value))
        self.yaw_smooth_alpha = float(self.get_parameter('yaw_smooth_alpha').value)
        self.column_side_yaw_offset = math.radians(float(self.get_parameter('column_side_yaw_offset_deg').value))

        self.semantic_map_path.parent.mkdir(parents=True, exist_ok=True)

        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)

        self.sub = self.create_subscription(
            SemanticObservation,
            self.input_topic,
            self.obs_cb,
            20
        )

        self.get_logger().info('semantic_registrar_node started: QR depth yaw guarded mode')
        self.get_logger().info(f'input_topic={self.input_topic}')
        self.get_logger().info(f'semantic_map_path={self.semantic_map_path}')
        self.get_logger().info(f'map_frame={self.map_frame}, robot_frame={self.robot_frame}')
        self.get_logger().info('source policy: column_layer_qr_depth_fusion, no lidar_line_refined')

    # ------------------------------------------------------------------
    # Main callback
    # ------------------------------------------------------------------

    def obs_cb(self, obs: SemanticObservation):
        if obs.obs_type not in ['column_qr', 'layer_qr']:
            return

        if not obs.shelf_id:
            return

        if not obs.has_pose:
            self.get_logger().warn(f'ignore {obs.obs_type}: has_pose=false')
            return

        if float(obs.confidence) < self.min_confidence:
            self.get_logger().warn(
                f'ignore {obs.obs_type}: confidence={float(obs.confidence):.2f} too low'
            )
            return

        pose_map = self.transform_pose_to_map(obs.pose)
        if pose_map is None:
            return

        qr_x = float(pose_map.pose.position.x)
        qr_y = float(pose_map.pose.position.y)

        raw_yaw = self.quat_to_yaw(
            pose_map.pose.orientation.x,
            pose_map.pose.orientation.y,
            pose_map.pose.orientation.z,
            pose_map.pose.orientation.w,
        )

        nx = math.cos(raw_yaw)
        ny = math.sin(raw_yaw)

        # Make QR normal face the robot side.
        nx, ny = self.ensure_normal_faces_robot(qr_x, qr_y, nx, ny)
        obs_yaw = math.atan2(ny, nx)

        # IMPORTANT:
        # layer QR is on front face; column QR is on side face.
        # Convert observed QR normal to shelf front-face normal before fusion.
        shelf_front_yaw_obs = self.observation_yaw_to_shelf_front_yaw(obs, obs_yaw)

        stamp = self.stamp_to_float(obs.header.stamp)
        if stamp <= 0.0:
            stamp = self.get_clock().now().nanoseconds / 1e9

        data = self.load_semantic_map()
        shelf = self.ensure_shelf(data, obs.shelf_id)

        if obs.obs_type == 'column_qr':
            self.update_column_anchor(shelf, obs, qr_x, qr_y, obs_yaw, stamp)

        if obs.obs_type == 'layer_qr':
            self.update_layer_anchor(shelf, obs, qr_x, qr_y, obs_yaw, stamp)

        self.recompute_shelf_pose(shelf, obs, qr_x, qr_y, shelf_front_yaw_obs, stamp)
        self.save_semantic_map(data)

        cur = shelf.get('current_map_pose', {})
        self.get_logger().info(
            f'updated shelf semantic shelf={obs.shelf_id} '
            f'obs={obs.obs_type} face={obs.face} '
            f'column={obs.column_id} layer={obs.layer_id} '
            f'qr=({qr_x:.2f},{qr_y:.2f}) '
            f'normal=({math.cos(cur.get("yaw", obs_yaw)):.2f},{math.sin(cur.get("yaw", obs_yaw)):.2f}) '
            f'shelf_pose=({cur.get("x", 0.0):.2f},{cur.get("y", 0.0):.2f},{cur.get("yaw", 0.0):.2f}) '
            f'source=column_layer_qr_depth_fusion'
        )

    # ------------------------------------------------------------------
    # Semantic map IO
    # ------------------------------------------------------------------

    def load_semantic_map(self):
        if not self.semantic_map_path.exists():
            return {
                'version': 2,
                'semantic_mode': 'shelf_column_layer',
                'shelves': {}
            }

        try:
            return json.loads(self.semantic_map_path.read_text())
        except Exception as exc:
            self.get_logger().warn(f'failed to read semantic map, recreate: {repr(exc)}')
            return {
                'version': 2,
                'semantic_mode': 'shelf_column_layer',
                'shelves': {}
            }

    def save_semantic_map(self, data):
        data['version'] = 2
        data['semantic_mode'] = 'shelf_column_layer'

        tmp = self.semantic_map_path.with_suffix('.tmp')
        tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False))
        tmp.replace(self.semantic_map_path)

    def ensure_shelf(self, data, shelf_id):
        shelves = data.setdefault('shelves', {})

        if shelf_id not in shelves:
            shelves[shelf_id] = {
                'shelf_id': shelf_id,
                'column_id': '',
                'col': 0,
                'column_anchor': {
                    'seen': False
                },
                'layers': {},
                'current_map_pose': {
                    'valid': False
                },
                'approach_pose': {
                    'valid': False
                },
                'geometry': {
                    'width': self.shelf_width,
                    'depth': self.shelf_depth,
                    'height': self.shelf_height,
                    'source': 'nominal_size_column_layer_qr_depth_fusion'
                },
                'confidence': 0.0,
                'status': 'new',
                'last_seen': 0.0
            }

        return shelves[shelf_id]

    # ------------------------------------------------------------------
    # Anchor update
    # ------------------------------------------------------------------

    def update_column_anchor(self, shelf, obs, x, y, yaw, stamp):
        col = int(obs.col) if int(obs.col) > 0 else self.parse_col_id(obs.column_id)

        shelf['column_id'] = obs.column_id
        shelf['col'] = col

        shelf['column_anchor'] = {
            'seen': True,
            'column_id': obs.column_id,
            'col': col,
            'x': x,
            'y': y,
            'normal_x': math.cos(yaw),
            'normal_y': math.sin(yaw),
            'yaw': yaw,
            'stamp': stamp,
            'confidence': float(obs.confidence),
            'face': 'side',
            'source': 'column_qr_side_face'
        }

        side_anchors = shelf.setdefault('side_column_anchors', {})
        side_anchors[obs.column_id] = {
            'seen': True,
            'column_id': obs.column_id,
            'col': col,
            'x': x,
            'y': y,
            'side_normal_x': math.cos(yaw),
            'side_normal_y': math.sin(yaw),
            'side_yaw': yaw,
            'front_yaw_candidate': self.side_yaw_to_front_candidate(yaw),
            'stamp': stamp,
            'confidence': float(obs.confidence),
            'source': 'column_qr_side_face'
        }

    def update_layer_anchor(self, shelf, obs, x, y, yaw, stamp):
        row = int(obs.row) if int(obs.row) > 0 else self.parse_layer_id(obs.layer_id)

        layers = shelf.setdefault('layers', {})
        layers[obs.layer_id] = {
            'seen': True,
            'layer_id': obs.layer_id,
            'row': row,
            'x': x,
            'y': y,
            'normal_x': math.cos(yaw),
            'normal_y': math.sin(yaw),
            'yaw': yaw,
            'stamp': stamp,
            'confidence': float(obs.confidence)
        }

        # Layer QR is on shelf front face. It is the authoritative front anchor.
        shelf['front_anchor'] = {
            'seen': True,
            'layer_id': obs.layer_id,
            'row': row,
            'x': x,
            'y': y,
            'normal_x': math.cos(yaw),
            'normal_y': math.sin(yaw),
            'yaw': yaw,
            'stamp': stamp,
            'confidence': float(obs.confidence),
            'source': 'layer_qr_front_face'
        }

    # ------------------------------------------------------------------
    # Shelf pose fusion
    # ------------------------------------------------------------------


    def observation_yaw_to_shelf_front_yaw(self, obs, obs_yaw):
        """
        Convert QR plane normal yaw to shelf front-face normal yaw.

        Rule:
        - layer_qr is on front face, so obs_yaw is shelf front yaw.
        - column_qr is on side face, so rotate obs_yaw by column_side_yaw_offset.
        """
        face = str(getattr(obs, 'face', '')).lower()

        if obs.obs_type == 'column_qr' or face == 'side':
            return self.normalize_angle(obs_yaw + self.column_side_yaw_offset)

        return self.normalize_angle(obs_yaw)


    def recompute_shelf_pose(self, shelf, obs, qr_x, qr_y, obs_yaw, stamp):
        old_pose = shelf.get('current_map_pose', {})
        old_valid = bool(old_pose.get('valid', False))

        # Fusion priority:
        # 1. layer_qr/front anchor decides shelf front yaw.
        # 2. existing front anchor remains authoritative.
        # 3. column_qr/side can only create candidate pose if allow_side_qr_create_candidate_pose=True.
        if obs.obs_type == 'layer_qr':
            yaw_measurement = obs_yaw
            yaw_source = 'front_layer_qr'
            can_create_pose = True
        elif self.has_front_anchor(shelf):
            yaw_measurement = self.get_front_yaw(shelf)
            yaw_source = 'existing_front_layer_qr'
            can_create_pose = True
        elif self.allow_side_qr_create_candidate_pose:
            yaw_measurement = self.side_yaw_to_front_candidate(obs_yaw)
            yaw_source = 'side_column_qr_candidate'
            can_create_pose = True
        else:
            # Only side column QR is seen. Store anchor only, do not create full shelf mask.
            shelf['status'] = 'partial_side_column_anchor'
            shelf['last_seen'] = stamp
            return

        old_yaw = float(old_pose.get('yaw', yaw_measurement)) if old_valid else yaw_measurement
        shelf_yaw = self.guard_and_smooth_yaw(old_yaw, yaw_measurement, old_valid)

        sx, sy = self.estimate_shelf_center_from_observation(
            shelf,
            obs,
            qr_x,
            qr_y,
            shelf_yaw
        )

        nx = math.cos(shelf_yaw)
        ny = math.sin(shelf_yaw)

        approach_x = sx + self.approach_distance * nx
        approach_y = sy + self.approach_distance * ny
        approach_yaw = self.normalize_angle(shelf_yaw + math.pi)

        has_column = bool(shelf.get('column_anchor', {}).get('seen', False))
        has_layer = any(v.get('seen', False) for v in shelf.get('layers', {}).values())

        confidence = max(float(obs.confidence), float(shelf.get('confidence', 0.0)))

        shelf['current_map_pose'] = {
            'valid': True,
            'x': sx,
            'y': sy,
            'yaw': shelf_yaw,
            'stamp': stamp,
            'source': yaw_source,
            'fusion': {
                'has_column_qr': has_column,
                'has_layer_qr': has_layer,
                'yaw_guarded': True
            }
        }

        shelf['approach_pose'] = {
            'valid': True,
            'x': approach_x,
            'y': approach_y,
            'yaw': approach_yaw,
            'distance': self.approach_distance,
            'source': 'column_layer_qr_depth_fusion'
        }

        shelf['geometry'] = {
            'width': self.shelf_width,
            'depth': self.shelf_depth,
            'height': self.shelf_height,
            'source': 'nominal_size_column_layer_qr_depth_fusion'
        }

        shelf['confidence'] = confidence
        shelf['status'] = 'active'
        shelf['last_seen'] = stamp

    def estimate_shelf_center_from_observation(self, shelf, obs, qr_x, qr_y, shelf_yaw):
        nx = math.cos(shelf_yaw)
        ny = math.sin(shelf_yaw)

        tx = -ny
        ty = nx

        # QR tag is on shelf front face. Shelf center is behind the face.
        cx = qr_x - nx * (self.shelf_depth * 0.5)
        cy = qr_y - ny * (self.shelf_depth * 0.5)

        if obs.obs_type == 'column_qr':
            col = int(obs.col) if int(obs.col) > 0 else self.parse_col_id(obs.column_id)
            col_offset = self.column_offset_from_center(col)
            cx -= tx * col_offset
            cy -= ty * col_offset
            return cx, cy

        # For layer QR, prefer known column anchor for lateral placement.
        anchor = shelf.get('column_anchor', {})
        if anchor.get('seen', False):
            col = int(anchor.get('col', 0))
            col_offset = self.column_offset_from_center(col)

            ax = float(anchor.get('x', qr_x))
            ay = float(anchor.get('y', qr_y))

            cx = ax - nx * (self.shelf_depth * 0.5) - tx * col_offset
            cy = ay - ny * (self.shelf_depth * 0.5) - ty * col_offset

        return cx, cy

    def column_offset_from_center(self, col):
        if col <= 0:
            return 0.0

        cols = self.default_cols
        step = self.shelf_width / float(cols)
        center_col = (cols + 1.0) / 2.0

        return (float(col) - center_col) * step


    def has_front_anchor(self, shelf):
        return bool(shelf.get('front_anchor', {}).get('seen', False))

    def get_front_yaw(self, shelf):
        return float(shelf.get('front_anchor', {}).get('yaw', 0.0))

    def side_yaw_to_front_candidate(self, obs_yaw):
        return self.normalize_angle(obs_yaw + self.column_side_yaw_offset)


    # ------------------------------------------------------------------
    # Yaw guard
    # ------------------------------------------------------------------

    def guard_and_smooth_yaw(self, old_yaw, new_yaw, old_valid):
        if not old_valid:
            return self.normalize_angle(new_yaw)

        diff = self.yaw_diff_abs(old_yaw, new_yaw)

        if diff > self.max_yaw_jump:
            self.get_logger().warn(
                f'reject yaw jump old={old_yaw:.3f}, '
                f'new={new_yaw:.3f}, diff_deg={math.degrees(diff):.1f}'
            )
            return self.normalize_angle(old_yaw)

        alpha = self.yaw_smooth_alpha

        ox = math.cos(old_yaw)
        oy = math.sin(old_yaw)
        nx = math.cos(new_yaw)
        ny = math.sin(new_yaw)

        sx = (1.0 - alpha) * ox + alpha * nx
        sy = (1.0 - alpha) * oy + alpha * ny

        if abs(sx) < 1e-9 and abs(sy) < 1e-9:
            return self.normalize_angle(new_yaw)

        return math.atan2(sy, sx)

    # ------------------------------------------------------------------
    # TF
    # ------------------------------------------------------------------

    def transform_pose_to_map(self, pose_stamped):
        if not pose_stamped.header.frame_id:
            self.get_logger().warn('pose header.frame_id empty')
            return None

        if pose_stamped.header.frame_id == self.map_frame:
            return pose_stamped

        try:
            tf = self.tf_buffer.lookup_transform(
                self.map_frame,
                pose_stamped.header.frame_id,
                Time(),
                timeout=rclpy.duration.Duration(seconds=self.tf_timeout_sec),
            )

            return self.manual_transform_pose_stamped(pose_stamped, tf)

        except Exception as exc:
            self.get_logger().warn(
                f'failed TF {pose_stamped.header.frame_id}->{self.map_frame}: {repr(exc)}'
            )
            return None

    def manual_transform_pose_stamped(self, pose_stamped, tf):
        out = PoseStamped()
        out.header.stamp = self.get_clock().now().to_msg()
        out.header.frame_id = tf.header.frame_id

        tq = tf.transform.rotation
        q_tf = (tq.x, tq.y, tq.z, tq.w)

        px = pose_stamped.pose.position.x
        py = pose_stamped.pose.position.y
        pz = pose_stamped.pose.position.z

        rx, ry, rz = self.rotate_vector_by_quat((px, py, pz), q_tf)

        out.pose.position.x = tf.transform.translation.x + rx
        out.pose.position.y = tf.transform.translation.y + ry
        out.pose.position.z = tf.transform.translation.z + rz

        pq = pose_stamped.pose.orientation
        q_pose = (pq.x, pq.y, pq.z, pq.w)
        q_out = self.quat_multiply(q_tf, q_pose)

        out.pose.orientation.x = q_out[0]
        out.pose.orientation.y = q_out[1]
        out.pose.orientation.z = q_out[2]
        out.pose.orientation.w = q_out[3]

        return out

    def lookup_robot_pose(self):
        try:
            tf = self.tf_buffer.lookup_transform(
                self.map_frame,
                self.robot_frame,
                Time(),
                timeout=rclpy.duration.Duration(seconds=0.2),
            )

            q = tf.transform.rotation
            yaw = self.quat_to_yaw(q.x, q.y, q.z, q.w)

            return float(tf.transform.translation.x), float(tf.transform.translation.y), yaw

        except Exception:
            return None

    def ensure_normal_faces_robot(self, x, y, nx, ny):
        robot_pose = self.lookup_robot_pose()
        if robot_pose is None:
            return nx, ny

        rx, ry, _ = robot_pose

        vx = rx - x
        vy = ry - y

        if nx * vx + ny * vy < 0.0:
            nx = -nx
            ny = -ny

        return nx, ny

    # ------------------------------------------------------------------
    # Math helpers
    # ------------------------------------------------------------------

    def quat_to_yaw(self, x, y, z, w):
        siny_cosp = 2.0 * (w * z + x * y)
        cosy_cosp = 1.0 - 2.0 * (y * y + z * z)
        return math.atan2(siny_cosp, cosy_cosp)

    def quat_multiply(self, q1, q2):
        x1, y1, z1, w1 = q1
        x2, y2, z2, w2 = q2

        x = w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2
        y = w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2
        z = w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2
        w = w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2

        return self.normalize_quat((x, y, z, w))

    def normalize_quat(self, q):
        x, y, z, w = q
        n = math.sqrt(x * x + y * y + z * z + w * w)

        if n < 1e-9:
            return 0.0, 0.0, 0.0, 1.0

        return x / n, y / n, z / n, w / n

    def rotate_vector_by_quat(self, v, q):
        x, y, z = v
        qx, qy, qz, qw = self.normalize_quat(q)

        tx = 2.0 * (qy * z - qz * y)
        ty = 2.0 * (qz * x - qx * z)
        tz = 2.0 * (qx * y - qy * x)

        rx = x + qw * tx + (qy * tz - qz * ty)
        ry = y + qw * ty + (qz * tx - qx * tz)
        rz = z + qw * tz + (qx * ty - qy * tx)

        return rx, ry, rz

    def normalize_angle(self, a):
        while a > math.pi:
            a -= 2.0 * math.pi
        while a < -math.pi:
            a += 2.0 * math.pi
        return a

    def yaw_diff_abs(self, a, b):
        return abs(self.normalize_angle(a - b))

    def parse_col_id(self, column_id):
        if not column_id:
            return 0

        try:
            return int(str(column_id).replace('C', '').replace('c', ''))
        except Exception:
            return 0

    def parse_layer_id(self, layer_id):
        if not layer_id:
            return 0

        try:
            return int(str(layer_id).replace('L', '').replace('l', ''))
        except Exception:
            return 0

    def stamp_to_float(self, stamp):
        try:
            return float(stamp.sec) + float(stamp.nanosec) * 1e-9
        except Exception:
            return 0.0


def main():
    rclpy.init()
    node = SemanticRegistrarNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass

    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()