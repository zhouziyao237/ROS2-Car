# robot2 YAML-driven bringup config.
#
# Rules:
# - type: node    => start a single ROS2 node
# - type: include => include another package launch file
# - delay is relative to bringup start time
# - lidar is direct node with respawn, not include launch
# - RealSense and Nav2 are include launch because they are complex standard stacks

modules:
  robot_description:
    type: node
    package: robot_state_publisher
    executable: robot_state_publisher
    name: robot_state_publisher
    output: screen
    delay: 0.0
    parameters:
      - robot_description: "$(cat /host-home/src/Diverse/robot2/urdf/robot2_expanded.urdf)"

  # If robot_state_publisher cannot parse xacro substitution in your environment,
  # replace robot_description module with your old robot_state_publisher launch,
  # or directly use a pre-expanded URDF publisher.

  joint_state_publisher:
    type: node
    package: joint_state_publisher
    executable: joint_state_publisher
    name: joint_state_publisher
    output: screen
    delay: 0.2

  lidar:
    type: node
    package: lslidar_driver
    executable: lslidar_driver_node
    name: lslidar_driver_node
    output: screen
    delay: 1.0
    respawn: true
    respawn_delay: 2.0
    parameters:
      - /host-home/install/lslidar_driver/share/lslidar_driver/params/lidar_uart_ros2/lsm10_p.yaml
      - serial_port: /dev/ttyUSB0
        port: /dev/ttyUSB0
        frame_id: laser

  chassis_serial:
    type: node
    package: rm_serial_driver
    executable: rm_serial_driver_node
    name: rm_serial_driver_node
    output: screen
    delay: 2.0
    parameters:
      - /host-home/install/rm_serial_driver/share/rm_serial_driver/config/serial_driver.yaml
      - serial_port: /dev/ttyACM0
        port: /dev/ttyACM0
        device_name: /dev/ttyACM0
        parity: none
        flow_control: none
        stop_bits: "1"
    remappings:
      - [cmd_vel, /cmd_vel_selected]
      - [/red_standard_robot1/cmd_vel, /cmd_vel_selected]

  front_scan_filter:
    type: node
    package: nav_stack_core_v2
    executable: front_scan_filter
    name: front_scan_filter
    output: screen
    delay: 3.0
    parameters:
      - input_topic: /scan
        output_topic: /scan_front
        mode: block_sector
        filter_mode: block_sector
        block_start_deg: 180.0
        block_end_deg: 280.0
        min_range: 0.18
        max_range: 12.0
        reverse_scan: false
        force_fixed_count: true
        fixed_count: 1324
        output_max_hz: 12.0
        stamp_policy: now
        pub_qos: BEST_EFFORT
        qos_depth: 10

  cmd_vel_mux:
  type: node
  package: nav_stack_core_v2
  executable: cmd_vel_mode_mux
  name: cmd_vel_mode_mux
  output: screen
  delay: 4.0
  parameters:
    - manual_topic: /cmd_vel_manual
      manual_topic_alt: ''
      manual_alt_topic: ''
      auto_topic: /cmd_vel_smoothed
      auto_topic_alt: /cmd_vel
      nav_topic: /cmd_vel
      nav_alt_topic: /cmd_vel_smoothed
      output_topic: /cmd_vel_selected
      mode_topic: /control_mode
      chassis_mode_topic: ''
      publish_rate: 50.0
      cmd_timeout: 0.08
      cmd_timeout_sec: 0.08
      default_mode: auto
      swap_xy: false
      invert_x: false
      invert_y: true
      invert_z: false
      debug_cmd: true
      debug_period: 0.5

  rf2o:
  type: node
  package: rf2o_laser_odometry
  executable: rf2o_laser_odometry_node
  name: rf2o_laser_odometry
  output: screen
  delay: 6.0
  parameters:
    - laser_scan_topic: /scan
      odom_topic: /odom_laser
      publish_tf: false
      base_frame_id: base_link
      odom_frame_id: odom
      init_pose_from_topic: ''
      freq: 12.0

  rf2o_odom_adapter:
  type: node
  package: nav_stack_core_v2
  executable: rf2o_odom_adapter
  name: rf2o_odom_adapter
  output: screen
  delay: 7.0
  parameters:
    - input_odom_topic: /odom_laser
      output_odom_topic: /odom
      odom_frame: odom
      base_frame: base_link
      odom_frame_id: odom
      base_frame_id: base_link
      publish_odom_topic: true
      publish_tf: true
      zero_z: true
      stamp_policy: now

  slam:
    type: node
    package: slam_toolbox
    executable: async_slam_toolbox_node
    name: slam_toolbox
    output: screen
    delay: 12.0
    parameters:
      - /host-home/src/Navigation/nav_stack_core_v2/config/slam_toolbox_online_highres.yaml
      - scan_topic: /scan_front
        base_frame: base_link
        odom_frame: odom
        map_frame: map
        use_sim_time: false

  nav2:
    type: include
    package: nav2_bringup
    launch: navigation_launch.py
    delay: 20.0
    arguments:
      use_sim_time: "false"
      params_file: /host-home/src/Navigation/nav_stack_core_v2/config/nav2_params_min.yaml

  goal_pose_bridge:
    type: node
    package: nav_stack_core_v2
    executable: goal_pose_bridge
    name: goal_pose_bridge
    output: screen
    delay: 22.0
    parameters:
      - goal_pose_topic: /goal_pose
        navigate_action_name: /navigate_to_pose
        marker_topic: /goal_markers
        clear_topic: /clear_goal
        stop_topic: /cmd_vel_selected

  realsense:
    type: include
    package: realsense2_camera
    launch: rs_launch.py
    delay: 8.0
    arguments:
      enable_color: "false"
      enable_depth: "true"
      enable_sync: "false"
      align_depth.enable: "false"
      pointcloud.enable: "false"
      depth_module.depth_profile: "424x240x6"
      rgb_camera.color_profile: "424x240x15"

  d435_depth_to_scan:
    type: node
    package: nav_stack_core_v2
    executable: d435_depth_to_scan
    name: d435_depth_to_scan
    output: screen
    delay: 13.0
    parameters:
      - depth_topic: /camera/camera/depth/image_rect_raw
        scan_topic: /d435_scan
        output_frame: camera_link
        range_min: 0.18
        range_max: 4.0
        scan_height: 12
        output_max_hz: 6.0
        qos_depth: 1
        pub_qos: BEST_EFFORT

  scan_fusion:
    type: node
    package: nav_stack_core_v2
    executable: scan_fusion_node.py
    name: scan_fusion_node
    output: screen
    delay: 16.0
    parameters:
      - lidar_scan_topic: /scan_front
        d435_scan_topic: /d435_scan
        output_scan_topic: /scan_fused
        qos: BEST_EFFORT
        qos_depth: 1
        enable_d435_clearing: false
        depth_timeout_sec: 0.5
        output_max_hz: 12.0

  semantic_registrar:
    type: node
    package: robot_logistics_semantic
    executable: semantic_registrar_node
    name: semantic_registrar_node
    output: screen
    delay: 28.0
    parameters:
      - semantic_map_path: /host-home/semantic_map.yaml
        reset_semantic_map: false
        map_frame: map
        base_frame: base_link

  vision_qr_depth:
    type: node
    package: robot_logistics_semantic
    executable: vision_qr_depth_node
    name: vision_qr_depth_node
    output: screen
    delay: 30.0
    parameters:
      - image_topic: /camera/camera/color/image_raw
        depth_topic: /camera/camera/depth/image_rect_raw
        camera_info_topic: /camera/camera/depth/camera_info
        camera_frame: camera_link
        base_frame: base_link
        map_frame: map

  rviz:
    type: node
    package: rviz2
    executable: rviz2
    name: rviz2
    output: screen
    delay: 35.0
    arguments_list:
      - -d
      - /host-home/src/Navigation/nav_stack_core_v2/rviz/nav_stack.rviz

modes:
  hardware:
    enable:
      - robot_description
      - joint_state_publisher
      - lidar
      - chassis_serial

  mapping:
    enable:
      - robot_description
      - joint_state_publisher
      - lidar
      - front_scan_filter
      - cmd_vel_mux
      - rf2o
      - rf2o_odom_adapter
      - slam

  nav:
    enable:
      - robot_description
      - joint_state_publisher
      - lidar
      - chassis_serial
      - front_scan_filter
      - cmd_vel_mux
      - rf2o
      - rf2o_odom_adapter
      - slam
      - nav2
      - goal_pose_bridge

  nav_d435_light:
    enable:
      - robot_description
      - joint_state_publisher
      - lidar
      - chassis_serial
      - front_scan_filter
      - cmd_vel_mux
      - rf2o
      - rf2o_odom_adapter
      - slam
      - realsense
      - d435_depth_to_scan
      - nav2
      - goal_pose_bridge

  task:
    enable:
      - robot_description
      - joint_state_publisher
      - lidar
      - chassis_serial
      - front_scan_filter
      - cmd_vel_mux
      - rf2o
      - rf2o_odom_adapter
      - slam
      - nav2
      - goal_pose_bridge
      - semantic_registrar

  task_d435:
    enable:
      - robot_description
      - joint_state_publisher
      - lidar
      - chassis_serial
      - front_scan_filter
      - cmd_vel_mux
      - rf2o
      - rf2o_odom_adapter
      - slam
      - realsense
      - d435_depth_to_scan
      - nav2
      - goal_pose_bridge
      - semantic_registrar
      - vision_qr_depth

  debug:
    enable:
      - rviz
