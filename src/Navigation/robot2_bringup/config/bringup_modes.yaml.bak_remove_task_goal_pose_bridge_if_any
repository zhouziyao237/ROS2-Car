modules:
  robot_description:
    type: node
    package: robot_state_publisher
    executable: robot_state_publisher
    name: robot_state_publisher
    output: screen
    delay: 0.0
    parameters:
    - use_sim_time: false
      robot_description: $(file /host-home/src/Diverse/robot2/urdf/robot2.urdf)
  joint_state_publisher:
    type: node
    package: joint_state_publisher
    executable: joint_state_publisher
    name: joint_state_publisher
    output: screen
    delay: 0.2
    parameters:
    - use_sim_time: false
      rate: 30
      robot_description: $(file /host-home/src/Diverse/robot2/urdf/robot2.urdf)
  lidar:
    type: node
    package: lslidar_driver
    executable: lslidar_driver_node
    name: lslidar_driver_node
    output: screen
    delay: 0.5
    respawn: true
    respawn_delay: 2.0
    parameters:
    - /host-home/install/lslidar_driver/share/lslidar_driver/params/lidar_uart_ros2/lsm10_p.yaml
    - serial_port: /dev/ttyUSB0
      port: /dev/ttyUSB0
      frame_id: SCAN-Link
  front_scan_filter:
    type: node
    package: nav_stack_core_v2
    executable: front_scan_filter
    name: front_scan_filter
    output: screen
    delay: 1.5
    parameters:
    - input_topic: /scan
      output_topic: /scan_front
      mode: block_sector
      filter_mode: block_sector
      block_start_deg: 180.0
      block_end_deg: 280.0
      min_range: 0.18
      max_range: 12.0
      reverse_scan: false
      force_fixed_count: true
      fixed_count: 1324
      output_max_hz: 12.0
      stamp_policy: now
      pub_qos: BEST_EFFORT
      qos_depth: 10
    respawn: true
    respawn_delay: 2.0
  rf2o:
    type: node
    package: rf2o_laser_odometry
    executable: rf2o_laser_odometry_node
    name: rf2o_laser_odometry
    output: log
    delay: 2.5
    parameters:
    - laser_scan_topic: /scan
      odom_topic: /odom_laser
      publish_tf: false
      base_frame_id: base_link
      odom_frame_id: odom
      init_pose_from_topic: ''
      freq: 12.0
    arguments_list:
    - --ros-args
    - --log-level
    - warn
    respawn: true
    respawn_delay: 2.0
  rf2o_odom_adapter:
    type: node
    package: nav_stack_core_v2
    executable: rf2o_odom_adapter
    name: rf2o_odom_adapter
    output: screen
    delay: 3.0
    parameters:
    - input_odom_topic: /odom_laser
      output_odom_topic: /odom
      odom_frame: odom
      base_frame: base_link
      odom_frame_id: odom
      base_frame_id: base_link
      publish_odom_topic: true
      publish_tf: true
      zero_z: true
      stamp_policy: now
      qos_depth: 1
    respawn: true
    respawn_delay: 2.0
  cmd_vel_mux:
    type: node
    package: nav_stack_core_v2
    executable: cmd_vel_mode_mux
    name: cmd_vel_mode_mux
    output: screen
    delay: 3.0
    parameters:
    - manual_topic: /cmd_vel_manual
      manual_topic_alt: ''
      manual_alt_topic: ''
      auto_topic: /cmd_vel_smoothed
      auto_topic_alt: /cmd_vel
      nav_topic: /cmd_vel
      nav_alt_topic: /cmd_vel_smoothed
      output_topic: /cmd_vel_selected
      mode_topic: /control_mode
      chassis_mode_topic: ''
      publish_rate: 50.0
      cmd_timeout: 0.08
      cmd_timeout_sec: 0.08
      default_mode: auto
      swap_xy: true
      invert_x: true
      invert_y: false
      invert_z: false
      debug_cmd: true
      debug_period: 0.5
  slam:
    type: node
    package: slam_toolbox
    executable: async_slam_toolbox_node
    name: slam_toolbox
    output: screen
    delay: 5.0
    parameters:
    - /host-home/src/Navigation/nav_stack_core_v2/config/slam_toolbox_online_highres.yaml
    - use_sim_time: false
      odom_frame: odom
      map_frame: map
      base_frame: base_link
      scan_topic: /scan_front
    respawn: true
    respawn_delay: 2.0
  nav2:
    type: include
    package: nav2_bringup
    launch: navigation_launch.py
    delay: 8.0
    arguments:
      use_sim_time: 'false'
      params_file: /host-home/src/Navigation/nav_stack_core_v2/config/nav2_params_min.yaml
      autostart: 'true'
    respawn: true
    respawn_delay: 2.0
  goal_pose_bridge:
    type: node
    package: nav_stack_core_v2
    executable: goal_pose_bridge
    name: goal_pose_bridge
    output: screen
    delay: 9.0
    parameters:
    - goal_pose_topic: /goal_pose
      navigate_action_name: /navigate_to_pose
      marker_topic: /goal_markers
      clear_topic: /clear_goal
      stop_topic: /cmd_vel_selected
    respawn: true
    respawn_delay: 2.0
  chassis_serial:
    type: node
    package: rm_serial_driver
    executable: rm_serial_driver_node
    name: rm_serial_driver_node
    output: screen
    delay: 9.5
    parameters:
    - /host-home/install/rm_serial_driver/share/rm_serial_driver/config/serial_driver.yaml
    - serial_port: /dev/ttyACM0
      port: /dev/ttyACM0
      device_name: /dev/ttyACM0
      parity: none
      flow_control: none
      stop_bits: '1'
      nav_cmd_timeout: 0.1
      nav_cmd_send_rate: 50.0
    remappings:
    - - cmd_vel
      - /cmd_vel_selected
    - - /red_standard_robot1/cmd_vel
      - /cmd_vel_selected
  realsense:
    type: node
    package: realsense2_camera
    executable: realsense2_camera_node
    name: camera
    namespace: camera
    output: screen
    delay: 4.0
    parameters:
    - use_sim_time: false
      camera_name: camera
      camera_namespace: camera
      enable_color: true
      enable_depth: true
      enable_infra: false
      enable_infra1: false
      enable_infra2: false
      pointcloud.enable: false
      align_depth.enable: true
      enable_sync: true
      rgb_camera.color_profile: 424x240x15
      depth_module.depth_profile: 424x240x15
      publish_tf: true
      tf_publish_rate: 10.0
      initial_reset: false
      reconnect_timeout: 6.0
    respawn: true
    respawn_delay: 2.0
  d435_depth_to_scan:
    type: node
    package: nav_stack_core_v2
    executable: d435_depth_to_scan
    name: d435_depth_to_scan_node
    output: screen
    delay: 6.0
    parameters:
    - depth_image_topic: /camera/camera/aligned_depth_to_color/image_raw
      camera_info_topic: /camera/camera/color/camera_info
      output_scan_topic: /d435_scan
      output_frame: base_link
      scan_height_pixels: 16
      range_min: 0.25
      range_max: 3.0
      angle_min_deg: -35.0
      angle_max_deg: 35.0
    respawn: true
    respawn_delay: 2.0
  scan_fusion:
    type: node
    package: nav_stack_core_v2
    executable: scan_fusion_node
    name: scan_fusion_node
    output: screen
    delay: 7.0
    parameters:
    - lidar_scan_topic: /scan_front
      depth_scan_topic: /d435_scan
      d435_scan_topic: /d435_scan
      output_scan_topic: /scan_fused
      enable_d435_clearing: false
      range_min: 0.18
      range_max: 12.0
      depth_timeout_sec: 0.5
    respawn: true
    respawn_delay: 2.0
  semantic_registrar:
    type: include
    package: robot_logistics_semantic
    launch: real_semantic_only.launch.py
    delay: 10.5
    arguments:
      semantic_map_path: /host-home/maps/semantic_library.json
      reset_semantic_map: 'false'
      max_yaw_jump_deg: '180.0'
      yaw_smooth_alpha: '1.0'
      use_single_qr_normal_yaw: 'false'
      camera_mount_yaw_deg: '0.0'
      camera_mount_pitch_down_deg: '20.0'
      camera_mount_roll_deg: '180.0'
      qr_pose_normal_axis: x
      normal_points_to_camera: 'true'
      front_qr_yaw_offset_deg: '0.0'
      right_side_qr_yaw_offset_deg: '90.0'
      left_side_qr_yaw_offset_deg: '-90.0'
      moving_shelf_realign_mode: 'true'
      prefer_latest_front_qr: 'true'
      max_front_side_pair_age_sec: '1.0'
      enable_front_side_intersection: 'false'
      front_qr_back_offset_m: '0.0'
      front_qr_lateral_offset_m: '0.0'
      input_topic: /vision/semantic_observation
      observation_topic: /vision/semantic_observation
      allow_side_qr_create_candidate_pose: 'false'
      front_qr_lateral_axis_sign: '1.0'
    parameters:
    - max_yaw_jump_deg: 180.0
      yaw_smooth_alpha: 1.0
      use_single_qr_normal_yaw: false
      camera_mount_yaw_deg: 0.0
      camera_mount_pitch_down_deg: 20.0
      camera_mount_roll_deg: 180.0
      qr_pose_normal_axis: x
      normal_points_to_camera: true
      front_qr_yaw_offset_deg: 0.0
      right_side_qr_yaw_offset_deg: 90.0
      left_side_qr_yaw_offset_deg: -90.0
      moving_shelf_realign_mode: true
      prefer_latest_front_qr: true
      max_front_side_pair_age_sec: 1.0
      enable_front_side_intersection: false
      front_qr_back_offset_m: 0.0
      front_qr_lateral_offset_m: 0.0
      input_topic: /vision/semantic_observation
      observation_topic: /vision/semantic_observation
      allow_side_qr_create_candidate_pose: false
      front_qr_lateral_axis_sign: 1.0
    respawn: true
    respawn_delay: 2.0
  rviz:
    type: node
    package: rviz2
    executable: rviz2
    name: rviz2
    output: screen
    delay: 12.0
    arguments_list:
    - -d
    - /host-home/src/Navigation/nav_stack_core_v2/rviz/nav_stack.rviz
  mission_bt:
    type: node
    package: robot_logistics_task
    executable: mission_btcpp_node
    name: mission_btcpp_node
    output: screen
    delay: 11.0
    parameters:
    - bt_xml: /host-home/src/Navigation/robot_logistics_task/behavior_tree/pickup_task_full_groot1.xml
      semantic_map_path: /host-home/maps/semantic_library.json
      semantic_session_path: /host-home/maps/semantic_session_pose.json
      map_session_id: current_slam_session
      shelf_goal_topic: /task/shelf_goal
      cancel_topic: /task/cancel
      task_status_topic: /task/status
      current_state_topic: /task/current_state
      current_goal_topic: /task/current_goal
      bt_trace_topic: /task/bt_trace
      bt_xml_topic: /task/bt_tree_xml
      goal_pose_topic: /goal_pose
      platform_target_topic: /platform/target
      platform_status_topic: /platform/status
      explore_cmd_topic: /task/explore_cmd
      control_mode_topic: /control_mode
      anchor_detection_topic: /semantic/anchor_detection
      current_shelf_topic: /semantic/current_shelf
      map_frame: map
      base_frame: base_link
      session_pose_max_age_sec: 600.0
      min_session_confidence: 0.5
      allow_demo_anchor_if_missing: false
      enable_groot_monitoring: true
      groot_publisher_port: 1666
      groot_server_port: 1667
      groot_max_msg_per_second: 25
    respawn: true
    respawn_delay: 2.0
    arguments:
      allow_demo_anchor_if_missing: 'false'
      semantic_map_path: /host-home/maps/semantic_library.json
      semantic_session_path: /host-home/maps/semantic_session_pose.json
  bt_osd_overlay:
    type: node
    package: robot_logistics_task
    executable: bt_osd_overlay.py
    name: bt_osd_overlay
    output: screen
    delay: 12.0
    parameters:
    - input_image_topic: /camera/camera/color/image_raw
      output_image_topic: /task/bt_osd/image_raw
      current_state_topic: /task/current_state
      status_topic: /task/status
      current_goal_topic: /task/current_goal
      trace_topic: /task/bt_trace
      draw_goal: true
      draw_trace: true
      draw_status: true
      font_scale: 0.55
      thickness: 1
    respawn: true
    respawn_delay: 2.0
  front_qr_semantic_writer:
    type: node
    package: robot_logistics_semantic
    executable: front_qr_semantic_writer_node
    name: front_qr_semantic_writer_node
    output: screen
    delay: 13.5
    respawn: true
    respawn_delay: 2.0
    parameters:
    - input_topic: /vision/semantic_observation
      semantic_map_path: /host-home/maps/semantic_library.json
      target_frame: map
      front_qr_yaw_offset_deg: -5.0
      front_qr_back_offset_m: 0.0
      front_qr_lateral_offset_m: 0.0
      shelf_width_m: 1.2
      shelf_depth_m: 0.35
      approach_distance_m: 1.1
      front_qr_lateral_axis_sign: 1.0
      use_base_yaw_delta_mode: true
      base_frame: base_link
      front_qr_yaw_delta_sign: -1.0
    arguments:
      front_qr_back_offset_m: '0.0'
      front_qr_lateral_offset_m: '0.0'
      front_qr_lateral_axis_sign: '1.0'
      front_qr_yaw_offset_deg: '0.0'
modes:
  hardware:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - chassis_serial
  mapping:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - slam
  nav:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - slam
    - nav2
    - goal_pose_bridge
    - chassis_serial
  task:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - realsense
    - d435_depth_to_scan
    - scan_fusion
    - slam
    - nav2
    - goal_pose_bridge
    - chassis_serial
    - semantic_registrar
    - front_qr_semantic_writer
    - mission_bt
    - bt_osd_overlay
  nav_d435:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - realsense
    - d435_depth_to_scan
    - slam
    - nav2
    - goal_pose_bridge
    - chassis_serial
  debug:
    enable:
    - rviz
