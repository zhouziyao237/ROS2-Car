  hardware:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - chassis_serial
  mapping:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - slam
  nav:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - slam
    - nav2
    - goal_pose_bridge
    - chassis_serial
  task:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - chassis_serial
    - realsense
    - d435_depth_to_scan
    - scan_fusion
    - slam
    - nav2
    - goal_pose_bridge
    - apriltag_shelf_bridge
    - semantic_registrar
    - home_anchor_validator
    - semantic_marker_publisher
    - mission_bt
    - task_cancel_guard
    - bt_osd_overlay
    - oak_vision_driver
    - oak_parcel_pose
    - oak_package_search
  nav_d435:
    enable:
    - robot_description
    - joint_state_publisher
    - lidar
    - front_scan_filter
    - rf2o
    - rf2o_odom_adapter
    - cmd_vel_mux
    - realsense
    - d435_depth_to_scan
    - slam
    - nav2
    - goal_pose_bridge
    - chassis_serial
  debug:
    enable:
    - rviz
