#!/usr/bin/env python3
# -*- coding: utf-8 -*-
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument('bt_xml', default_value='/host-home/src/Navigation/robot_logistics_task/behavior_tree/pickup_task_three_node_main.xml'),
        DeclareLaunchArgument('semantic_map_path', default_value='/host-home/maps/semantic_library.json'),
        DeclareLaunchArgument('semantic_session_path', default_value='/host-home/maps/semantic_session_pose.json'),
        DeclareLaunchArgument('enable_groot_monitoring', default_value='true'),
        DeclareLaunchArgument('groot_publisher_port', default_value='1666'),
        DeclareLaunchArgument('groot_server_port', default_value='1667'),
        Node(
            package='robot_logistics_task',
            executable='mission_btcpp_node',
            name='mission_btcpp_node',
            output='screen',
            parameters=[{
                'bt_xml': LaunchConfiguration('bt_xml'),
                'semantic_map_path': LaunchConfiguration('semantic_map_path'),
                'semantic_session_path': LaunchConfiguration('semantic_session_path'),
                'enable_groot_monitoring': LaunchConfiguration('enable_groot_monitoring'),
                'groot_publisher_port': LaunchConfiguration('groot_publisher_port'),
                'groot_server_port': LaunchConfiguration('groot_server_port'),
                'groot_max_msg_per_second': 25,
                'shelf_goal_topic': '/task/shelf_goal',
                'cancel_topic': '/task/cancel',
                'task_status_topic': '/task/status',
                'current_state_topic': '/task/current_state',
                'current_goal_topic': '/task/current_goal',
                'bt_trace_topic': '/task/bt_trace',
                'bt_xml_topic': '/task/bt_tree_xml',
                'goal_pose_topic': '/goal_pose',
                'platform_target_topic': '/platform/target',
                'platform_status_topic': '/platform/status',
                'explore_cmd_topic': '/task/explore_cmd',
                'control_mode_topic': '/control_mode',
                'anchor_detection_topic': '/semantic/anchor_detection',
                'current_shelf_topic': '/semantic/current_shelf',
                'package_search_request_topic': '/target_detection/package_search/request',
                'package_search_status_topic': '/target_detection/package_search/status',
                'package_search_timeout_sec': 20.0,
                'map_frame': 'map',
                'base_frame': 'base_link',
            }],
        ),
    ])
