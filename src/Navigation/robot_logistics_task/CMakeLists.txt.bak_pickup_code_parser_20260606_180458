cmake_minimum_required(VERSION 3.8)
project(robot_logistics_task)

if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  add_compile_options(-Wall -Wextra -Wpedantic -flarge-source-files)
endif()

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(ament_cmake REQUIRED)
find_package(rclcpp REQUIRED)
find_package(std_msgs REQUIRED)
find_package(geometry_msgs REQUIRED)
find_package(tf2 REQUIRED)
find_package(tf2_ros REQUIRED)
find_package(behaviortree_cpp_v3 REQUIRED)

add_executable(mission_btcpp_node
  src/mission_btcpp_node.cpp
)

ament_target_dependencies(mission_btcpp_node
  rclcpp
  std_msgs
  geometry_msgs
  tf2
  tf2_ros
  behaviortree_cpp_v3
)

install(TARGETS
  mission_btcpp_node
  DESTINATION lib/${PROJECT_NAME}
)

install(PROGRAMS
  scripts/send_shelf_goal.py
  scripts/bt_status_tui.py
  scripts/bt_osd_overlay.py
  scripts/patch_bringup_use_groot1_semantic_bt.py
  DESTINATION lib/${PROJECT_NAME}
)

install(DIRECTORY
  launch
  config
  behavior_tree
  docs
  DESTINATION share/${PROJECT_NAME}
)

install(PROGRAMS
  scripts/bt_osd_overlay.py
  DESTINATION lib/${PROJECT_NAME}
)

ament_package()
