<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!-- ========================================================= -->
  <!-- MainTree                                                  -->
  <!-- 当前阶段主行为树只保留三个高层块：                         -->
  <!-- 1. ReceivePickupTask                                      -->
  <!-- 2. RunSemanticShelfNavigation                             -->
  <!-- 3. FinishCurrentMission                                   -->
  <!-- ========================================================= -->
  <BehaviorTree ID="MainTree">
    <Sequence name="MainTree">

      <!-- 1. 开始：接收取件任务 -->
      <Sequence name="ReceivePickupTaskBlock">
        <ReceivePickupTask/>
      </Sequence>


      <!-- 2. 语义货架 + 自动探索 + 导航 + 到达后验证 -->
      <Sequence name="RunSemanticShelfNavigation">

        <!-- A. 查询目标货架位姿；没有则自动探索并更新语义 session -->
        <Fallback name="ResolveTargetShelfPoseOrExplore">

          <QueryTargetShelfPose/>

          <Sequence name="ExploreAndRegisterTargetShelf">
            <EnterShelfExplorationMode/>
            <SearchShelfReference/>
            <DetectShelfAnchor/>
            <EstimateShelfPoseFromShelfAnchor/>
            <UpdateSemanticShelfPose/>
            <QueryTargetShelfPose/>
          </Sequence>

        </Fallback>


        <!-- B. 导航到目标货架 approach pose -->
        <Sequence name="NavigateToTargetShelfBlock">
          <NavigateToTargetShelf/>
          <WaitShelfNavigationArrive/>
        </Sequence>


        <!-- C. 到达后验证当前货架身份；失败则重新搜索并更新语义位姿 -->
        <Fallback name="VerifyTargetShelfOrRelocalize">

          <VerifyTargetShelfIdentity/>

          <Sequence name="SearchAndVerifyTargetShelf">
            <SearchTargetShelfIdentity/>
            <DetectShelfAnchor/>
            <EstimateShelfPoseFromShelfAnchor/>
            <UpdateSemanticShelfPose/>
            <VerifyTargetShelfIdentity/>
          </Sequence>

        </Fallback>

      </Sequence>


      <!-- 3. 当前阶段临时结束：先不进入找包 / 取件 -->
      <FinishCurrentMission/>

    </Sequence>
  </BehaviorTree>

</root>
