<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PickupTaskFull">
      <ReceiveShelfGoal/>

      <Fallback name="ResolveShelfPoseOrExplore">
        <QueryShelfPose/>

        <Sequence name="ExploreAndRelocalizeShelf">
          <EnterExploreMode/>
          <SearchShelfReference/>
          <DetectShelfAnchor/>
          <EstimateShelfPoseFromAnchor/>
          <UpdateSemanticSessionPose/>
          <QueryShelfPose/>
        </Sequence>
      </Fallback>

      <NavigateToShelf/>
      <WaitNavArrive/>
      <WaitNavSettle/>

      <Fallback name="VerifyShelfOrSearchQR">
        <VerifyShelfQR/>
        <Sequence name="SearchAndVerifyQR">
          <SearchShelfQR/>
          <DetectShelfAnchor/>
          <EstimateShelfPoseFromAnchor/>
          <UpdateSemanticSessionPose/>
          <VerifyShelfQR/>
        </Sequence>
      </Fallback>
      <!-- 使用已经调通的 oak_package_search_node 做 OAK 自动对正；不再使用旧的 oak_camera_link TF 对正节点。 -->
      <RequestOakPackageSearchAlign/>
      <!-- OAK 对正完成后稍等，再进入后续扫描/平台动作 -->
      <WaitAfterOakAlign/>
      <ScanTargetPackageOnShelf/><SendPlatformTarget/>
      <WaitPickupDone/>
      <PublishTaskDone/>
    </Sequence>
  </BehaviorTree>
</root>
