            ss<<",\"shelf_id\":\""<<ctx->task.shelf_id<<"\"";
            ss<<",\"layer_id\":\"";
            if(ctx->task.row>0) ss<<"L"<<ctx->task.row;
            ss<<"\"";
            ss<<",\"package_code\":\""<<ctx->task.col<<"\"";
            ss<<",\"x\":"<<ctx->resolved_pose.x;
            ss<<",\"y\":"<<ctx->resolved_pose.y;
            ss<<",\"yaw\":"<<ctx->resolved_pose.yaw;
