static double norm_angle(double a){return std::atan2(std::sin(a),std::cos(a));}
static tf2::Vector3 axis_vec(const std::string& axis){
    if(axis=="x"||axis=="+x")return tf2::Vector3(1,0,0);
    if(axis=="-x")return tf2::Vector3(-1,0,0);
    if(axis=="y"||axis=="+y")return tf2::Vector3(0,1,0);
    if(axis=="-y")return tf2::Vector3(0,-1,0);
    if(axis=="z"||axis=="+z")return tf2::Vector3(0,0,1);
    if(axis=="-z")return tf2::Vector3(0,0,-1);
    return tf2::Vector3(0,0,1);
}
static double frame_axis_yaw_map(std::shared_ptr<SharedContext> ctx,const std::string& frame,const std::string& axis){
    if(!ctx->tf_buffer)throw std::runtime_error("tf_buffer not initialized");
    auto tf=ctx->tf_buffer->lookupTransform(ctx->map_frame,frame,tf2::TimePointZero,tf2::durationFromSec(0.20));
    tf2::Quaternion q(tf.transform.rotation.x,tf.transform.rotation.y,tf.transform.rotation.z,tf.transform.rotation.w);
    tf2::Matrix3x3 R(q);
    tf2::Vector3 d=R*axis_vec(axis);
    if(std::hypot(d.x(),d.y())<1e-6)throw std::runtime_error("axis projection too small for frame "+frame+" axis "+axis);
    return std::atan2(d.y(),d.x());
}
