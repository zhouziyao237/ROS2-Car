        t.cell_id = parsed.pickup_full;
        t.shelf_id = parsed.shelf_id;
        t.layer_id = parsed.layer_id;
        t.package_code = parsed.package_code;

        // Compatibility with old row/col fields:
        // row = layer index, col = 4-char package code.
        t.row = parsed.layer_index;
        t.col = parsed.package_code;
    }else{
        // Backward-compatible fallback for old task format.
        t.shelf_id = !json_shelf_id.empty() ? json_shelf_id : json_target_shelf_id;
        t.cell_id = !json_cell_id.empty() ? json_cell_id : json_target_cell_id;
        t.pickup_code = json_pickup_code;
        if(t.pickup_code.empty()) t.pickup_code=t.cell_id;
        if(t.cell_id.empty() && !t.pickup_code.empty()) t.cell_id=t.pickup_code;
        t.col = json_col;
        t.layer_id = json_layer_id;
        t.package_code = json_package_code;

        if(t.shelf_id.empty() && !t.pickup_code.empty()){
            auto d=t.pickup_code.find("-");
            t.shelf_id=d==std::string::npos?t.pickup_code:t.pickup_code.substr(0,d);
        }
        if(t.shelf_id.empty()){
            auto d=m->data.find("-");
            t.shelf_id=d==std::string::npos?m->data:m->data.substr(0,d);
        }
    }

    double row=0.0;
    if(!parsed.valid && get_number_json(m->data,"row",row)){
        t.row=(int)row;
    }

    // Optional direct pose command for debug:
    // {"shelf_id":"S03","x":0.1,"y":0.2,"yaw":0.0}
    double x=0.0,y=0.0,yaw=0.0;
    if(get_number_json(m->data,"x",x)&&get_number_json(m->data,"y",y)){
        t.command_has_pose=true;
        t.target_pose.valid=true;
        t.target_pose.x=x;
        t.target_pose.y=y;
        if(get_number_json(m->data,"yaw",yaw)){
            t.target_pose.yaw=yaw;
        }
        t.target_pose.confidence=1.0;
        t.target_pose.stamp=wall_seconds(*this);
        t.target_pose.source="command_direct_pose";
    }

    {
        std::lock_guard<std::mutex> l(ctx_->mutex);

        ctx_->task=t;

        // Critical reset for repeated task.
        ctx_->resolved_pose=Pose2D();
        ctx_->latest_anchor=AnchorData();

        ctx_->set_state("TASK_ACCEPTED");
    }

    ctx_->status("ACCEPTED","task accepted");
    RCLCPP_INFO(get_logger(),"Task received: raw=%s | parsed pickup_code=%s shelf_id=%s layer_id=%s package_code=%s",m->data.c_str(),t.pickup_code.c_str(),t.shelf_id.c_str(),t.layer_id.c_str(),t.package_code.c_str());
}void on_anchor(const std_msgs::msg::String::SharedPtr m){AnchorData a;a.raw=m->data;a.stamp=wall_seconds(*this);get_string_json(m->data,"shelf_id",a.shelf_id);get_string_json(m->data,"anchor_type",a.anchor_type);get_number_json(m->data,"x",a.x);get_number_json(m->data,"y",a.y);get_number_json(m->data,"yaw",a.yaw);get_number_json(m->data,"confidence",a.confidence);if(!a.shelf_id.empty()){a.valid=true;std::lock_guard<std::mutex>l(ctx_->mutex);ctx_->latest_anchor=a;}}void tick(){bool has=false;{std::lock_guard<std::mutex>l(ctx_->mutex);has=ctx_->task.active;}if(!has){ctx_->set_state("IDLE");return;}auto st=tree_->tickRoot();if(st==BT::NodeStatus::SUCCESS){tree_->haltTree();}else if(st==BT::NodeStatus::FAILURE){
        publish_clear_goal(ctx_);
        std_msgs::msg::String mode;
        mode.data = "stop";
        ctx_->control_mode_pub->publish(mode);
        publish_stop(ctx_);

        ctx_->status("FAILED","behavior tree returned FAILURE; cancel Nav2 goal and stop");
        {std::lock_guard<std::mutex>l(ctx_->mutex);ctx_->task=TaskData();ctx_->resolved_pose=Pose2D();}
        tree_->haltTree();
    }}};
int main(int argc,char**argv){rclcpp::init(argc,argv);auto n=std::make_shared<MissionNode>();n->init();rclcpp::spin(n);rclcpp::shutdown();return 0;}
