<?xml version="1.0"?>
<package format="3">
  <name>target_pickup_bringup</name>
  <version>0.0.4</version>
  <description>Bringup package for OAK YOLO, OCR, target matcher, target pose bridge, and auto decision with dynamic target switching.</description>
  <maintainer email="zzy@example.com">zzy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>yolo_msg</exec_depend>
  <exec_depend>oak_vision_driver</exec_depend>
  <exec_depend>ocr_node</exec_depend>
  <exec_depend>target_matcher</exec_depend>
  <exec_depend>target_pose_bridge</exec_depend>
  <exec_depend>target_auto_decision</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
