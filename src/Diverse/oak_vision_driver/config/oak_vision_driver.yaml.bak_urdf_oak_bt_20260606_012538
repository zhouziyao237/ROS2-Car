oak_vision_driver_node:
  ros__parameters:
    # =========================
    # Runtime switches
    # =========================
    enable_rgb: true
    enable_depth: false
    enable_yolo: false
    enable_stereo_fusion: false

    publish_left_image: true
    publish_right_image: true
    publish_stereo_fused_image: true
    publish_stereo_concat_image: false

    draw_oak_detections_on_rgb: true
    publish_annotated_image: true
    publish_debug_text: true
    publish_yolo_table: true

    # =========================
    # Adjustable camera resolution
    # =========================
    sensor_resolution: 1080p
    mono_resolution: 400p

    # preview = 640x640 or customized preview output
    # video   = high-resolution RGB output
    rgb_output: video

    color_order: BGR
    keep_aspect_ratio: false

    preview_width: 640
    preview_height: 640

    video_width: 1920
    video_height: 1080

    input_width: 640
    input_height: 640

    fps: 10.0
    queue_size: 1
    timer_period: 0.01

    force_usb2: false
    stop_on_xlink_error: true
    ros_image_encoding: bgr8

    # =========================
    # Stereo fusion
    # =========================
    # blend / anaglyph / max / left / right
    stereo_fusion_method: blend
    stereo_fusion_alpha: 0.5

    # =========================
    # Topics
    # =========================
    rgb_topic: /oak/rgb/image_raw
    depth_topic: /oak/depth/image_raw
    camera_info_topic: /oak/rgb/camera_info

    left_topic: /oak/left/image_raw
    right_topic: /oak/right/image_raw
    stereo_fused_topic: /oak/stereo_fused/image_raw
    stereo_concat_topic: /oak/stereo_concat/image_raw

    detections_topic: /yolov5/detections
    yolo_debug_topic: /oak/yolo_debug_text
    annotated_image_topic: /oak/yolo_annotated_image
    yolo_table_topic: /oak/yolo_table

    frame_id: oak_camera_link
    left_frame_id: oak_left_camera_optical_frame
    right_frame_id: oak_right_camera_optical_frame
    stereo_frame_id: oak_stereo_fused_frame

    # =========================
    # YOLO / NN
    # =========================
    blob_path: /host-home/src/target_detection/oak_vision_driver/weights/best_fp16_new.blob
    network_type: yolov5
    parser: NeuralNetwork

    num_classes: 1
    class_names:
      - target

    conf: 0.25
    iou: 0.45

    decoder_debug: false
    debug_scores: false
    score_log_interval: 60

    coordinate_size: 4
    score_mode: obj_cls
    output_value_mode: auto

    anchors:
      - 10.0
      - 13.0
      - 16.0
      - 30.0
      - 33.0
      - 23.0
      - 30.0
      - 61.0
      - 62.0
      - 45.0
      - 59.0
      - 119.0
      - 116.0
      - 90.0
      - 156.0
      - 198.0
      - 373.0
      - 326.0

    anchor_masks:
      side80: [0, 1, 2]
      side40: [3, 4, 5]
      side20: [6, 7, 8]
