            f"enable_yolo={self.enable_yolo}, enable_stereo_fusion={self.enable_stereo_fusion}"
        )
        self.get_logger().info(
            f"sensor_resolution={self.sensor_resolution}, mono_resolution={self.mono_resolution}, "
            f"rgb_output={self.rgb_output}, color_order={self.color_order}"
        )
        self.get_logger().info(
            f"preview={self.preview_width}x{self.preview_height}, "
            f"video={self.video_width}x{self.video_height}, "
