    def make_detection_msg(self, det: Dict, stamp, index: int = 0):
        dmsg = YoloDetection()

        if hasattr(dmsg, "header"):
            dmsg.header.stamp = stamp
            dmsg.header.frame_id = self.frame_id

        class_id = int(det.get("class_id", 0))
        class_name = str(det.get("class_name", "target"))
        confidence = float(det.get("confidence", 0.0))

        x1 = int(det.get("xmin", 0))
        y1 = int(det.get("ymin", 0))
        x2 = int(det.get("xmax", 0))
        y2 = int(det.get("ymax", 0))

        width = max(0, x2 - x1)
        height = max(0, y2 - y1)
        center_u = int((x1 + x2) / 2)
        center_v = int((y1 + y2) / 2)

        self.set_if_exists(dmsg, "target_id", f"oak_det_{index}")
        self.set_if_exists(dmsg, "class_name", class_name)
        self.set_if_exists(dmsg, "class_id", class_id)
        self.set_if_exists(dmsg, "confidence", confidence)
        self.set_if_exists(dmsg, "need_ocr", True)

        if hasattr(dmsg, "box") and Box2D is not None:
            box = Box2D()
            self.set_if_exists(box, "x1", x1)
            self.set_if_exists(box, "y1", y1)
            self.set_if_exists(box, "x2", x2)
            self.set_if_exists(box, "y2", y2)
            self.set_if_exists(box, "xmin", x1)
            self.set_if_exists(box, "ymin", y1)
            self.set_if_exists(box, "xmax", x2)
            self.set_if_exists(box, "ymax", y2)
            self.set_if_exists(box, "center_u", center_u)
            self.set_if_exists(box, "center_v", center_v)
            self.set_if_exists(box, "center_x", center_u)
            self.set_if_exists(box, "center_y", center_v)
            self.set_if_exists(box, "width", width)
            self.set_if_exists(box, "height", height)
            dmsg.box = box

        return dmsg

    def publish_detections_msg(self, stamp):
        if not HAS_YOLO_MSG or self.detections_pub is None:
            return

        arr = YoloDetectionArray()

        if hasattr(arr, "header"):
            arr.header.stamp = stamp
            arr.header.frame_id = self.frame_id

        detections_list = []
        for i, det in enumerate(self.latest_frame_detections):
            detections_list.append(self.make_detection_msg(det, stamp, i))

        if hasattr(arr, "detections"):
            arr.detections = detections_list
        elif hasattr(arr, "results"):
            arr.results = detections_list
        elif hasattr(arr, "objects"):
            arr.objects = detections_list
        elif hasattr(arr, "yolo_detections"):
            arr.yolo_detections = detections_list

        self.detections_pub.publish(arr)

    def draw_detections(self, frame, detections):
        out = frame.copy()

        for det in detections:
            x1 = int(det["xmin"])
            y1 = int(det["ymin"])
            x2 = int(det["xmax"])
            y2 = int(det["ymax"])

            confidence = float(det.get("confidence", 0.0))
            class_name = str(det.get("class_name", det.get("class_id", "target")))

            cv2.rectangle(out, (x1, y1), (x2, y2), (0, 0, 255), 2)
            text = f"{class_name} {confidence:.2f}"
            text_y = max(20, y1 - 6)

            cv2.putText(
                out,
                text,
                (x1, text_y),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 0, 255),
                2,
                cv2.LINE_AA,
            )

        return out

    def publish_mono8_image(self, publisher, frame, stamp, frame_id):
        if publisher is None or frame is None:
            return

        if len(frame.shape) == 3:
            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        msg = self.bridge.cv2_to_imgmsg(frame, encoding="mono8")
        msg.header.stamp = stamp
        msg.header.frame_id = frame_id
        publisher.publish(msg)

    def publish_bgr8_image(self, publisher, frame, stamp, frame_id):
        if publisher is None or frame is None:
            return

        if len(frame.shape) == 2:
            frame = cv2.cvtColor(frame, cv2.COLOR_GRAY2BGR)

        msg = self.bridge.cv2_to_imgmsg(frame, encoding="bgr8")
        msg.header.stamp = stamp
        msg.header.frame_id = frame_id
        publisher.publish(msg)

    def resize_same_size(self, left, right):
        if left is None or right is None:
            return left, right

        h1, w1 = left.shape[:2]
        h2, w2 = right.shape[:2]

        target_w = min(w1, w2)
        target_h = min(h1, h2)

        if w1 != target_w or h1 != target_h:
            left = cv2.resize(left, (target_w, target_h), interpolation=cv2.INTER_AREA)

        if w2 != target_w or h2 != target_h:
            right = cv2.resize(right, (target_w, target_h), interpolation=cv2.INTER_AREA)

        return left, right

    def make_stereo_fused_frame(self, left, right):
        if left is None or right is None:
            return None

        left, right = self.resize_same_size(left, right)

        if len(left.shape) == 3:
            left_gray = cv2.cvtColor(left, cv2.COLOR_BGR2GRAY)
        else:
            left_gray = left

        if len(right.shape) == 3:
            right_gray = cv2.cvtColor(right, cv2.COLOR_BGR2GRAY)
        else:
            right_gray = right

        method = self.stereo_fusion_method

        if method == "left":
            return cv2.cvtColor(left_gray, cv2.COLOR_GRAY2BGR)

        if method == "right":
            return cv2.cvtColor(right_gray, cv2.COLOR_GRAY2BGR)

        if method == "max":
            fused_gray = np.maximum(left_gray, right_gray)
            return cv2.cvtColor(fused_gray, cv2.COLOR_GRAY2BGR)

        if method == "anaglyph":
            fused = np.zeros((left_gray.shape[0], left_gray.shape[1], 3), dtype=np.uint8)
            fused[:, :, 2] = left_gray
            fused[:, :, 1] = right_gray
            fused[:, :, 0] = right_gray
            return fused

        alpha = float(np.clip(self.stereo_fusion_alpha, 0.0, 1.0))
        fused_gray = cv2.addWeighted(left_gray, alpha, right_gray, 1.0 - alpha, 0.0)
        return cv2.cvtColor(fused_gray, cv2.COLOR_GRAY2BGR)

    def make_stereo_concat_frame(self, left, right):
        if left is None or right is None:
            return None

        left, right = self.resize_same_size(left, right)

        if len(left.shape) == 2:
            left_bgr = cv2.cvtColor(left, cv2.COLOR_GRAY2BGR)
        else:
            left_bgr = left

        if len(right.shape) == 2:
            right_bgr = cv2.cvtColor(right, cv2.COLOR_GRAY2BGR)
        else:
            right_bgr = right

        concat = np.hstack([left_bgr, right_bgr])

        cv2.putText(concat, "LEFT", (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0, 255, 0), 2)
        cv2.putText(
            concat,
            "RIGHT",
            (left_bgr.shape[1] + 20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.0,
            (0, 255, 0),
            2,
        )

        return concat

    # =========================
    # Main loop
    # =========================
    def timer_callback(self):
        if not self.oak_alive:
            return

        stamp = self.make_stamp()

        try:
            rgb_frame = None

            if self.rgb_queue is not None:
                rgb_packet = self.rgb_queue.tryGet()
                if rgb_packet is not None:
                    rgb_frame = rgb_packet.getCvFrame()
                    self.last_rgb_frame = rgb_frame

                    if self.enable_rgb and self.rgb_pub is not None:
                        rgb_msg = self.bridge.cv2_to_imgmsg(rgb_frame, encoding=self.ros_image_encoding)
                        rgb_msg.header.stamp = stamp
                        rgb_msg.header.frame_id = self.frame_id
                        self.rgb_pub.publish(rgb_msg)
                        self.publish_camera_info(stamp)

            if self.enable_depth and self.depth_queue is not None and self.depth_pub is not None:
                depth_packet = self.depth_queue.tryGet()
                if depth_packet is not None:
                    depth_frame = depth_packet.getFrame()
                    self.last_depth_frame = depth_frame

                    depth_msg = self.bridge.cv2_to_imgmsg(depth_frame, encoding="16UC1")
                    depth_msg.header.stamp = stamp
                    depth_msg.header.frame_id = self.frame_id
                    self.depth_pub.publish(depth_msg)

            if self.enable_stereo_fusion:
                left_frame = None
                right_frame = None

                if self.left_queue is not None:
                    left_packet = self.left_queue.tryGet()
                    if left_packet is not None:
                        left_frame = left_packet.getCvFrame()
                        self.last_left_frame = left_frame

                if self.right_queue is not None:
                    right_packet = self.right_queue.tryGet()
                    if right_packet is not None:
                        right_frame = right_packet.getCvFrame()
                        self.last_right_frame = right_frame

                if left_frame is not None and self.left_pub is not None:
                    self.publish_mono8_image(self.left_pub, left_frame, stamp, self.left_frame_id)

                if right_frame is not None and self.right_pub is not None:
                    self.publish_mono8_image(self.right_pub, right_frame, stamp, self.right_frame_id)

                if left_frame is not None and right_frame is not None:
                    if self.stereo_fused_pub is not None:
                        fused_frame = self.make_stereo_fused_frame(left_frame, right_frame)
                        self.last_stereo_fused_frame = fused_frame
                        self.publish_bgr8_image(
                            self.stereo_fused_pub,
                            fused_frame,
                            stamp,
                            self.stereo_frame_id,
                        )

                    if self.stereo_concat_pub is not None:
                        concat_frame = self.make_stereo_concat_frame(left_frame, right_frame)
                        self.publish_bgr8_image(
                            self.stereo_concat_pub,
                            concat_frame,
                            stamp,
                            self.stereo_frame_id,
                        )

            if self.enable_yolo and self.nn_queue is not None:
                nn_packet = self.nn_queue.tryGet()
                if nn_packet is not None:
                    if self.parser == "YoloDetectionNetwork":
                        self.latest_detections = self.normalize_oak_detections(nn_packet.detections)
                    elif self.parser == "NeuralNetwork":
                        self.latest_detections = self.decode_neural_network_packet(nn_packet)
                    else:
                        self.latest_detections = []

                    reference_frame = rgb_frame if rgb_frame is not None else self.last_rgb_frame
                    self.latest_frame_detections = self.scale_detections_to_frame(
                        self.latest_detections,
                        reference_frame,
                    )

                    self.publish_detections_msg(stamp)
                    self.publish_yolo_table()
                    self.publish_debug_text()

                    if (
                        self.publish_annotated_image
                        and self.annotated_pub is not None
                        and reference_frame is not None
                    ):
                        annotated = self.draw_detections(reference_frame, self.latest_frame_detections)

                        ann_msg = self.bridge.cv2_to_imgmsg(annotated, encoding=self.ros_image_encoding)
                        ann_msg.header.stamp = stamp
                        ann_msg.header.frame_id = self.frame_id
                        self.annotated_pub.publish(ann_msg)

        except Exception as e:
            self.get_logger().error(f"OAK timer callback error: {e}")
            if self.stop_on_xlink_error:
                self.oak_alive = False
                raise

    def destroy_node(self):
        self.get_logger().info("Closing OAK device.")
        try:
            if self.device is not None:
                self.device.close()
        except Exception:
            pass

        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = OakVisionDriverNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()