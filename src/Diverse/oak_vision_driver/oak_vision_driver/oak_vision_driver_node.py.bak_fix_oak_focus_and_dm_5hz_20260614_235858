#!/usr/bin/env python3
import os
from typing import Dict, List, Optional, Tuple

import cv2
import depthai as dai
import numpy as np
import rclpy
from cv_bridge import CvBridge
from rclpy.node import Node
from sensor_msgs.msg import CameraInfo, Image
from std_msgs.msg import String


try:
    from yolo_msg.msg import YoloDetection, YoloDetectionArray, Box2D
    HAS_YOLO_MSG = True
except Exception:
    YoloDetection = None
    YoloDetectionArray = None
    Box2D = None
    HAS_YOLO_MSG = False


class OakVisionDriverNode(Node):
    """
    OAK-D / OAK-D Lite ROS2 driver with adjustable RGB / mono resolution.

    Features:
      enable_rgb            -> /oak/rgb/image_raw + /oak/rgb/camera_info
      enable_depth          -> /oak/depth/image_raw
      enable_stereo_fusion  -> /oak/left/image_raw, /oak/right/image_raw,
                               /oak/stereo_fused/image_raw, /oak/stereo_concat/image_raw
      enable_yolo           -> OAK NN / YOLO inference + detection topics

    Resource rule:
      Disabled feature will not create related DepthAI node, XLinkOut stream,
      output queue, ROS publisher, or ROS topic.
    """

    def __init__(self):
        super().__init__("oak_vision_driver_node")
        # Focus parameters: declare before any get_parameter() access.
        try:
            self.declare_parameter("focus_mode", "manual")
        except Exception:
            pass
        try:
            self.declare_parameter("manual_focus", 145)
        except Exception:
            pass
        try:
            self.declare_parameter("autofocus_mode", "continuous_video")
        except Exception:
            pass
        try:
            self.declare_parameter("focus_cmd_topic", "/oak/rgb/focus_set")
        except Exception:
            pass
        try:
            self.declare_parameter("focus_status_topic", "/oak/rgb/focus_status")
        except Exception:
            pass

        self.focus_mode = str(self.get_parameter("focus_mode").value).strip().lower()
        self.manual_focus = int(self.get_parameter("manual_focus").value)
        self.autofocus_mode = str(self.get_parameter("autofocus_mode").value).strip().lower()
        self.focus_cmd_topic = str(self.get_parameter("focus_cmd_topic").value)
        self.focus_status_topic = str(self.get_parameter("focus_status_topic").value)


        # =========================
        # Runtime switches
        # =========================
        self.declare_parameter("enable_rgb", True)
        self.declare_parameter("enable_depth", False)
        self.declare_parameter("enable_yolo", False)
        self.declare_parameter("enable_stereo_fusion", False)

        self.declare_parameter("publish_left_image", True)
        self.declare_parameter("publish_right_image", True)
        self.declare_parameter("publish_stereo_fused_image", True)
        self.declare_parameter("publish_stereo_concat_image", False)

        self.declare_parameter("draw_oak_detections_on_rgb", True)
        self.declare_parameter("publish_annotated_image", True)
        self.declare_parameter("publish_debug_text", True)
        self.declare_parameter("publish_yolo_table", True)

        # =========================
        # Adjustable camera parameters
        # =========================
        self.declare_parameter("sensor_resolution", "1080p")
        self.declare_parameter("mono_resolution", "400p")

        # rgb_output:
        #   preview -> publish preview_width x preview_height
        #   video   -> publish video_width x video_height
        self.declare_parameter("rgb_output", "video")
        self.declare_parameter("color_order", "BGR")
        self.declare_parameter("keep_aspect_ratio", False)

        self.declare_parameter("preview_width", 640)
        self.declare_parameter("preview_height", 640)
        self.declare_parameter("video_width", 1920)
        self.declare_parameter("video_height", 1080)

        # NN input size, normally same as preview.
        self.declare_parameter("input_width", 640)
        self.declare_parameter("input_height", 640)

        self.declare_parameter("fps", 10.0)
        self.declare_parameter("queue_size", 1)
        self.declare_parameter("timer_period", 0.01)
        self.declare_parameter("force_usb2", False)
        self.declare_parameter("stop_on_xlink_error", True)
        self.declare_parameter("ros_image_encoding", "bgr8")
        # RGB focus control.
        # focus_mode:
        #   auto   -> use OAK autofocus
        #   manual -> fixed lens position, disables autofocus hunting
        # manual_focus range is 0~255. Larger value usually focuses closer.

        # Stereo fusion
        self.declare_parameter("stereo_fusion_method", "blend")
        self.declare_parameter("stereo_fusion_alpha", 0.5)

        # =========================
        # Topics
        # =========================
        self.declare_parameter("rgb_topic", "/oak/rgb/image_raw")
        self.declare_parameter("depth_topic", "/oak/depth/image_raw")
        self.declare_parameter("camera_info_topic", "/oak/rgb/camera_info")

        self.declare_parameter("left_topic", "/oak/left/image_raw")
        self.declare_parameter("right_topic", "/oak/right/image_raw")
        self.declare_parameter("stereo_fused_topic", "/oak/stereo_fused/image_raw")
        self.declare_parameter("stereo_concat_topic", "/oak/stereo_concat/image_raw")

        self.declare_parameter("detections_topic", "/yolov5/detections")
        self.declare_parameter("yolo_debug_topic", "/oak/yolo_debug_text")
        self.declare_parameter("annotated_image_topic", "/oak/yolo_annotated_image")
        self.declare_parameter("yolo_table_topic", "/oak/yolo_table")

        self.declare_parameter("frame_id", "oak_camera_link")
        self.declare_parameter("left_frame_id", "oak_left_camera_optical_frame")
        self.declare_parameter("right_frame_id", "oak_right_camera_optical_frame")
        self.declare_parameter("stereo_frame_id", "oak_stereo_fused_frame")

        # =========================
        # YOLO / NN parameters
        # =========================
        self.declare_parameter(
            "blob_path",
            "/host-home/src/target_detection/oak_vision_driver/weights/best_fp16_new.blob",
        )
        self.declare_parameter("network_type", "yolov5")
        self.declare_parameter("parser", "NeuralNetwork")

        self.declare_parameter("num_classes", 1)
        self.declare_parameter("class_names", ["target"])
        self.declare_parameter("conf", 0.25)
        self.declare_parameter("iou", 0.45)

        self.declare_parameter("decoder_debug", False)
        self.declare_parameter("debug_scores", False)
        self.declare_parameter("score_log_interval", 60)

        self.declare_parameter("coordinate_size", 4)
        self.declare_parameter("score_mode", "obj_cls")
        self.declare_parameter("output_value_mode", "auto")

        self.declare_parameter(
            "anchors",
            [
                10.0, 13.0,
                16.0, 30.0,
                33.0, 23.0,
                30.0, 61.0,
                62.0, 45.0,
                59.0, 119.0,
                116.0, 90.0,
                156.0, 198.0,
                373.0, 326.0,
            ],
        )
        self.declare_parameter("anchor_masks.side80", [0, 1, 2])
        self.declare_parameter("anchor_masks.side40", [3, 4, 5])
        self.declare_parameter("anchor_masks.side20", [6, 7, 8])

        # =========================
        # Read parameters
        # =========================
        self.enable_rgb = bool(self.get_parameter("enable_rgb").value)
        self.enable_depth = bool(self.get_parameter("enable_depth").value)
        self.enable_yolo = bool(self.get_parameter("enable_yolo").value)
        self.enable_stereo_fusion = bool(self.get_parameter("enable_stereo_fusion").value)

        self.publish_left_image = bool(self.get_parameter("publish_left_image").value)
        self.publish_right_image = bool(self.get_parameter("publish_right_image").value)
        self.publish_stereo_fused_image = bool(self.get_parameter("publish_stereo_fused_image").value)
        self.publish_stereo_concat_image = bool(self.get_parameter("publish_stereo_concat_image").value)

        self.draw_oak_detections_on_rgb = bool(self.get_parameter("draw_oak_detections_on_rgb").value)
        self.publish_annotated_image = bool(self.get_parameter("publish_annotated_image").value)
        self.publish_debug_text_enabled = bool(self.get_parameter("publish_debug_text").value)
        self.publish_yolo_table_enabled = bool(self.get_parameter("publish_yolo_table").value)

        self.sensor_resolution = str(self.get_parameter("sensor_resolution").value).lower()
        self.mono_resolution = str(self.get_parameter("mono_resolution").value).lower()

        self.rgb_output = str(self.get_parameter("rgb_output").value).lower()
        self.color_order = str(self.get_parameter("color_order").value).upper()
        self.keep_aspect_ratio = bool(self.get_parameter("keep_aspect_ratio").value)

        self.preview_width = int(self.get_parameter("preview_width").value)
        self.preview_height = int(self.get_parameter("preview_height").value)
        self.video_width = int(self.get_parameter("video_width").value)
        self.video_height = int(self.get_parameter("video_height").value)

        self.runtime_width = int(self.get_parameter("input_width").value)
        self.runtime_height = int(self.get_parameter("input_height").value)

        self.fps = float(self.get_parameter("fps").value)
        self.queue_size = int(self.get_parameter("queue_size").value)
        self.timer_period = float(self.get_parameter("timer_period").value)
        self.force_usb2 = bool(self.get_parameter("force_usb2").value)
        self.stop_on_xlink_error = bool(self.get_parameter("stop_on_xlink_error").value)
        self.ros_image_encoding = str(self.get_parameter("ros_image_encoding").value)
        self.focus_mode = str(self.get_parameter("focus_mode").value).strip().lower()
        self.manual_focus = int(self.get_parameter("manual_focus").value)
        self.autofocus_mode = str(self.get_parameter("autofocus_mode").value).strip().lower()

        self.stereo_fusion_method = str(self.get_parameter("stereo_fusion_method").value).lower()
        self.stereo_fusion_alpha = float(self.get_parameter("stereo_fusion_alpha").value)

        if self.rgb_output == "preview":
            self.rgb_width = self.preview_width
            self.rgb_height = self.preview_height
        elif self.rgb_output == "video":
            self.rgb_width = self.video_width
            self.rgb_height = self.video_height
        else:
            self.get_logger().warn(f"Unsupported rgb_output={self.rgb_output}, fallback to preview")
            self.rgb_output = "preview"
            self.rgb_width = self.preview_width
            self.rgb_height = self.preview_height

        self.rgb_topic = str(self.get_parameter("rgb_topic").value)
        self.depth_topic = str(self.get_parameter("depth_topic").value)
        self.camera_info_topic = str(self.get_parameter("camera_info_topic").value)

        self.left_topic = str(self.get_parameter("left_topic").value)
        self.right_topic = str(self.get_parameter("right_topic").value)
        self.stereo_fused_topic = str(self.get_parameter("stereo_fused_topic").value)
        self.stereo_concat_topic = str(self.get_parameter("stereo_concat_topic").value)

        self.detections_topic = str(self.get_parameter("detections_topic").value)
        self.yolo_debug_topic = str(self.get_parameter("yolo_debug_topic").value)
        self.annotated_image_topic = str(self.get_parameter("annotated_image_topic").value)
        self.yolo_table_topic = str(self.get_parameter("yolo_table_topic").value)

        self.frame_id = str(self.get_parameter("frame_id").value)
        self.left_frame_id = str(self.get_parameter("left_frame_id").value)
        self.right_frame_id = str(self.get_parameter("right_frame_id").value)
        self.stereo_frame_id = str(self.get_parameter("stereo_frame_id").value)

        self.blob_path = str(self.get_parameter("blob_path").value)
        self.network_type = str(self.get_parameter("network_type").value)
        self.parser = str(self.get_parameter("parser").value)

        self.num_classes = int(self.get_parameter("num_classes").value)
        self.class_names = list(self.get_parameter("class_names").value)
        self.conf = float(self.get_parameter("conf").value)
        self.iou = float(self.get_parameter("iou").value)

        self.decoder_debug = bool(self.get_parameter("decoder_debug").value)
        self.debug_scores = bool(self.get_parameter("debug_scores").value)
        self.score_log_interval = int(self.get_parameter("score_log_interval").value)
        self._score_log_count = 0

        self.coordinate_size = int(self.get_parameter("coordinate_size").value)
        self.score_mode = str(self.get_parameter("score_mode").value)
        self.output_value_mode = str(self.get_parameter("output_value_mode").value)

        self.anchors = [float(x) for x in self.get_parameter("anchors").value]
        self.anchor_masks_side80 = [int(x) for x in self.get_parameter("anchor_masks.side80").value]
        self.anchor_masks_side40 = [int(x) for x in self.get_parameter("anchor_masks.side40").value]
        self.anchor_masks_side20 = [int(x) for x in self.get_parameter("anchor_masks.side20").value]

        # =========================
        # ROS publishers: create only if enabled
        # =========================
        self.bridge = CvBridge()

        self.rgb_pub = self.create_publisher(Image, self.rgb_topic, 10) if self.enable_rgb else None
        self.camera_info_pub = self.create_publisher(CameraInfo, self.camera_info_topic, 10) if self.enable_rgb else None

        self.depth_pub = self.create_publisher(Image, self.depth_topic, 10) if self.enable_depth else None

        self.left_pub = (
            self.create_publisher(Image, self.left_topic, 10)
            if self.enable_stereo_fusion and self.publish_left_image
            else None
        )
        self.right_pub = (
            self.create_publisher(Image, self.right_topic, 10)
            if self.enable_stereo_fusion and self.publish_right_image
            else None
        )
        self.stereo_fused_pub = (
            self.create_publisher(Image, self.stereo_fused_topic, 10)
            if self.enable_stereo_fusion and self.publish_stereo_fused_image
            else None
        )
        self.stereo_concat_pub = (
            self.create_publisher(Image, self.stereo_concat_topic, 10)
            if self.enable_stereo_fusion and self.publish_stereo_concat_image
            else None
        )

        self.annotated_pub = (
            self.create_publisher(Image, self.annotated_image_topic, 10)
            if self.enable_yolo and self.publish_annotated_image
            else None
        )
        self.debug_pub = (
            self.create_publisher(String, self.yolo_debug_topic, 10)
            if self.enable_yolo and self.publish_debug_text_enabled
            else None
        )
        self.table_pub = (
            self.create_publisher(String, self.yolo_table_topic, 10)
            if self.enable_yolo and self.publish_yolo_table_enabled
            else None
        )

        if self.enable_yolo and HAS_YOLO_MSG:
            self.detections_pub = self.create_publisher(YoloDetectionArray, self.detections_topic, 10)
        else:
            self.detections_pub = None
            if self.enable_yolo and not HAS_YOLO_MSG:
                self.get_logger().warn("yolo_msg import failed. /yolov5/detections will not be published.")

        # Focus attributes must exist before creating focus pub/sub.
        if not hasattr(self, "focus_mode"):
            self.focus_mode = str(self.get_parameter("focus_mode").value).strip().lower()
        if not hasattr(self, "manual_focus"):
            self.manual_focus = int(self.get_parameter("manual_focus").value)
        if not hasattr(self, "autofocus_mode"):
            self.autofocus_mode = str(self.get_parameter("autofocus_mode").value).strip().lower()
        if not hasattr(self, "focus_cmd_topic"):
            self.focus_cmd_topic = str(self.get_parameter("focus_cmd_topic").value)
        if not hasattr(self, "focus_status_topic"):
            self.focus_status_topic = str(self.get_parameter("focus_status_topic").value)

        self.focus_status_pub = self.create_publisher(String, self.focus_status_topic, 10)
        self.focus_cmd_sub = self.create_subscription(
            String,
            self.focus_cmd_topic,
            self.focus_cmd_callback,
            10,
        )

        # =========================
        # Runtime state
        # =========================
        self.pipeline = None
        self.device = None

        self.rgb_queue = None
        self.depth_queue = None
        self.left_queue = None
        self.right_queue = None
        self.nn_queue = None
        self.rgb_control_queue = None

        self.need_rgb_stream = self.enable_rgb or (
            self.enable_yolo and self.publish_annotated_image
        )

        self.oak_alive = False

        self.latest_detections: List[Dict] = []
        self.latest_frame_detections: List[Dict] = []

        self.last_rgb_frame: Optional[np.ndarray] = None
        self.last_depth_frame: Optional[np.ndarray] = None
        self.last_left_frame: Optional[np.ndarray] = None
        self.last_right_frame: Optional[np.ndarray] = None
        self.last_stereo_fused_frame: Optional[np.ndarray] = None

        self.camera_intrinsics = None
        self.printed_nn_layers = False

        self.log_config()
        self.connect_oak()
        self.timer = self.create_timer(self.timer_period, self.timer_callback)

    # =========================
    # Logging
    # =========================
