    # =========================
    # DepthAI resolution helpers
    # =========================
    def get_sensor_resolution_enum(self):
        res = self.sensor_resolution.replace("_", "").replace("-", "").lower()

        if res in ["1080p", "1080"]:
            return dai.ColorCameraProperties.SensorResolution.THE_1080_P
        if res in ["720p", "720"]:
            return dai.ColorCameraProperties.SensorResolution.THE_720_P
        if res in ["4k", "2160p", "2160"]:
            return dai.ColorCameraProperties.SensorResolution.THE_4_K
        if res in ["12mp", "12m"]:
            return dai.ColorCameraProperties.SensorResolution.THE_12_MP

        self.get_logger().warn(f"Unknown sensor_resolution={self.sensor_resolution}, fallback to 1080p")
        return dai.ColorCameraProperties.SensorResolution.THE_1080_P

    def get_mono_resolution_enum(self):
        res = self.mono_resolution.replace("_", "").replace("-", "").lower()

        if res in ["400p", "400"]:
            return dai.MonoCameraProperties.SensorResolution.THE_400_P
        if res in ["480p", "480"]:
            return dai.MonoCameraProperties.SensorResolution.THE_480_P
        if res in ["720p", "720"]:
            return dai.MonoCameraProperties.SensorResolution.THE_720_P
        if res in ["800p", "800"]:
            return dai.MonoCameraProperties.SensorResolution.THE_800_P

        self.get_logger().warn(f"Unknown mono_resolution={self.mono_resolution}, fallback to 400p")
        return dai.MonoCameraProperties.SensorResolution.THE_400_P

    def apply_rgb_focus_control(self, cam_rgb):
        """Apply OAK RGB focus mode before starting the DepthAI pipeline."""
        try:
            mode = str(getattr(self, "focus_mode", "auto")).strip().lower()

            if mode in ("manual", "fixed", "off"):
                lens = int(getattr(self, "manual_focus", 145))
                lens = max(0, min(255, lens))
                cam_rgb.initialControl.setManualFocus(lens)
                self.get_logger().info(
                    f"OAK RGB focus control: MANUAL, lens_position={lens}"
                )
                return

            af_name = str(getattr(self, "autofocus_mode", "continuous_video")).strip().lower()
            af_map = {
                "auto": dai.CameraControl.AutoFocusMode.AUTO,
                "continuous_video": dai.CameraControl.AutoFocusMode.CONTINUOUS_VIDEO,
                "continuous_picture": dai.CameraControl.AutoFocusMode.CONTINUOUS_PICTURE,
                "macro": dai.CameraControl.AutoFocusMode.MACRO,
                "edof": dai.CameraControl.AutoFocusMode.EDOF,
            }
            af_mode = af_map.get(af_name, dai.CameraControl.AutoFocusMode.CONTINUOUS_VIDEO)
            cam_rgb.initialControl.setAutoFocusMode(af_mode)
            self.get_logger().info(
                f"OAK RGB focus control: AUTO, autofocus_mode={af_name}"
            )

        except Exception as e:
            self.get_logger().warn(f"Failed to apply OAK RGB focus control: {e}")


    # =========================
    # RGB focus control
    # =========================
    def _autofocus_mode_enum(self, name: str):
        name = str(name or "continuous_video").strip().lower()
        table = {
            "auto": dai.CameraControl.AutoFocusMode.AUTO,
            "continuous_video": dai.CameraControl.AutoFocusMode.CONTINUOUS_VIDEO,
            "continuous_picture": dai.CameraControl.AutoFocusMode.CONTINUOUS_PICTURE,
            "macro": dai.CameraControl.AutoFocusMode.MACRO,
            "edof": dai.CameraControl.AutoFocusMode.EDOF,
        }
        return table.get(name, dai.CameraControl.AutoFocusMode.CONTINUOUS_VIDEO)

    def apply_initial_rgb_focus_control(self, cam_rgb):
        try:
            mode = str(getattr(self, "focus_mode", "manual")).strip().lower()
            if mode in ("manual", "fixed", "off"):
                lens = max(0, min(255, int(getattr(self, "manual_focus", 145))))
                cam_rgb.initialControl.setManualFocus(lens)
                self.get_logger().info(f"OAK RGB initial focus: MANUAL lens={lens}")
            else:
                af_mode = self._autofocus_mode_enum(getattr(self, "autofocus_mode", "continuous_video"))
                cam_rgb.initialControl.setAutoFocusMode(af_mode)
                self.get_logger().info(f"OAK RGB initial focus: AUTO mode={self.autofocus_mode}")
        except Exception as e:
            self.get_logger().warn(f"Failed to apply initial OAK focus: {e}")

    def send_rgb_manual_focus(self, lens: int):
        lens = max(0, min(255, int(lens)))
        self.manual_focus = lens
        self.focus_mode = "manual"

        if self.rgb_control_queue is not None:
            ctrl = dai.CameraControl()
            ctrl.setManualFocus(lens)
            self.rgb_control_queue.send(ctrl)

        self.publish_focus_status("manual", lens)
        self.get_logger().info(f"OAK RGB runtime focus: MANUAL lens={lens}")

    def send_rgb_auto_focus(self, autofocus_mode: str = None):
        self.focus_mode = "auto"
        if autofocus_mode:
            self.autofocus_mode = str(autofocus_mode).strip().lower()

        if self.rgb_control_queue is not None:
            ctrl = dai.CameraControl()
            ctrl.setAutoFocusMode(self._autofocus_mode_enum(self.autofocus_mode))
            self.rgb_control_queue.send(ctrl)

        self.publish_focus_status("auto", self.manual_focus)
        self.get_logger().info(f"OAK RGB runtime focus: AUTO mode={self.autofocus_mode}")

    def publish_focus_status(self, mode=None, lens=None):
        try:
            msg = String()
            msg.data = (
                "{"
                f'"mode":"{mode or self.focus_mode}",'
                f'"manual_focus":{int(lens if lens is not None else self.manual_focus)},'
                f'"autofocus_mode":"{self.autofocus_mode}"'
                "}"
            )
            self.focus_status_pub.publish(msg)
        except Exception:
            pass

    def focus_cmd_callback(self, msg):
        import json
        raw = str(msg.data or "").strip()

        try:
            data = json.loads(raw)
        except Exception:
            # Allow plain number, e.g. "160"
            try:
                data = {"mode": "manual", "manual_focus": int(raw)}
            except Exception:
                self.get_logger().warn(f"Invalid focus command: {raw}")
                return

        mode = str(data.get("mode", data.get("focus_mode", "manual"))).strip().lower()

        if mode in ("manual", "fixed", "off"):
            lens = int(data.get("manual_focus", data.get("lens", self.manual_focus)))
            self.send_rgb_manual_focus(lens)
        elif mode in ("auto", "af"):
            self.send_rgb_auto_focus(str(data.get("autofocus_mode", self.autofocus_mode)))
        else:
            self.get_logger().warn(f"Unknown focus mode: {mode}")


    # =========================
    # DepthAI pipeline
    # =========================
    def create_pipeline(self):
        pipeline = dai.Pipeline()

        cam_rgb = None

        if self.need_rgb_stream or self.enable_yolo:
            cam_rgb = pipeline.create(dai.node.ColorCamera)
            cam_rgb.setBoardSocket(dai.CameraBoardSocket.CAM_A)
            cam_rgb.setResolution(self.get_sensor_resolution_enum())
            cam_rgb.setPreviewSize(self.preview_width, self.preview_height)
            cam_rgb.setInterleaved(False)
            cam_rgb.setFps(self.fps)

            if hasattr(cam_rgb, "setPreviewKeepAspectRatio"):
                cam_rgb.setPreviewKeepAspectRatio(self.keep_aspect_ratio)

            if self.color_order == "BGR":
                cam_rgb.setColorOrder(dai.ColorCameraProperties.ColorOrder.BGR)
            else:
                cam_rgb.setColorOrder(dai.ColorCameraProperties.ColorOrder.RGB)

            if self.rgb_output == "video":
                cam_rgb.setVideoSize(self.video_width, self.video_height)

            self.apply_initial_rgb_focus_control(cam_rgb)

            xin_rgb_ctrl = pipeline.create(dai.node.XLinkIn)
            xin_rgb_ctrl.setStreamName("rgb_control")
            xin_rgb_ctrl.out.link(cam_rgb.inputControl)

            self.apply_rgb_focus_control(cam_rgb)

            if self.need_rgb_stream:
                xout_rgb = pipeline.create(dai.node.XLinkOut)
                xout_rgb.setStreamName("rgb")

                if self.rgb_output == "video":
                    cam_rgb.video.link(xout_rgb.input)
                else:
                    cam_rgb.preview.link(xout_rgb.input)

        if self.enable_depth or self.enable_stereo_fusion:
            mono_left = pipeline.create(dai.node.MonoCamera)
            mono_right = pipeline.create(dai.node.MonoCamera)
            stereo = pipeline.create(dai.node.StereoDepth)

            mono_left.setBoardSocket(dai.CameraBoardSocket.CAM_B)
            mono_right.setBoardSocket(dai.CameraBoardSocket.CAM_C)

            mono_res = self.get_mono_resolution_enum()
            mono_left.setResolution(mono_res)
            mono_right.setResolution(mono_res)
            mono_left.setFps(self.fps)
            mono_right.setFps(self.fps)

            stereo.setDefaultProfilePreset(dai.node.StereoDepth.PresetMode.HIGH_DENSITY)
            stereo.setLeftRightCheck(True)
            stereo.setSubpixel(False)

            mono_left.out.link(stereo.left)
            mono_right.out.link(stereo.right)

            if self.enable_depth:
                if cam_rgb is not None:
                    stereo.setDepthAlign(dai.CameraBoardSocket.CAM_A)
                    stereo.setOutputSize(self.preview_width, self.preview_height)

                xout_depth = pipeline.create(dai.node.XLinkOut)
                xout_depth.setStreamName("depth")
                stereo.depth.link(xout_depth.input)

            if self.enable_stereo_fusion:
                xout_left = pipeline.create(dai.node.XLinkOut)
                xout_right = pipeline.create(dai.node.XLinkOut)

                xout_left.setStreamName("left")
                xout_right.setStreamName("right")

                stereo.rectifiedLeft.link(xout_left.input)
                stereo.rectifiedRight.link(xout_right.input)

        if self.enable_yolo:
            if cam_rgb is None:
                raise RuntimeError("enable_yolo=True requires ColorCamera preview stream.")

            if not os.path.exists(self.blob_path):
                raise RuntimeError(f"YOLO blob does not exist: {self.blob_path}")

            xout_nn = pipeline.create(dai.node.XLinkOut)
            xout_nn.setStreamName("nn")

            if self.parser == "YoloDetectionNetwork":
                yolo = pipeline.create(dai.node.YoloDetectionNetwork)
                yolo.setBlobPath(self.blob_path)
                yolo.setConfidenceThreshold(float(self.conf))
                yolo.setNumClasses(int(self.num_classes))
                yolo.setCoordinateSize(int(self.coordinate_size))
                yolo.setAnchors([float(x) for x in self.anchors])
                yolo.setAnchorMasks(
                    {
                        "side80": [int(x) for x in self.anchor_masks_side80],
                        "side40": [int(x) for x in self.anchor_masks_side40],
                        "side20": [int(x) for x in self.anchor_masks_side20],
                    }
                )
                yolo.setIouThreshold(float(self.iou))

                cam_rgb.preview.link(yolo.input)
                yolo.out.link(xout_nn.input)

                self.get_logger().info("OAK YOLO backend: YoloDetectionNetwork")

            elif self.parser == "NeuralNetwork":
                nn = pipeline.create(dai.node.NeuralNetwork)
                nn.setBlobPath(self.blob_path)

                cam_rgb.preview.link(nn.input)
                nn.out.link(xout_nn.input)

                self.get_logger().info("OAK YOLO backend: NeuralNetwork host decoder")
            else:
                raise RuntimeError(f"Unsupported parser={self.parser}")

        return pipeline

    def connect_oak(self):
        try:
            self.pipeline = self.create_pipeline()

            if self.force_usb2:
                self.get_logger().warn("Opening OAK with USB2 fallback: dai.UsbSpeed.HIGH")
                self.device = dai.Device(self.pipeline, dai.UsbSpeed.HIGH)
            else:
                self.device = dai.Device(self.pipeline)

            if self.need_rgb_stream:
                self.rgb_queue = self.device.getOutputQueue(
                    name="rgb",
                    maxSize=self.queue_size,
                    blocking=False,
                )

            if self.enable_depth:
                self.depth_queue = self.device.getOutputQueue(
                    name="depth",
                    maxSize=self.queue_size,
                    blocking=False,
                )

            if self.enable_stereo_fusion:
                self.left_queue = self.device.getOutputQueue(
                    name="left",
                    maxSize=self.queue_size,
                    blocking=False,
                )
                self.right_queue = self.device.getOutputQueue(
                    name="right",
                    maxSize=self.queue_size,
                    blocking=False,
                )

            if self.enable_yolo:
                self.nn_queue = self.device.getOutputQueue(
                    name="nn",
                    maxSize=self.queue_size,
                    blocking=False,
                )

            if self.need_rgb_stream or self.enable_yolo:
                try:
                    self.rgb_control_queue = self.device.getInputQueue("rgb_control")
                    if self.focus_mode in ("manual", "fixed", "off"):
                        self.send_rgb_manual_focus(self.manual_focus)
                    else:
                        self.send_rgb_auto_focus(self.autofocus_mode)
                except Exception as e:
                    self.get_logger().warn(f"Failed to open rgb_control input queue: {e}")

            self.load_camera_intrinsics()
            self.oak_alive = True
            self.get_logger().info("OAK connected successfully")

        except Exception as e:
            self.oak_alive = False
            self.get_logger().error(f"Failed to connect OAK: {e}")
            if self.stop_on_xlink_error:
                raise

    def load_camera_intrinsics(self):
        if self.device is None:
            self.camera_intrinsics = None
            return

        try:
            calib = self.device.readCalibration()
            intr = calib.getCameraIntrinsics(
                dai.CameraBoardSocket.CAM_A,
                self.rgb_width,
                self.rgb_height,
            )
            self.camera_intrinsics = intr
            self.get_logger().info(f"OAK RGB intrinsics: {intr}")
        except Exception as e:
            self.camera_intrinsics = None
            self.get_logger().warn(f"Failed to read OAK calibration intrinsics: {e}")

    # =========================
    # YOLO decode helpers
    # =========================
    def sigmoid(self, x):
        return 1.0 / (1.0 + np.exp(-x))

    def get_anchor_pairs(self):
        pairs = []
        for i in range(0, len(self.anchors), 2):
            pairs.append((float(self.anchors[i]), float(self.anchors[i + 1])))
        return pairs

    def bbox_iou(self, a: Dict, b: Dict) -> float:
        ax1, ay1, ax2, ay2 = a["xmin"], a["ymin"], a["xmax"], a["ymax"]
        bx1, by1, bx2, by2 = b["xmin"], b["ymin"], b["xmax"], b["ymax"]

        inter_x1 = max(ax1, bx1)
        inter_y1 = max(ay1, by1)
        inter_x2 = min(ax2, bx2)
        inter_y2 = min(ay2, by2)

        inter_w = max(0.0, inter_x2 - inter_x1)
        inter_h = max(0.0, inter_y2 - inter_y1)
        inter_area = inter_w * inter_h

        area_a = max(0.0, ax2 - ax1) * max(0.0, ay2 - ay1)
        area_b = max(0.0, bx2 - bx1) * max(0.0, by2 - by1)

        union = area_a + area_b - inter_area
        if union <= 0.0:
            return 0.0

        return inter_area / union

    def nms(self, detections: List[Dict], iou_thres: float) -> List[Dict]:
        if not detections:
            return []

        detections = sorted(detections, key=lambda x: x["confidence"], reverse=True)
        keep = []

        while detections:
            best = detections.pop(0)
            keep.append(best)
            detections = [det for det in detections if self.bbox_iou(best, det) < iou_thres]

        return keep

    def decode_neural_network_packet(self, nn_packet) -> List[Dict]:
        layer_names = list(nn_packet.getAllLayerNames())

        if not self.printed_nn_layers:
            sizes = {}
            for name in layer_names:
                try:
                    sizes[name] = len(nn_packet.getLayerFp16(name))
                except Exception:
                    sizes[name] = -1

            self.get_logger().info(f"NN layer_names={layer_names}, sizes={sizes}")
            self.printed_nn_layers = True

        attrs = 5 + int(self.num_classes)
        anchor_pairs = self.get_anchor_pairs()

        sides = [
            int(self.runtime_width // 8),
            int(self.runtime_width // 16),
            int(self.runtime_width // 32),
        ]

        side_to_mask = {
            sides[0]: self.anchor_masks_side80,
            sides[1]: self.anchor_masks_side40,
            sides[2]: self.anchor_masks_side20,
        }

        detections = []
        per_layer_stats = []

        for name in layer_names:
            raw = np.array(nn_packet.getLayerFp16(name), dtype=np.float32)

            matched_side = None
            for side in sides:
                expected = 3 * side * side * attrs
                if raw.size == expected:
                    matched_side = side
                    break

            if matched_side is None:
                continue

            side = matched_side
            mask = side_to_mask[side]
            arr = raw.reshape(3, side, side, attrs)

            layer_dets, stats = self.decode_yolov5_layer(
                arr=arr,
                side=side,
                mask=mask,
                anchor_pairs=anchor_pairs,
                attrs=attrs,
                layer_name=name,
            )
            detections.extend(layer_dets)
            per_layer_stats.append(stats)

        if self.debug_scores:
            self._score_log_count += 1
            if self._score_log_count % max(1, self.score_log_interval) == 0 and per_layer_stats:
                self.get_logger().info(" | ".join(per_layer_stats))

        return self.nms(detections, float(self.iou))

    def decode_yolov5_layer(
        self,
        arr: np.ndarray,
        side: int,
        mask: List[int],
        anchor_pairs: List[Tuple[float, float]],
        attrs: int,
        layer_name: str = "",
    ):
        dets = []
        stride = float(self.runtime_width) / float(side)

        for anchor_idx_in_layer, global_anchor_idx in enumerate(mask):
            if global_anchor_idx < 0 or global_anchor_idx >= len(anchor_pairs):
                continue

            anchor_w, anchor_h = anchor_pairs[global_anchor_idx]
            pred = arr[anchor_idx_in_layer]

            tx = pred[:, :, 0]
            ty = pred[:, :, 1]
            tw = pred[:, :, 2]
            th = pred[:, :, 3]
            tobj = pred[:, :, 4]

            pred_5 = pred[:, :, :5]

            if self.output_value_mode == "sigmoid":
                already_sigmoid = True
            elif self.output_value_mode == "logits":
                already_sigmoid = False
            else:
                already_sigmoid = (np.nanmin(pred_5) >= 0.0 and np.nanmax(pred_5) <= 1.0)

            if already_sigmoid:
                sx, sy, sw, sh, obj = tx, ty, tw, th, tobj
            else:
                sx = self.sigmoid(tx)
                sy = self.sigmoid(ty)
                sw = self.sigmoid(tw)
                sh = self.sigmoid(th)
                obj = self.sigmoid(tobj)

            if self.num_classes == 1:
                cls_raw = pred[:, :, 5]

                if self.output_value_mode == "sigmoid":
                    cls_score = cls_raw
                elif self.output_value_mode == "logits":
                    cls_score = self.sigmoid(cls_raw)
                else:
                    cls_score = (
                        cls_raw
                        if (np.nanmin(cls_raw) >= 0.0 and np.nanmax(cls_raw) <= 1.0)
                        else self.sigmoid(cls_raw)
                    )

                if self.score_mode == "objectness":
                    score = obj
                else:
                    score = obj * cls_score

                class_id_map = np.zeros_like(score, dtype=np.int32)
            else:
                cls_raw = pred[:, :, 5:5 + self.num_classes]

                if self.output_value_mode == "sigmoid":
                    cls_scores = cls_raw
                elif self.output_value_mode == "logits":
                    cls_scores = self.sigmoid(cls_raw)
                else:
                    cls_scores = (
                        cls_raw
                        if (np.nanmin(cls_raw) >= 0.0 and np.nanmax(cls_raw) <= 1.0)
                        else self.sigmoid(cls_raw)
                    )

                class_id_map = np.argmax(cls_scores, axis=-1)
                best_cls_score = np.max(cls_scores, axis=-1)

                if self.score_mode == "objectness":
                    score = obj
                else:
                    score = obj * best_cls_score

            ys, xs = np.where(score >= float(self.conf))

            for gy, gx in zip(ys, xs):
                conf = float(score[gy, gx])
                class_id = int(class_id_map[gy, gx])

                bx = (float(sx[gy, gx]) * 2.0 - 0.5 + float(gx)) * stride
                by = (float(sy[gy, gx]) * 2.0 - 0.5 + float(gy)) * stride
                bw = ((float(sw[gy, gx]) * 2.0) ** 2) * anchor_w
                bh = ((float(sh[gy, gx]) * 2.0) ** 2) * anchor_h

                x1 = bx - bw / 2.0
                y1 = by - bh / 2.0
                x2 = bx + bw / 2.0
                y2 = by + bh / 2.0

                x1 = max(0.0, min(float(self.runtime_width - 1), x1))
                y1 = max(0.0, min(float(self.runtime_height - 1), y1))
                x2 = max(0.0, min(float(self.runtime_width - 1), x2))
                y2 = max(0.0, min(float(self.runtime_height - 1), y2))

                if x2 <= x1 or y2 <= y1:
                    continue

                class_name = (
                    self.class_names[class_id]
                    if 0 <= class_id < len(self.class_names)
                    else str(class_id)
                )

                dets.append(
                    {
                        "class_id": class_id,
                        "class_name": class_name,
                        "confidence": conf,
                        "xmin": x1,
                        "ymin": y1,
                        "xmax": x2,
                        "ymax": y2,
                    }
                )

        stats = f"{layer_name}: side={side}, dets={len(dets)}"
        return dets, stats

    def normalize_oak_detections(self, detections):
        out = []

        for det in detections:
            label_id = int(det.label)
            conf = float(det.confidence)

            xmin = max(0.0, min(1.0, float(det.xmin)))
            ymin = max(0.0, min(1.0, float(det.ymin)))
            xmax = max(0.0, min(1.0, float(det.xmax)))
            ymax = max(0.0, min(1.0, float(det.ymax)))

            if xmax <= xmin or ymax <= ymin:
                continue

            class_name = (
                self.class_names[label_id]
                if 0 <= label_id < len(self.class_names)
                else str(label_id)
            )

            out.append(
                {
                    "class_id": label_id,
                    "class_name": class_name,
                    "confidence": conf,
                    "xmin_norm": xmin,
                    "ymin_norm": ymin,
                    "xmax_norm": xmax,
                    "ymax_norm": ymax,
                    "xmin": xmin,
                    "ymin": ymin,
                    "xmax": xmax,
                    "ymax": ymax,
                }
            )

        return out

    def scale_detections_to_frame(self, detections, frame):
        if frame is None:
            h = self.runtime_height
            w = self.runtime_width
        else:
            h, w = frame.shape[:2]

        scaled = []

        for det in detections:
            d = dict(det)

            if "xmin_norm" in d:
                x1 = int(float(d["xmin_norm"]) * w)
                y1 = int(float(d["ymin_norm"]) * h)
                x2 = int(float(d["xmax_norm"]) * w)
                y2 = int(float(d["ymax_norm"]) * h)
            else:
                raw_x1 = float(d.get("xmin", 0.0))
                raw_y1 = float(d.get("ymin", 0.0))
                raw_x2 = float(d.get("xmax", 0.0))
                raw_y2 = float(d.get("ymax", 0.0))

                x1 = int(raw_x1 * w / float(self.runtime_width))
                y1 = int(raw_y1 * h / float(self.runtime_height))
                x2 = int(raw_x2 * w / float(self.runtime_width))
                y2 = int(raw_y2 * h / float(self.runtime_height))

            x1 = max(0, min(w - 1, x1))
            y1 = max(0, min(h - 1, y1))
            x2 = max(0, min(w - 1, x2))
            y2 = max(0, min(h - 1, y2))

            if x2 <= x1 or y2 <= y1:
                continue

            d["xmin"] = x1
            d["ymin"] = y1
            d["xmax"] = x2
            d["ymax"] = y2
            d["bbox_width"] = x2 - x1
            d["bbox_height"] = y2 - y1
            d["center_x"] = (x1 + x2) / 2.0
            d["center_y"] = (y1 + y2) / 2.0
            d["image_width"] = w
            d["image_height"] = h

            scaled.append(d)

        return scaled

