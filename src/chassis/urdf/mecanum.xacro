<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mecanum_drive" params="
      use_sim:=true
      config_path:=''
      wheel_mu1:=0.8
      wheel_mu2:=0.6
      wheel_kp:=100000.0
      wheel_kd:=10.0
      caster_mu1:=0.15
      caster_mu2:=0.05
      caster_kp:=8000.0
      caster_kd:=1.0
      caster_damping:=0.2
      caster_friction:=0.05">

    <xacro:if value="${use_sim}">

      <!-- 麦轮驱动插件 -->
      <gazebo>
        <plugin name="my_mecanum_plugin" filename="libmecanum_drive_plugin.so">
          <config_file>${config_path}</config_file>
        </plugin>
      </gazebo>

      <!-- joint_states 发布：只发布真正需要的关节 -->
      <gazebo>
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
          <ros>
            <remapping>~/out:=joint_states</remapping>
          </ros>
          <update_rate>50</update_rate>

          <!-- 四个麦轮 -->
          <joint_name>FL_Joint</joint_name>
          <joint_name>FR_Joint</joint_name>
          <joint_name>BL_Joint</joint_name>
          <joint_name>BR_Joint</joint_name>

          <!-- 四个从动轮滚轮 -->
          <joint_name>caster-FL-wheel-Joint</joint_name>
          <joint_name>caster-FR-wheel-Joint</joint_name>
          <joint_name>caster-BL-wheel-Joint</joint_name>
          <joint_name>caster-BR-wheel-Joint</joint_name>
        </plugin>
      </gazebo>

      <!-- =========================
           麦轮接触参数
           ========================= -->
      <gazebo reference="FL_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>

      <gazebo reference="FR_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>

      <gazebo reference="BL_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>

      <gazebo reference="BR_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>

      <!-- =========================
           从动轮接触参数
           注意：一定挂在小滚轮 link 上
           不是挂在 caster_FL_Link / caster_LR_Link / caster_BL_Link / caster_BR_Link 上
           ========================= -->
      <gazebo reference="caster-FL-wheel-Link">
        <mu1>${caster_mu1}</mu1>
        <mu2>${caster_mu2}</mu2>
        <kp>${caster_kp}</kp>
        <kd>${caster_kd}</kd>
      </gazebo>

      <gazebo reference="caster-FR-wheel-Link">
        <mu1>${caster_mu1}</mu1>
        <mu2>${caster_mu2}</mu2>
        <kp>${caster_kp}</kp>
        <kd>${caster_kd}</kd>
      </gazebo>

      <gazebo reference="caster-BL-wheel-Link">
        <mu1>${caster_mu1}</mu1>
        <mu2>${caster_mu2}</mu2>
        <kp>${caster_kp}</kp>
        <kd>${caster_kd}</kd>
      </gazebo>

      <gazebo reference="caster-BR-wheel-Link">
        <mu1>${caster_mu1}</mu1>
        <mu2>${caster_mu2}</mu2>
        <kp>${caster_kp}</kp>
        <kd>${caster_kd}</kd>
      </gazebo>

    </xacro:if>
  </xacro:macro>

</robot>