<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="minimal_lidar_robot">
  <xacro:arg name="laser_x" default="0.10"/>
  <xacro:arg name="laser_y" default="0.0"/>
  <xacro:arg name="laser_z" default="0.15"/>
  <xacro:arg name="laser_yaw" default="0.0"/>

  <link name="base_link"/>
  <link name="laser"/>

  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="$(arg laser_x) $(arg laser_y) $(arg laser_z)" rpy="0 0 $(arg laser_yaw)"/>
  </joint>
</robot>
