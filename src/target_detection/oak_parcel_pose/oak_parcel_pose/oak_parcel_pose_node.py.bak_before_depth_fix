#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
oak_parcel_pose_node

ROS2 Python node for detecting Data Matrix codes in an RGB image and estimating
3D position in the camera frame using an aligned depth image and CameraInfo.

Important:
- This node uses zxingcpp.read_barcodes(...), not zxingcpp.MultiFormatReader().
- Depth should preferably be aligned to RGB/color image.
- Output X/Y/Z is in millimeters.
"""

import json
import math
import time
from typing import Dict, List, Optional, Tuple

import cv2
import numpy as np
import rclpy
from cv_bridge import CvBridge
from rclpy.node import Node
from sensor_msgs.msg import CameraInfo, Image
from std_msgs.msg import String

try:
    import zxingcpp
    HAS_ZXING = True
except Exception:
    zxingcpp = None
    HAS_ZXING = False

Point2D = Tuple[int, int]


class OakParcelPoseNode(Node):
    """
    Detect Data Matrix from RGB and compute camera-frame XYZ from depth.

    Subscribes:
      rgb_topic          sensor_msgs/Image, normally /oak/rgb/image_raw
      depth_topic        sensor_msgs/Image, preferably aligned depth image
      camera_info_topic  sensor_msgs/CameraInfo, RGB/color camera intrinsics

    Publishes:
      result_topic       std_msgs/String, first decoded code text for old logic
      result_json_topic  std_msgs/String, full JSON result with XYZ in mm
      debug_image_topic  sensor_msgs/Image, overlay image
    """

    def __init__(self) -> None:
        super().__init__("oak_parcel_pose_node")

        # ----------------------------- Parameters -----------------------------
        self.declare_parameter("rgb_topic", "/oak/rgb/image_raw")
        self.declare_parameter("depth_topic", "/oak/stereo/image_raw")
        self.declare_parameter("camera_info_topic", "/oak/rgb/camera_info")

        self.declare_parameter("result_topic", "/oak/datamatrix_result")
        self.declare_parameter("result_json_topic", "/oak/datamatrix_3d_result_json")
        self.declare_parameter("debug_image_topic", "/oak/datamatrix_depth_debug_image")

        self.declare_parameter("publish_debug_image", True)
        self.declare_parameter("show_window", False)

        self.declare_parameter("roi_ratio", 1.0)
        self.declare_parameter("resize_scale", 2.0)
        self.declare_parameter("decode_interval", 0.15)
        self.declare_parameter("repeat_publish_interval", 0.8)

        self.declare_parameter("datamatrix_only", True)
        self.declare_parameter("deduplicate", True)
        self.declare_parameter("enable_sharpen", True)
        self.declare_parameter("enable_binary", False)

        # depth_unit:
        #   auto: 16UC1/mono16 -> mm; 32FC1 -> meter converted to mm
        #   mm:   use depth value directly as mm
        #   m:    multiply depth value by 1000
        self.declare_parameter("depth_unit", "auto")
        self.declare_parameter("depth_search_radius_px", 4)
        self.declare_parameter("bbox_depth_fallback", True)
        self.declare_parameter("min_valid_depth_mm", 50.0)
        self.declare_parameter("max_valid_depth_mm", 10000.0)
        self.declare_parameter("allow_resize_depth_to_rgb", True)

        # ----------------------------- Read parameters -----------------------------
        self.rgb_topic = str(self.get_parameter("rgb_topic").value)
        self.depth_topic = str(self.get_parameter("depth_topic").value)
        self.camera_info_topic = str(self.get_parameter("camera_info_topic").value)

        self.result_topic = str(self.get_parameter("result_topic").value)
        self.result_json_topic = str(self.get_parameter("result_json_topic").value)
        self.debug_image_topic = str(self.get_parameter("debug_image_topic").value)

        self.publish_debug_image = bool(self.get_parameter("publish_debug_image").value)
        self.show_window = bool(self.get_parameter("show_window").value)

        self.roi_ratio = float(self.get_parameter("roi_ratio").value)
        self.resize_scale = float(self.get_parameter("resize_scale").value)
        self.decode_interval = float(self.get_parameter("decode_interval").value)
        self.repeat_publish_interval = float(self.get_parameter("repeat_publish_interval").value)

        self.datamatrix_only = bool(self.get_parameter("datamatrix_only").value)
        self.deduplicate = bool(self.get_parameter("deduplicate").value)
        self.enable_sharpen = bool(self.get_parameter("enable_sharpen").value)
        self.enable_binary = bool(self.get_parameter("enable_binary").value)

        self.depth_unit = str(self.get_parameter("depth_unit").value).lower()
        self.depth_search_radius_px = int(self.get_parameter("depth_search_radius_px").value)
        self.bbox_depth_fallback = bool(self.get_parameter("bbox_depth_fallback").value)
        self.min_valid_depth_mm = float(self.get_parameter("min_valid_depth_mm").value)
        self.max_valid_depth_mm = float(self.get_parameter("max_valid_depth_mm").value)
        self.allow_resize_depth_to_rgb = bool(self.get_parameter("allow_resize_depth_to_rgb").value)

        # ----------------------------- ROS objects -----------------------------
        self.bridge = CvBridge()

        self.latest_depth: Optional[np.ndarray] = None
        self.latest_depth_encoding: str = ""
        self.latest_depth_frame_id: str = ""
        self.latest_depth_stamp = None

        self.fx: Optional[float] = None
        self.fy: Optional[float] = None
        self.cx: Optional[float] = None
        self.cy: Optional[float] = None
        self.camera_frame_id: str = ""
        self.camera_info: Optional[CameraInfo] = None

        self.last_decode_time = 0.0
        self.last_publish_time = 0.0
        self.last_signature = ""
        self.last_wait_depth_log = 0.0
        self.last_wait_info_log = 0.0

        self.rgb_sub = self.create_subscription(Image, self.rgb_topic, self.rgb_callback, 10)
        self.depth_sub = self.create_subscription(Image, self.depth_topic, self.depth_callback, 10)
        self.camera_info_sub = self.create_subscription(CameraInfo, self.camera_info_topic, self.camera_info_callback, 10)

        self.result_pub = self.create_publisher(String, self.result_topic, 10)
        self.result_json_pub = self.create_publisher(String, self.result_json_topic, 10)
        self.debug_image_pub = (
            self.create_publisher(Image, self.debug_image_topic, 10)
            if self.publish_debug_image else None
        )

        self.get_logger().info("oak_parcel_pose_node started")
        self.get_logger().info(f"rgb_topic: {self.rgb_topic}")
        self.get_logger().info(f"depth_topic: {self.depth_topic}")
        self.get_logger().info(f"camera_info_topic: {self.camera_info_topic}")
        self.get_logger().info(f"result_json_topic: {self.result_json_topic}")

        if not HAS_ZXING:
            self.get_logger().error("zxing-cpp not installed. Install it with: pip3 install zxing-cpp")

    # -------------------------------------------------------------------------
    # ROS callbacks
    # -------------------------------------------------------------------------
    def camera_info_callback(self, msg: CameraInfo) -> None:
        self.camera_info = msg
        self.fx = float(msg.k[0])
        self.fy = float(msg.k[4])
        self.cx = float(msg.k[2])
        self.cy = float(msg.k[5])
        self.camera_frame_id = msg.header.frame_id

        if self.fx <= 0.0 or self.fy <= 0.0:
            self.get_logger().warn("Invalid CameraInfo: fx/fy <= 0")

    def depth_callback(self, msg: Image) -> None:
        try:
            self.latest_depth = self.bridge.imgmsg_to_cv2(msg, desired_encoding="passthrough")
            self.latest_depth_encoding = str(msg.encoding)
            self.latest_depth_frame_id = str(msg.header.frame_id)
            self.latest_depth_stamp = msg.header.stamp
        except Exception as e:
            self.get_logger().error(f"Depth convert failed: {e}")

    def rgb_callback(self, msg: Image) -> None:
        now = time.time()
        if now - self.last_decode_time < self.decode_interval:
            return
        self.last_decode_time = now

        if self.latest_depth is None:
            if now - self.last_wait_depth_log > 2.0:
                self.get_logger().warn("Waiting for depth image ...")
                self.last_wait_depth_log = now
            return

        if self.fx is None or self.fy is None or self.cx is None or self.cy is None:
            if now - self.last_wait_info_log > 2.0:
                self.get_logger().warn("Waiting for CameraInfo intrinsics ...")
                self.last_wait_info_log = now
            return

        try:
            rgb_frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
        except Exception as e:
            self.get_logger().error(f"RGB convert failed: {e}")
            return

        results_2d = self.decode_frame(rgb_frame)
        results_3d = self.attach_depth_and_xyz(results_2d, rgb_frame.shape[:2], self.latest_depth)
        debug = self.draw_results(rgb_frame, results_3d)

        if results_3d:
            self.publish_results(results_3d, msg)

        if self.debug_image_pub is not None:
            try:
                debug_msg = self.bridge.cv2_to_imgmsg(debug, encoding="bgr8")
                debug_msg.header.stamp = msg.header.stamp
                debug_msg.header.frame_id = msg.header.frame_id
                self.debug_image_pub.publish(debug_msg)
            except Exception as e:
                self.get_logger().warn(f"debug image publish failed: {e}")

        if self.show_window:
            cv2.imshow("oak_parcel_pose", debug)
            key = cv2.waitKey(1)
            if key == ord("q"):
                rclpy.shutdown()

    # -------------------------------------------------------------------------
    # ROI and preprocessing
    # -------------------------------------------------------------------------
    def crop_center_roi(self, frame: np.ndarray) -> Tuple[np.ndarray, Tuple[int, int, int, int]]:
        h, w = frame.shape[:2]
        ratio = max(0.1, min(1.0, self.roi_ratio))
        roi_w = int(w * ratio)
        roi_h = int(h * ratio)
        x1 = max((w - roi_w) // 2, 0)
        y1 = max((h - roi_h) // 2, 0)
        x2 = min(x1 + roi_w, w)
        y2 = min(y1 + roi_h, h)
        return frame[y1:y2, x1:x2], (x1, y1, x2, y2)

    def make_candidates(self, roi: np.ndarray):
        candidates = [("raw", roi, 1.0)]

        gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
        candidates.append(("gray", gray, 1.0))

        if self.resize_scale > 1.0:
            gray_big = cv2.resize(
                gray,
                None,
                fx=self.resize_scale,
                fy=self.resize_scale,
                interpolation=cv2.INTER_CUBIC,
            )
            candidates.append(("gray_big", gray_big, self.resize_scale))
        else:
            gray_big = gray

        if self.enable_sharpen:
            blur = cv2.GaussianBlur(gray_big, (0, 0), 1.0)
            sharp = cv2.addWeighted(gray_big, 1.6, blur, -0.6, 0)
            candidates.append(("sharp_big", sharp, self.resize_scale))
        else:
            sharp = gray_big

        if self.enable_binary:
            try:
                binary = cv2.adaptiveThreshold(
                    sharp,
                    255,
                    cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
                    cv2.THRESH_BINARY,
                    31,
                    5,
                )
                candidates.append(("binary", binary, self.resize_scale))
            except Exception:
                pass

        return candidates

    # -------------------------------------------------------------------------
    # ZXing helpers
    # -------------------------------------------------------------------------
    @staticmethod
    def is_datamatrix(fmt) -> bool:
        f = str(fmt).lower()
        return "datamatrix" in f or "data_matrix" in f or "data matrix" in f

    @staticmethod
    def extract_points_from_zxing(result, roi_offset=(0, 0), scale: float = 1.0) -> Optional[List[Point2D]]:
        ox, oy = roi_offset
        pos = getattr(result, "position", None)
        if pos is None:
            return None

        raw_points = []
        names = ["top_left", "top_right", "bottom_right", "bottom_left"]
        if all(hasattr(pos, name) for name in names):
            for name in names:
                raw_points.append(getattr(pos, name))
        elif hasattr(pos, "__iter__"):
            try:
                raw_points = list(pos)
            except Exception:
                raw_points = []

        points: List[Point2D] = []
        for p in raw_points:
            try:
                x = getattr(p, "x", None)
                y = getattr(p, "y", None)
                if x is None or y is None:
                    if isinstance(p, (tuple, list)) and len(p) >= 2:
                        x, y = p[0], p[1]
                if x is None or y is None:
                    continue
                px = int(round(float(x) / float(scale) + ox))
                py = int(round(float(y) / float(scale) + oy))
                points.append((px, py))
            except Exception:
                continue

        if len(points) >= 4:
            return points[:4]
        return None

    @staticmethod
    def center_from_points(points: Optional[List[Point2D]]) -> Optional[Point2D]:
        if not points:
            return None
        xs = [p[0] for p in points]
        ys = [p[1] for p in points]
        return int(round(sum(xs) / len(xs))), int(round(sum(ys) / len(ys)))

    def result_center_key(self, item: Dict) -> Tuple:
        text = item.get("text", "")
        pts = item.get("points", None)
        center = self.center_from_points(pts)
        if center is None:
            return (text, "no_points")
        u, v = center
        return (text, int(u / 20) * 20, int(v / 20) * 20)

    def decode_frame(self, frame: np.ndarray) -> List[Dict]:
        if not HAS_ZXING:
            return []

        roi, roi_box = self.crop_center_roi(frame)
        x1, y1, x2, y2 = roi_box
        all_items: List[Dict] = []

        for method, img, scale in self.make_candidates(roi):
            try:
                # Compatible with common zxing-cpp Python API.
                results = zxingcpp.read_barcodes(img)
            except Exception as e:
                self.get_logger().warn(f"ZXing decode error: {e}")
                continue

            for r in results:
                text = getattr(r, "text", "")
                fmt = str(getattr(r, "format", "UNKNOWN"))
                if not text:
                    continue
                if self.datamatrix_only and not self.is_datamatrix(fmt):
                    continue

                points = self.extract_points_from_zxing(r, roi_offset=(x1, y1), scale=scale)
                center = self.center_from_points(points)

                all_items.append({
                    "text": text,
                    "format": fmt,
                    "method": method,
                    "points": points,
                    "center_px": center,
                    "roi_box": [x1, y1, x2, y2],
                })

        if not self.deduplicate:
            return all_items

        unique: Dict[Tuple, Dict] = {}
        for item in all_items:
            key = self.result_center_key(item)
            if key not in unique:
                unique[key] = item
        return list(unique.values())

    # -------------------------------------------------------------------------
    # Depth and 3D projection
    # -------------------------------------------------------------------------
    def depth_raw_to_mm(self, raw_value) -> Optional[float]:
        try:
            z = float(raw_value)
        except Exception:
            return None

        if not math.isfinite(z) or z <= 0.0:
            return None

        enc = self.latest_depth_encoding.lower()
        unit = self.depth_unit

        if unit == "m":
            z_mm = z * 1000.0
        elif unit == "mm":
            z_mm = z
        else:
            if "32f" in enc or "64f" in enc:
                z_mm = z * 1000.0
            else:
                z_mm = z

        if not math.isfinite(z_mm):
            return None
        if z_mm < self.min_valid_depth_mm or z_mm > self.max_valid_depth_mm:
            return None
        return z_mm

    def resize_depth_if_needed(self, depth: np.ndarray, rgb_hw: Tuple[int, int]) -> np.ndarray:
        rgb_h, rgb_w = rgb_hw
        depth_h, depth_w = depth.shape[:2]
        if depth_h == rgb_h and depth_w == rgb_w:
            return depth
        if not self.allow_resize_depth_to_rgb:
            return depth

        self.get_logger().warn(
            f"Depth size {depth_w}x{depth_h} != RGB size {rgb_w}x{rgb_h}. "
            "Resizing depth for approximate lookup. Prefer aligned depth topic."
        )
        return cv2.resize(depth, (rgb_w, rgb_h), interpolation=cv2.INTER_NEAREST)

    def collect_valid_depths(self, depth: np.ndarray, u: int, v: int, radius: int) -> List[float]:
        h, w = depth.shape[:2]
        x1 = max(0, u - radius)
        y1 = max(0, v - radius)
        x2 = min(w, u + radius + 1)
        y2 = min(h, v + radius + 1)
        patch = depth[y1:y2, x1:x2]

        values: List[float] = []
        for raw in patch.reshape(-1):
            z_mm = self.depth_raw_to_mm(raw)
            if z_mm is not None:
                values.append(z_mm)
        return values

    def estimate_depth_mm(self, depth: np.ndarray, center: Optional[Point2D], points: Optional[List[Point2D]]) -> Optional[float]:
        if center is None:
            return None

        u, v = center
        h, w = depth.shape[:2]
        if u < 0 or u >= w or v < 0 or v >= h:
            return None

        values = self.collect_valid_depths(depth, u, v, max(0, self.depth_search_radius_px))
        if values:
            return float(np.median(np.array(values, dtype=np.float32)))

        if not self.bbox_depth_fallback or not points:
            return None

        xs = [p[0] for p in points]
        ys = [p[1] for p in points]
        x1 = max(0, min(xs))
        y1 = max(0, min(ys))
        x2 = min(w - 1, max(xs))
        y2 = min(h - 1, max(ys))

        if x2 <= x1 or y2 <= y1:
            return None

        patch = depth[y1:y2 + 1, x1:x2 + 1]
        values = []
        for raw in patch.reshape(-1):
            z_mm = self.depth_raw_to_mm(raw)
            if z_mm is not None:
                values.append(z_mm)
        if values:
            return float(np.median(np.array(values, dtype=np.float32)))
        return None

    def pixel_to_camera_xyz_mm(self, u: int, v: int, z_mm: float) -> Tuple[float, float, float]:
        assert self.fx is not None and self.fy is not None and self.cx is not None and self.cy is not None
        x_mm = (float(u) - self.cx) * z_mm / self.fx
        y_mm = (float(v) - self.cy) * z_mm / self.fy
        return float(x_mm), float(y_mm), float(z_mm)

    def attach_depth_and_xyz(self, results_2d: List[Dict], rgb_hw: Tuple[int, int], depth_raw: np.ndarray) -> List[Dict]:
        depth = self.resize_depth_if_needed(depth_raw, rgb_hw)
        out: List[Dict] = []

        for item in results_2d:
            center = item.get("center_px", None)
            points = item.get("points", None)

            z_mm = self.estimate_depth_mm(depth, center, points)
            xyz = None
            valid_3d = False

            if z_mm is not None and center is not None:
                u, v = center
                x_mm, y_mm, z_mm = self.pixel_to_camera_xyz_mm(u, v, z_mm)
                xyz = {
                    "x": x_mm,
                    "y": y_mm,
                    "z": z_mm,
                }
                valid_3d = True

            new_item = dict(item)
            new_item["depth_mm"] = z_mm
            new_item["camera_xyz_mm"] = xyz
            new_item["valid_3d"] = valid_3d
            new_item["camera_frame_id"] = self.camera_frame_id
            new_item["depth_frame_id"] = self.latest_depth_frame_id
            out.append(new_item)

        return out

    # -------------------------------------------------------------------------
    # Draw and publish
    # -------------------------------------------------------------------------
    def draw_results(self, frame: np.ndarray, results: List[Dict]) -> np.ndarray:
        out = frame.copy()

        roi_box = None
        if results:
            roi_box = results[0].get("roi_box", None)
        else:
            _, roi_box_tuple = self.crop_center_roi(frame)
            roi_box = list(roi_box_tuple)

        if roi_box:
            x1, y1, x2, y2 = [int(v) for v in roi_box]
            cv2.rectangle(out, (x1, y1), (x2, y2), (255, 255, 0), 2)

        if not results:
            cv2.putText(out, "DataMatrix: NOT DECODED", (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0, 0, 255), 2, cv2.LINE_AA)
            return out

        cv2.putText(out, f"DataMatrix count: {len(results)}", (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0, 255, 0), 2, cv2.LINE_AA)

        for idx, item in enumerate(results):
            text = item.get("text", "")
            points = item.get("points", None)
            center = item.get("center_px", None)
            xyz = item.get("camera_xyz_mm", None)
            valid_3d = bool(item.get("valid_3d", False))

            color = (0, 255, 0) if valid_3d else (0, 165, 255)

            if points is not None and len(points) >= 4:
                pts = np.array(points, dtype=np.int32).reshape((-1, 1, 2))
                cv2.polylines(out, [pts], True, color, 3)

            if center is not None:
                u, v = center
                cv2.circle(out, (int(u), int(v)), 5, color, -1)
                text_pos = (int(u) + 8, max(30, int(v) - 10))
            elif points:
                text_pos = (points[0][0], max(30, points[0][1] - 10))
            else:
                text_pos = (20, 80 + idx * 35)

            cv2.putText(out, f"{idx + 1}: {text}", text_pos, cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2, cv2.LINE_AA)

            if xyz is not None:
                xyz_text = f"X={xyz['x']:.0f} Y={xyz['y']:.0f} Z={xyz['z']:.0f} mm"
            else:
                xyz_text = "XYZ invalid"
            cv2.putText(out, xyz_text, (20, out.shape[0] - 30 - idx * 28), cv2.FONT_HERSHEY_SIMPLEX, 0.65, color, 2, cv2.LINE_AA)

        return out

    def publish_results(self, results: List[Dict], rgb_msg: Image) -> None:
        now = time.time()
        codes = [r.get("text", "") for r in results]
        signature = "|".join(sorted(codes))

        if signature == self.last_signature and now - self.last_publish_time < self.repeat_publish_interval:
            return

        if codes:
            first_msg = String()
            first_msg.data = codes[0]
            self.result_pub.publish(first_msg)

        items = []
        for r in results:
            center = r.get("center_px", None)
            points = r.get("points", None)
            items.append({
                "code": r.get("text", ""),
                "format": r.get("format", ""),
                "method": r.get("method", ""),
                "points_px": points,
                "center_px": center,
                "depth_mm": r.get("depth_mm", None),
                "camera_xyz_mm": r.get("camera_xyz_mm", None),
                "valid_3d": r.get("valid_3d", False),
            })

        payload = {
            "timestamp_unix": now,
            "rgb_stamp": {
                "sec": int(rgb_msg.header.stamp.sec),
                "nanosec": int(rgb_msg.header.stamp.nanosec),
            },
            "rgb_frame_id": rgb_msg.header.frame_id,
            "camera_frame_id": self.camera_frame_id,
            "depth_frame_id": self.latest_depth_frame_id,
            "intrinsics": {
                "fx": self.fx,
                "fy": self.fy,
                "cx": self.cx,
                "cy": self.cy,
            },
            "depth_unit_output": "mm",
            "count": len(results),
            "codes": codes,
            "items": items,
            "source_topics": {
                "rgb": self.rgb_topic,
                "depth": self.depth_topic,
                "camera_info": self.camera_info_topic,
            },
        }

        json_msg = String()
        json_msg.data = json.dumps(payload, ensure_ascii=False)
        self.result_json_pub.publish(json_msg)

        self.last_signature = signature
        self.last_publish_time = now
        self.get_logger().info(f"DataMatrix count={len(results)} codes={codes}")


def main(args=None) -> None:
    rclpy.init(args=args)
    node = OakParcelPoseNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            cv2.destroyAllWindows()
        except Exception:
            pass
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
