#!/usr/bin/env python3
import json
import math
from typing import Any, Dict, List, Optional, Tuple

import rclpy
from rclpy.node import Node
from rclpy.duration import Duration

from std_msgs.msg import String
from geometry_msgs.msg import Twist

from tf2_ros import Buffer, TransformListener


def normalize_angle(a: float) -> float:
    while a > math.pi:
        a -= 2.0 * math.pi
    while a < -math.pi:
        a += 2.0 * math.pi
    return a


def clamp(v: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, v))


def safe_float(v: Any, default: float = 0.0) -> float:
    try:
        return float(v)
    except Exception:
        return default


def parse_pickup_code(code: str) -> Tuple[str, str, str]:
    parts = str(code).strip().split("-")
    if len(parts) >= 3:
        return parts[0], parts[1], parts[2]
    if len(parts) == 2:
        return parts[0], parts[1], ""
    if len(parts) == 1:
        return parts[0], "", ""
    return "", "", ""


def get_nested(d: Dict[str, Any], path: List[str]) -> Optional[Any]:
    cur: Any = d
    for key in path:
        if not isinstance(cur, dict) or key not in cur:
            return None
        cur = cur[key]
    return cur


def extract_xy(data: Dict[str, Any]) -> Tuple[Optional[float], Optional[float]]:
    candidates = [
        ("shelf_x", "shelf_y"),
        ("target_x", "target_y"),
        ("map_x", "map_y"),
        ("x", "y"),
    ]

    for kx, ky in candidates:
        if kx in data and ky in data:
            return safe_float(data[kx]), safe_float(data[ky])

    nested_candidates = [
        (["pose", "position", "x"], ["pose", "position", "y"]),
        (["shelf_pose", "position", "x"], ["shelf_pose", "position", "y"]),
        (["position", "x"], ["position", "y"]),
        (["map_pose", "position", "x"], ["map_pose", "position", "y"]),
    ]

    for px, py in nested_candidates:
        x = get_nested(data, px)
        y = get_nested(data, py)
        if x is not None and y is not None:
            return safe_float(x), safe_float(y)

    return None, None


def extract_yaw(data: Dict[str, Any]) -> Optional[float]:
    for k in ["shelf_front_yaw", "shelf_front_yaw_rad", "yaw", "theta", "front_yaw"]:
        if k in data:
            return safe_float(data[k])

    nested_candidates = [
        ["pose", "yaw"],
        ["shelf_pose", "yaw"],
        ["map_pose", "yaw"],
    ]

    for path in nested_candidates:
        v = get_nested(data, path)
        if v is not None:
            return safe_float(v)

    return None


class OakPackageSearchNode(Node):
    IDLE = "IDLE"
    ALIGN_OAK_TO_SHELF_FRONT = "ALIGN_OAK_TO_SHELF_FRONT"
    MOVE_TO_SCAN_START = "MOVE_TO_SCAN_START"
    SWEEP_SEARCH_PACKAGE = "SWEEP_SEARCH_PACKAGE"

    def __init__(self):
        super().__init__("oak_package_search_node")

        # Topics
        self.declare_parameter("request_topic", "/target_detection/package_search/request")
        self.declare_parameter("status_topic", "/target_detection/package_search/status")
        self.declare_parameter("datamatrix_topic", "/oak/datamatrix_3d_result_json")
        self.declare_parameter("semantic_shelf_topic", "/semantic/current_shelf")
        self.declare_parameter("cmd_vel_topic", "/cmd_vel")

        # TF
        self.declare_parameter("fixed_frame", "map")
        self.declare_parameter("global_frame", "map")
        self.declare_parameter("base_frame", "base_link")
        self.declare_parameter("oak_camera_frame", "oak-cam-Link")

        # OAK local forward vector expressed in oak_camera_frame.
        # If OAK front is exactly +X of oak-cam-Link: 1,0,0.
        # If between +X and +Y: 0.707,0.707,0.
        self.declare_parameter("oak_forward_vector_x", 1.0)
        self.declare_parameter("oak_forward_vector_y", 0.0)
        self.declare_parameter("oak_forward_vector_z", 0.0)
        self.declare_parameter("oak_yaw_offset_deg", 0.0)

        # Target logic
        # point_or_front_yaw:
        #   use shelf point if available; otherwise use shelf_front_yaw + pi.
        self.declare_parameter("target_mode", "point_or_front_yaw")
        self.declare_parameter("use_semantic_shelf_topic", True)

        # If AprilTag/semantic position is at shelf center but you want to aim
        # slightly in front of shelf face, set this offset along shelf front normal.
        # Positive means target point moves toward shelf front normal direction.
        self.declare_parameter("shelf_target_offset_m", 0.0)

        # Motion enable
        self.declare_parameter("enable_motion", False)

        # Test mode
        self.declare_parameter("align_only", False)

        # Yaw control
        self.declare_parameter("yaw_control_sign", 1.0)
        self.declare_parameter("kp_wz", 0.45)
        self.declare_parameter("min_wz", 0.03)
        self.declare_parameter("max_wz", 0.10)
        
        # Search-stage coarse alignment guard.
        # This is for finding/scanning package codes, not final pickup alignment.
        # If OAK is already roughly parallel/facing the shelf, do not rotate again.
        self.declare_parameter("search_already_ok_deg", 8.0)
        self.declare_parameter("search_start_align_deg", 12.0)
        self.declare_parameter("same_shelf_skip_sec", 12.0)
        self.declare_parameter("search_align_only", True)
self.declare_parameter("align_yaw_tolerance_deg", 5.0)
        self.declare_parameter("scan_start_yaw_tolerance_deg", 5.0)
        self.declare_parameter("yaw_deadband_deg", 2.0)
        self.declare_parameter("yaw_settle_count_required", 3)
        self.declare_parameter("stop_publish_repeat", 5)

        # Scan
        self.declare_parameter("scan_range_deg", 25.0)
        self.declare_parameter("scan_speed_wz", 0.10)
        self.declare_parameter("scan_timeout_sec", 30.0)
        self.declare_parameter("max_scan_passes", 2)

        # Detection
        self.declare_parameter("match_only_in_scan", True)
        self.declare_parameter("ignore_detection_before_request", True)
        self.declare_parameter("min_confirm_matches", 2)
        self.declare_parameter("min_search_time_before_match_sec", 0.5)
        self.declare_parameter("datamatrix_fresh_timeout_sec", 1.2)

        # Runtime
        self.declare_parameter("tick_hz", 10.0)
        self.declare_parameter("tf_failure_timeout_sec", 8.0)

        self.request_topic = str(self.get_parameter("request_topic").value)
        self.status_topic = str(self.get_parameter("status_topic").value)
        self.datamatrix_topic = str(self.get_parameter("datamatrix_topic").value)
        self.semantic_shelf_topic = str(self.get_parameter("semantic_shelf_topic").value)
        self.cmd_vel_topic = str(self.get_parameter("cmd_vel_topic").value)

        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self)

        self.req_sub = self.create_subscription(String, self.request_topic, self.on_request, 10)
        self.dm_sub = self.create_subscription(String, self.datamatrix_topic, self.on_datamatrix, 10)
        self.semantic_sub = self.create_subscription(String, self.semantic_shelf_topic, self.on_semantic_shelf, 10)

        self.status_pub = self.create_publisher(String, self.status_topic, 10)
        self.cmd_pub = self.create_publisher(Twist, self.cmd_vel_topic, 10)

        self.state = self.IDLE
        self.state_start = self.now_sec()

        self.pickup_code = ""
        self.shelf_id = ""
        self.layer_id = ""
        self.package_code = ""

        self.request_stamp = 0.0
        self.request_data: Dict[str, Any] = {}

        # Target shelf info in map
        self.shelf_x: Optional[float] = None
        self.shelf_y: Optional[float] = None
        self.shelf_front_yaw: Optional[float] = None

        self.target_oak_yaw: Optional[float] = None
        self.scan_start_yaw: Optional[float] = None
        self.scan_end_yaw: Optional[float] = None

        self.scan_pass_count = 0
        self.match_confirm_count = 0

        self.last_semantic_shelf: Dict[str, Any] = {}
        self.last_semantic_stamp = 0.0

        self.last_datamatrix_stamp = 0.0
        self.last_datamatrix: Dict[str, Any] = {}
        self.last_codes: List[str] = []
        self.found_result: Any = None
        self.found_code = ""

        self._yaw_settle_count = 0
        self._last_cmd_wz = 0.0
        self._last_current_yaw: Optional[float] = None
        self._last_yaw_error: Optional[float] = None
        self._last_oak_x: Optional[float] = None
        self._last_oak_y: Optional[float] = None

        tick_hz = max(1.0, float(self.get_parameter("tick_hz").value))
        self.timer = self.create_timer(1.0 / tick_hz, self.on_timer)

        self.get_logger().info("oak_package_search_node started")
        self.get_logger().info(f"request_topic={self.request_topic}")
        self.get_logger().info(f"status_topic={self.status_topic}")
        self.get_logger().info(f"datamatrix_topic={self.datamatrix_topic}")
        self.get_logger().info(f"semantic_shelf_topic={self.semantic_shelf_topic}")
        self.get_logger().info(f"cmd_vel_topic={self.cmd_vel_topic}")
        self.get_logger().info(f"oak_camera_frame={self.get_parameter('oak_camera_frame').value}")
        self.get_logger().info("geometry target mode: OAK yaw target is computed from OAK map position to shelf map point when available")

    def now_sec(self) -> float:
        return self.get_clock().now().nanoseconds / 1e9

    def get_fixed_frame(self) -> str:
        fixed = str(self.get_parameter("fixed_frame").value)
        return fixed if fixed else str(self.get_parameter("global_frame").value)

    def publish_status(self, status: str, message: str = "", extra: Optional[Dict[str, Any]] = None) -> None:
        data: Dict[str, Any] = {
            "status": status,
            "state": self.state,
            "message": message,
            "pickup_code": self.pickup_code,
            "shelf_id": self.shelf_id,
            "layer_id": self.layer_id,
            "package_code": self.package_code,
            "stamp": self.now_sec(),
            "target_mode": str(self.get_parameter("target_mode").value),
            "oak_camera_frame": str(self.get_parameter("oak_camera_frame").value),
            "cmd_wz": self._last_cmd_wz,
        }

        if self.target_oak_yaw is not None:
            data["target_oak_yaw"] = self.target_oak_yaw
        if self._last_current_yaw is not None:
            data["current_oak_yaw"] = self._last_current_yaw
        if self._last_yaw_error is not None:
            data["yaw_error"] = self._last_yaw_error
        if self._last_oak_x is not None and self._last_oak_y is not None:
            data["oak_x"] = self._last_oak_x
            data["oak_y"] = self._last_oak_y
        if self.shelf_x is not None and self.shelf_y is not None:
            data["shelf_x"] = self.shelf_x
            data["shelf_y"] = self.shelf_y
        if self.shelf_front_yaw is not None:
            data["shelf_front_yaw"] = self.shelf_front_yaw

        if extra:
            data.update(extra)

        msg = String()
        msg.data = json.dumps(data, ensure_ascii=False)
        self.status_pub.publish(msg)

    def publish_wz(self, wz: float) -> None:
        self._last_cmd_wz = float(wz)
        if not bool(self.get_parameter("enable_motion").value):
            return
        msg = Twist()
        msg.angular.z = float(wz)
        self.cmd_pub.publish(msg)

    def publish_stop(self) -> None:
        self._last_cmd_wz = 0.0
        if not bool(self.get_parameter("enable_motion").value):
            return
        repeat = int(self.get_parameter("stop_publish_repeat").value)
        repeat = max(1, repeat)
        for _ in range(repeat):
            self.cmd_pub.publish(Twist())

    def set_state(self, new_state: str, reason: str) -> None:
        old = self.state
        self.state = new_state
        self.state_start = self.now_sec()
        self._yaw_settle_count = 0
        self.publish_stop()
        self.get_logger().info(f"state: {old} -> {new_state}, {reason}")
        self.publish_status(new_state.lower(), reason)

    def on_semantic_shelf(self, msg: String) -> None:
        try:
            data = json.loads(msg.data)
        except Exception:
            return

        self.last_semantic_shelf = data
        self.last_semantic_stamp = self.now_sec()

    def on_request(self, msg: String) -> None:
        try:
            req = json.loads(msg.data)
        except Exception as e:
            self.get_logger().warn(f"invalid package search request json: {e}, raw={msg.data}")
            return

        task_type = str(req.get("task_type", "package_search"))
        if task_type not in ["package_search", "oak_package_search", "find_package"]:
            self.get_logger().warn(f"ignore request with task_type={task_type}")
            return

        pickup_code = str(req.get("pickup_code", req.get("cell_id", ""))).strip()
        if not pickup_code:
            self.get_logger().warn(f"ignore package search request without pickup_code: {req}")
            return

        self.request_data = req
        self.pickup_code = pickup_code
        self.shelf_id = str(req.get("shelf_id", ""))
        self.layer_id = str(req.get("layer_id", ""))
        self.package_code = str(req.get("package_code", ""))

        parsed_shelf, parsed_layer, parsed_pkg = parse_pickup_code(pickup_code)
        if not self.shelf_id:
            self.shelf_id = parsed_shelf
        if not self.layer_id:
            self.layer_id = parsed_layer
        if not self.package_code:
            self.package_code = parsed_pkg

        self.request_stamp = self.now_sec()
        self.match_confirm_count = 0
        self.scan_pass_count = 0
        self.found_result = None
        self.found_code = ""
        self._yaw_settle_count = 0

        self.update_target_from_request_or_semantic(req)

        self.scan_start_yaw = None
        self.scan_end_yaw = None

        self.target_oak_yaw = self.compute_target_oak_yaw_dynamic()

        self.publish_status(
            "accepted",
            "new package search request",
            {
                "request": req,
                "target_oak_yaw": self.target_oak_yaw,
            },
        )

        self.set_state(self.ALIGN_OAK_TO_SHELF_FRONT, "new package search request")

    def update_target_from_request_or_semantic(self, req: Dict[str, Any]) -> None:
        x, y = extract_xy(req)
        yaw = extract_yaw(req)

        # If request has no point/yaw, use latest semantic shelf.
        if bool(self.get_parameter("use_semantic_shelf_topic").value):
            sem = self.last_semantic_shelf
            if isinstance(sem, dict):
                # If shelf_id exists in semantic, prefer matching shelf.
                sem_shelf_id = str(sem.get("shelf_id", sem.get("id", "")))
                allow_sem = (not self.shelf_id) or (not sem_shelf_id) or (sem_shelf_id == self.shelf_id)

                if allow_sem:
                    sx, sy = extract_xy(sem)
                    syaw = extract_yaw(sem)
                    if x is None and y is None and sx is not None and sy is not None:
                        x, y = sx, sy
                    if yaw is None and syaw is not None:
                        yaw = syaw

        if x is not None and y is not None:
            # Optional offset along shelf front normal.
            offset = float(self.get_parameter("shelf_target_offset_m").value)
            if yaw is not None and abs(offset) > 1e-6:
                x = x + offset * math.cos(yaw)
                y = y + offset * math.sin(yaw)

            self.shelf_x = x
            self.shelf_y = y

        if yaw is not None:
            self.shelf_front_yaw = normalize_angle(yaw)

    def on_datamatrix(self, msg: String) -> None:
        try:
            data = json.loads(msg.data)
        except Exception:
            return

        self.last_datamatrix = data
        self.last_datamatrix_stamp = self.now_sec()
        self.last_codes = self.extract_codes(data)

    def extract_codes(self, data: Dict[str, Any]) -> List[str]:
        codes: List[str] = []

        raw_codes = data.get("codes", [])
        if isinstance(raw_codes, list):
            for c in raw_codes:
                if c is not None:
                    codes.append(str(c))

        for key in ["detections", "results", "items"]:
            arr = data.get(key, [])
            if isinstance(arr, list):
                for item in arr:
                    if isinstance(item, dict):
                        for ck in ["code", "data", "text", "value", "raw"]:
                            if ck in item and item[ck] is not None:
                                codes.append(str(item[ck]))
                                break
                    elif item is not None:
                        codes.append(str(item))

        seen = set()
        out = []
        for c in codes:
            if c not in seen:
                seen.add(c)
                out.append(c)
        return out

    def get_oak_pose_and_yaw_from_tf(self) -> Tuple[bool, Optional[float], Optional[float], Optional[float], Optional[str]]:
        fixed_frame = self.get_fixed_frame()
        oak_frame = str(self.get_parameter("oak_camera_frame").value)

        vx_local = float(self.get_parameter("oak_forward_vector_x").value)
        vy_local = float(self.get_parameter("oak_forward_vector_y").value)
        vz_local = float(self.get_parameter("oak_forward_vector_z").value)
        yaw_offset = math.radians(float(self.get_parameter("oak_yaw_offset_deg").value))

        norm = math.sqrt(vx_local * vx_local + vy_local * vy_local + vz_local * vz_local)
        if norm < 1e-6:
            return False, None, None, None, "oak_forward_vector is zero"

        vx_local /= norm
        vy_local /= norm
        vz_local /= norm

        try:
            tf_cam = self.tf_buffer.lookup_transform(
                fixed_frame,
                oak_frame,
                rclpy.time.Time(),
                timeout=Duration(seconds=0.5),
            )
        except Exception as e:
            return False, None, None, None, f"tf error: {e}"

        tx = tf_cam.transform.translation.x
        ty = tf_cam.transform.translation.y

        q = tf_cam.transform.rotation
        x, y, z, w = q.x, q.y, q.z, q.w

        # Rotation matrix R_map_oak.
        r00 = 1.0 - 2.0 * (y * y + z * z)
        r01 = 2.0 * (x * y - w * z)
        r02 = 2.0 * (x * z + w * y)

        r10 = 2.0 * (x * y + w * z)
        r11 = 1.0 - 2.0 * (x * x + z * z)
        r12 = 2.0 * (y * z - w * x)

        vx_map = r00 * vx_local + r01 * vy_local + r02 * vz_local
        vy_map = r10 * vx_local + r11 * vy_local + r12 * vz_local

        if abs(vx_map) < 1e-6 and abs(vy_map) < 1e-6:
            return False, None, None, None, "oak_forward_vector has near-zero projection on map XY plane"

        current_yaw = normalize_angle(math.atan2(vy_map, vx_map) + yaw_offset)

        self._last_oak_x = tx
        self._last_oak_y = ty

        return True, tx, ty, current_yaw, None

    def compute_target_oak_yaw_dynamic(self) -> Optional[float]:
        # Explicit direct target overrides everything.
        req = self.request_data
        if "target_oak_yaw" in req:
            return normalize_angle(safe_float(req["target_oak_yaw"], 0.0))
        if "target_oak_yaw_rad" in req:
            return normalize_angle(safe_float(req["target_oak_yaw_rad"], 0.0))

        ok, oak_x, oak_y, _, _ = self.get_oak_pose_and_yaw_from_tf()

        mode = str(self.get_parameter("target_mode").value)

        # Main correct mode: use target point from shelf pose.
        if mode in ["point", "point_or_front_yaw", "auto"] and ok and oak_x is not None and oak_y is not None:
            if self.shelf_x is not None and self.shelf_y is not None:
                dx = self.shelf_x - oak_x
                dy = self.shelf_y - oak_y
                if abs(dx) > 1e-6 or abs(dy) > 1e-6:
                    return normalize_angle(math.atan2(dy, dx))

        # Fallback: shelf front normal opposite direction.
        if mode in ["front_yaw", "point_or_front_yaw", "auto"]:
            if self.shelf_front_yaw is not None:
                return normalize_angle(self.shelf_front_yaw + math.pi)

        # Fallback from request fields.
        if "shelf_front_yaw" in req:
            return normalize_angle(safe_float(req["shelf_front_yaw"], 0.0) + math.pi)
        if "shelf_front_yaw_rad" in req:
            return normalize_angle(safe_float(req["shelf_front_yaw_rad"], 0.0) + math.pi)
        if "approach_yaw" in req:
            return normalize_angle(safe_float(req["approach_yaw"], 0.0))

        return None

    def yaw_control_to_target(self, tolerance_deg: float) -> Tuple[bool, Optional[str], Optional[float], Optional[float], Optional[float]]:
        ok, _, _, current_yaw, err_msg = self.get_oak_pose_and_yaw_from_tf()
        if not ok or current_yaw is None:
            self.publish_stop()
            return False, err_msg, None, None, None

        target_yaw = self.compute_target_oak_yaw_dynamic()
        if target_yaw is None:
            self.publish_stop()
            return False, "target_oak_yaw is None; no shelf point or shelf_front_yaw", current_yaw, None, None

        self.target_oak_yaw = target_yaw

        yaw_error = normalize_angle(target_yaw - current_yaw)

        self._last_current_yaw = current_yaw
        self._last_yaw_error = yaw_error

        tol = math.radians(float(tolerance_deg))
        deadband = math.radians(float(self.get_parameter("yaw_deadband_deg").value))
        stop_zone = max(tol, deadband)

        if abs(yaw_error) <= stop_zone:
            self._yaw_settle_count += 1
            self.publish_stop()

            required = int(self.get_parameter("yaw_settle_count_required").value)
            required = max(1, required)

            if self._yaw_settle_count >= required:
                return True, None, current_yaw, yaw_error, target_yaw

            return False, None, current_yaw, yaw_error, target_yaw

        self._yaw_settle_count = 0

        kp = float(self.get_parameter("kp_wz").value)
        min_wz = abs(float(self.get_parameter("min_wz").value))
        max_wz = abs(float(self.get_parameter("max_wz").value))
        control_sign = float(self.get_parameter("yaw_control_sign").value)

        wz = control_sign * kp * yaw_error
        wz = clamp(wz, -max_wz, max_wz)

        if min_wz > 0.0 and abs(wz) < min_wz:
            sign_source = wz if abs(wz) > 1e-6 else control_sign * yaw_error
            wz = math.copysign(min_wz, sign_source)

        self.publish_wz(wz)
        return False, None, current_yaw, yaw_error, target_yaw

    def prepare_scan(self) -> None:
        target_yaw = self.compute_target_oak_yaw_dynamic()
        if target_yaw is None:
            target_yaw = self.target_oak_yaw
        if target_yaw is None:
            return

        self.target_oak_yaw = target_yaw
        scan_range = math.radians(float(self.get_parameter("scan_range_deg").value))
        self.scan_start_yaw = normalize_angle(target_yaw - scan_range)
        self.scan_end_yaw = normalize_angle(target_yaw + scan_range)
        self.scan_pass_count = 0
        self._yaw_settle_count = 0

    def detection_matches(self) -> bool:
        if not self.pickup_code:
            return False

        now = self.now_sec()

        fresh_timeout = float(self.get_parameter("datamatrix_fresh_timeout_sec").value)
        if self.last_datamatrix_stamp <= 0.0 or now - self.last_datamatrix_stamp > fresh_timeout:
            self.match_confirm_count = 0
            return False

        if bool(self.get_parameter("ignore_detection_before_request").value):
            if self.last_datamatrix_stamp < self.request_stamp:
                self.match_confirm_count = 0
                return False

        if bool(self.get_parameter("match_only_in_scan").value):
            if self.state != self.SWEEP_SEARCH_PACKAGE:
                self.match_confirm_count = 0
                return False

        min_search_time = float(self.get_parameter("min_search_time_before_match_sec").value)
        if now - self.state_start < min_search_time:
            self.match_confirm_count = 0
            return False

        matched = self.pickup_code in self.last_codes

        if matched:
            self.match_confirm_count += 1
        else:
            self.match_confirm_count = 0

        required = int(self.get_parameter("min_confirm_matches").value)
        required = max(1, required)

        if self.match_confirm_count >= required:
            self.found_code = self.pickup_code
            self.found_result = self.last_datamatrix
            return True

        return False

    def finish_failed(self, reason: str) -> None:
        self.publish_stop()
        self.publish_status("failed", reason)
        self.get_logger().warn(f"package search failed: {reason}")
        self.state = self.IDLE
        self.state_start = self.now_sec()

    def finish_found(self) -> None:
        self.publish_stop()
        self.publish_status(
            "found",
            f"target package found: {self.pickup_code}",
            {
                "found_code": self.found_code,
                "datamatrix": self.found_result,
            },
        )
        self.get_logger().info(f"target package found: {self.pickup_code}")
        self.state = self.IDLE
        self.state_start = self.now_sec()

    def on_timer(self) -> None:
        if self.state == self.IDLE:
            return

        now = self.now_sec()
        tf_timeout = float(self.get_parameter("tf_failure_timeout_sec").value)

        if self.state == self.ALIGN_OAK_TO_SHELF_FRONT:
            aligned, err_msg, current_yaw, yaw_error, target_yaw = self.yaw_control_to_target(
                float(self.get_parameter("align_yaw_tolerance_deg").value)
            )

            self.publish_status(
                "aligning",
                "aligning OAK to shelf target point or shelf front",
                {
                    "target_oak_yaw": target_yaw,
                    "current_oak_yaw": current_yaw,
                    "yaw_error": yaw_error,
                    "target_mode": str(self.get_parameter("target_mode").value),
                    "oak_forward_vector": [
                        float(self.get_parameter("oak_forward_vector_x").value),
                        float(self.get_parameter("oak_forward_vector_y").value),
                        float(self.get_parameter("oak_forward_vector_z").value),
                    ],
                },
            )

            if err_msg is not None and now - self.state_start > tf_timeout:
                self.finish_failed(err_msg)
                return

            if aligned:
                if bool(self.get_parameter("align_only").value):
                    self.publish_stop()
                    self.publish_status(
                        "aligned",
                        "OAK aligned; align_only=true, scan disabled",
                        {
                            "target_oak_yaw": target_yaw,
                            "current_oak_yaw": current_yaw,
                            "yaw_error": yaw_error,
                        },
                    )
                    self.get_logger().info("OAK aligned; align_only=true, stop before scan")
                    self.state = self.IDLE
                    self.state_start = self.now_sec()
                    return

                self.prepare_scan()
                self.set_state(self.MOVE_TO_SCAN_START, "OAK aligned to target")

            return

        if self.state == self.MOVE_TO_SCAN_START:
            if self.scan_start_yaw is None:
                self.finish_failed("scan_start_yaw is None")
                return

            # For scan start, use fixed scan_start_yaw instead of dynamic shelf target.
            saved_target = self.target_oak_yaw
            self.target_oak_yaw = self.scan_start_yaw
            aligned, err_msg, current_yaw, yaw_error, target_yaw = self.yaw_control_to_specific_yaw(
                self.scan_start_yaw,
                float(self.get_parameter("scan_start_yaw_tolerance_deg").value),
            )
            self.target_oak_yaw = saved_target

            self.publish_status(
                "move_to_scan_start",
                "moving OAK to scan start yaw",
                {
                    "target_oak_yaw": self.scan_start_yaw,
                    "current_oak_yaw": current_yaw,
                    "yaw_error": yaw_error,
                },
            )

            if err_msg is not None and now - self.state_start > tf_timeout:
                self.finish_failed(err_msg)
                return

            if aligned:
                self.set_state(self.SWEEP_SEARCH_PACKAGE, "OAK reached scan start yaw")

            return

        if self.state == self.SWEEP_SEARCH_PACKAGE:
            if self.detection_matches():
                self.finish_found()
                return

            if now - self.state_start > float(self.get_parameter("scan_timeout_sec").value):
                self.finish_failed("scan timeout")
                return

            if self.scan_end_yaw is None:
                self.finish_failed("scan_end_yaw is None")
                return

            ok, _, _, current_yaw, err_msg = self.get_oak_pose_and_yaw_from_tf()
            if not ok or current_yaw is None:
                self.publish_stop()
                self.publish_status("scanning", err_msg or "tf error")
                return

            self._last_current_yaw = current_yaw

            end_error = normalize_angle(self.scan_end_yaw - current_yaw)
            self._last_yaw_error = end_error

            scan_speed = abs(float(self.get_parameter("scan_speed_wz").value))
            control_sign = float(self.get_parameter("yaw_control_sign").value)

            if abs(end_error) < math.radians(3.0):
                self.scan_pass_count += 1

                max_passes = int(self.get_parameter("max_scan_passes").value)
                max_passes = max(1, max_passes)

                if self.scan_pass_count >= max_passes:
                    self.finish_failed("target package not found after scan passes")
                    return

                self.scan_start_yaw, self.scan_end_yaw = self.scan_end_yaw, self.scan_start_yaw
                self.get_logger().info(
                    f"state: {self.SWEEP_SEARCH_PACKAGE} -> {self.SWEEP_SEARCH_PACKAGE}, "
                    f"reverse scan pass {self.scan_pass_count + 1}"
                )

            wz = control_sign * math.copysign(scan_speed, end_error)
            self.publish_wz(wz)

            self.publish_status(
                "scanning",
                "sweeping OAK to search package",
                {
                    "target_oak_yaw": self.target_oak_yaw,
                    "current_oak_yaw": current_yaw,
                    "yaw_error": end_error,
                    "scan_pass_count": self.scan_pass_count,
                    "last_codes": self.last_codes,
                },
            )

    def yaw_control_to_specific_yaw(
        self,
        target_yaw: float,
        tolerance_deg: float,
    ) -> Tuple[bool, Optional[str], Optional[float], Optional[float], Optional[float]]:
        ok, _, _, current_yaw, err_msg = self.get_oak_pose_and_yaw_from_tf()
        if not ok or current_yaw is None:
            self.publish_stop()
            return False, err_msg, None, None, target_yaw

        yaw_error = normalize_angle(target_yaw - current_yaw)
        self._last_current_yaw = current_yaw
        self._last_yaw_error = yaw_error

        tol = math.radians(float(tolerance_deg))
        deadband = math.radians(float(self.get_parameter("yaw_deadband_deg").value))
        stop_zone = max(tol, deadband)

        if abs(yaw_error) <= stop_zone:
            self._yaw_settle_count += 1
            self.publish_stop()
            required = int(self.get_parameter("yaw_settle_count_required").value)
            if self._yaw_settle_count >= max(1, required):
                return True, None, current_yaw, yaw_error, target_yaw
            return False, None, current_yaw, yaw_error, target_yaw

        self._yaw_settle_count = 0

        kp = float(self.get_parameter("kp_wz").value)
        min_wz = abs(float(self.get_parameter("min_wz").value))
        max_wz = abs(float(self.get_parameter("max_wz").value))
        control_sign = float(self.get_parameter("yaw_control_sign").value)

        wz = control_sign * kp * yaw_error
        wz = clamp(wz, -max_wz, max_wz)

        if min_wz > 0.0 and abs(wz) < min_wz:
            sign_source = wz if abs(wz) > 1e-6 else control_sign * yaw_error
            wz = math.copysign(min_wz, sign_source)

        self.publish_wz(wz)
        return False, None, current_yaw, yaw_error, target_yaw




# --- OAK SEARCH REENTRY GUARD MONKEY PATCH START ---
# This patch turns package-search alignment into a coarse conditional behavior.
# It prevents repeated small rotations when OAK is already good enough for scanning.

def _oak_search_guard_get_float(node, name, default):
    try:
        return float(node.get_parameter(name).value)
    except Exception:
        return float(default)

def _oak_search_guard_get_bool(node, name, default):
    try:
        return bool(node.get_parameter(name).value)
    except Exception:
        return bool(default)

def _oak_search_guard_declare_missing(node, name, default):
    try:
        node.get_parameter(name)
    except Exception:
        try:
            node.declare_parameter(name, default)
        except Exception:
            pass

def _oak_search_guard_now(node):
    try:
        return float(node.now_sec())
    except Exception:
        try:
            return float(node.get_clock().now().nanoseconds) / 1e9
        except Exception:
            import time as _time
            return _time.time()

def _oak_search_guard_key(node):
    shelf = str(getattr(node, "shelf_id", "") or "")
    layer = str(getattr(node, "layer_id", "") or "")
    pickup = str(getattr(node, "pickup_code", "") or "")
    if shelf or layer:
        return f"{shelf}:{layer}"
    return pickup

def _oak_search_guard_remember(node):
    key = _oak_search_guard_key(node)
    if key:
        node.last_aligned_key = key
        node.last_aligned_time = _oak_search_guard_now(node)

def _oak_search_guard_maybe_skip(node):
    now = _oak_search_guard_now(node)
    key = _oak_search_guard_key(node)

    last_key = str(getattr(node, "last_aligned_key", "") or "")
    last_time = float(getattr(node, "last_aligned_time", 0.0) or 0.0)
    cooldown = _oak_search_guard_get_float(node, "same_shelf_skip_sec", 12.0)

    if key and key == last_key and 0.0 <= now - last_time <= cooldown:
        return True, "same shelf/layer aligned recently; skip repeated search align", {
            "key": key,
            "age_sec": now - last_time,
            "same_shelf_skip_sec": cooldown,
        }

    target_yaw = getattr(node, "target_oak_yaw", None)
    if target_yaw is None:
        return False, "", {}

    if not hasattr(node, "get_oak_yaw_from_tf"):
        return False, "", {}

    ok, current_yaw, err_msg = node.get_oak_yaw_from_tf()
    if not ok:
        return False, "", {"tf_error": str(err_msg)}

    yaw_error = normalize_angle(float(target_yaw) - float(current_yaw))
    yaw_error_deg = abs(math.degrees(yaw_error))

    already_ok = _oak_search_guard_get_float(node, "search_already_ok_deg", 8.0)
    start_align = _oak_search_guard_get_float(node, "search_start_align_deg", 12.0)

    if yaw_error_deg <= already_ok:
        return True, "OAK already good enough for package search; skip align", {
            "current_oak_yaw": current_yaw,
            "target_oak_yaw": target_yaw,
            "yaw_error": yaw_error,
            "yaw_error_deg": yaw_error_deg,
            "search_already_ok_deg": already_ok,
        }

    if yaw_error_deg < start_align:
        return True, "OAK yaw error is inside search deadband; skip small correction", {
            "current_oak_yaw": current_yaw,
            "target_oak_yaw": target_yaw,
            "yaw_error": yaw_error,
            "yaw_error_deg": yaw_error_deg,
            "search_start_align_deg": start_align,
        }

    return False, "", {
        "current_oak_yaw": current_yaw,
        "target_oak_yaw": target_yaw,
        "yaw_error": yaw_error,
        "yaw_error_deg": yaw_error_deg,
        "search_start_align_deg": start_align,
    }

def _oak_search_guard_publish_skip(node, reason, extra=None):
    try:
        node.publish_stop()
    except Exception:
        pass

    _oak_search_guard_remember(node)

    data = {
        "skip_align": True,
        "reason": reason,
        "last_aligned_key": str(getattr(node, "last_aligned_key", "")),
    }
    if isinstance(extra, dict):
        data.update(extra)

    try:
        node.publish_status("aligned", reason, data)
    except Exception as e:
        try:
            node.get_logger().warn(f"publish aligned skip failed: {e}")
        except Exception:
            pass

    try:
        _oak_search_guard_original_set_state(node, node.IDLE, reason)
    except Exception:
        try:
            node.state = node.IDLE
        except Exception:
            pass

    try:
        node.get_logger().info(f"search alignment skipped: {reason}, data={data}")
    except Exception:
        pass

_oak_search_guard_original_init = OakPackageSearchNode.__init__
_oak_search_guard_original_set_state = OakPackageSearchNode.set_state
_oak_search_guard_original_publish_status = OakPackageSearchNode.publish_status

def _oak_search_guard_init(self, *args, **kwargs):
    _oak_search_guard_original_init(self, *args, **kwargs)

    _oak_search_guard_declare_missing(self, "search_already_ok_deg", 8.0)
    _oak_search_guard_declare_missing(self, "search_start_align_deg", 12.0)
    _oak_search_guard_declare_missing(self, "same_shelf_skip_sec", 12.0)
    _oak_search_guard_declare_missing(self, "search_align_only", True)

    if not hasattr(self, "last_aligned_key"):
        self.last_aligned_key = ""
    if not hasattr(self, "last_aligned_time"):
        self.last_aligned_time = 0.0

    try:
        self.get_logger().info(
            "OAK search guard enabled: "
            f"already_ok={self.get_parameter('search_already_ok_deg').value}, "
            f"start_align={self.get_parameter('search_start_align_deg').value}, "
            f"same_shelf_skip={self.get_parameter('same_shelf_skip_sec').value}, "
            f"search_align_only={self.get_parameter('search_align_only').value}, "
            f"max_wz={self.get_parameter('max_wz').value}"
        )
    except Exception:
        pass

def _oak_search_guard_publish_status(self, status, message, extra=None):
    if str(status) == "aligned":
        try:
            _oak_search_guard_remember(self)
        except Exception:
            pass
    return _oak_search_guard_original_publish_status(self, status, message, extra)

def _oak_search_guard_set_state(self, state, reason):
    # Intercept entering ALIGN. At this point original request callback should already
    # have computed target_oak_yaw, shelf_id, layer_id, etc.
    try:
        if state == self.ALIGN:
            skip, skip_reason, skip_extra = _oak_search_guard_maybe_skip(self)
            if skip:
                _oak_search_guard_publish_skip(self, skip_reason, skip_extra)
                return
    except Exception as e:
        try:
            self.get_logger().warn(f"OAK search guard check failed, continue normal align: {e}")
        except Exception:
            pass

    return _oak_search_guard_original_set_state(self, state, reason)

OakPackageSearchNode.__init__ = _oak_search_guard_init
OakPackageSearchNode.set_state = _oak_search_guard_set_state
OakPackageSearchNode.publish_status = _oak_search_guard_publish_status

# --- OAK SEARCH REENTRY GUARD MONKEY PATCH END ---

def main(args=None):
    rclpy.init(args=args)
    node = OakPackageSearchNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            node.publish_stop()
            node.destroy_node()
        except Exception:
            pass
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
