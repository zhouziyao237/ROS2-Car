oak_package_search_node:
  ros__parameters:
    # Topics
    request_topic: /target_detection/package_search/request
    status_topic: /target_detection/package_search/status
    datamatrix_topic: /oak/datamatrix_3d_result_json
    cmd_vel_topic: /cmd_vel

    # TF frames. fixed_frame must connect to oak_camera_link and oak_camera_forward_link.
    fixed_frame: map
    oak_camera_frame: oak_camera_link
    oak_forward_frame: oak_camera_forward_link

    # Safety: false means dry-run. It will not publish cmd_vel.
    enable_motion: false

    # In dry-run testing, allow the state machine to proceed without map->oak TF.
    # For real robot motion, keep require_tf_for_alignment=true and enable_motion=true.
    allow_no_tf_in_dry_run: true
    require_tf_for_alignment: true
    tf_failure_timeout_sec: 8.0

    # Alignment controller.
    align_yaw_tolerance_deg: 3.0
    scan_start_yaw_tolerance_deg: 3.0
    kp_wz: 1.0
    min_wz: 0.06
    max_wz: 0.30

    # Sweep scan.
    scan_range_deg: 25.0
    scan_speed_wz: 0.10
    scan_timeout_sec: 25.0
    max_scan_passes: 2

    # DataMatrix matching.
    # True = only accept target code during SWEEP_SEARCH_PACKAGE.
    match_only_in_scan: true
    ignore_detection_before_request: true
    min_search_time_before_match_sec: 0.5
    min_confirm_matches: 2
    datamatrix_fresh_timeout_sec: 1.2

    # Loop rate.
    tick_hz: 20.0
