<?xml version="1.0"?>
<package format="3">
  <name>oak_vision_driver</name>
  <version>0.0.2</version>
  <description>OAK-D Lite ROS2 driver using DepthAI SDK with RGB, aligned depth, camera info and optional YOLO blob output compatible with yolov5_node detections.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>yolo_msg</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
