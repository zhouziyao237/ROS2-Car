oak_package_servo_node:
  ros__parameters:
    request_topic: /target_detection/package_servo/request
    status_topic: /target_detection/package_servo/status
    datamatrix_topic: /oak/datamatrix_3d_result_json

    # IMPORTANT: same upstream motion definition as Nav2. Do not publish /cmd_vel_selected here.
    cmd_vel_topic: /cmd_vel_auto

    scan_topic: /scan
    map_topic: /map
    semantic_shelf_topic: /semantic/current_shelf

    base_frame: base_link
    oak_frame: oak-cam-Link
    map_frame: map

    # Target distance: package should remain this far in front of OAK during pickup approach.
    standoff_m: 0.55
    min_standoff_m: 0.40
    fine_standoff_m: 0.55

    # Controller gains in standard ROS/base_link Twist space after URDF rotation.
    kx: 0.20
    ky: 0.20
    kyaw: 0.50

    max_vx: 0.02
    max_vy: 0.02
    max_wz: 0.035

    x_tolerance_m: 0.035
    y_tolerance_m: 0.025
    fine_y_tolerance_m: 0.018
    yaw_tolerance_rad: 0.05

    target_lock_min_frames: 3
    target_lost_timeout_sec: 0.35
    center_no_timeout_when_target_visible: true
    center_no_progress_timeout_sec: 25.0
    center_progress_min_delta_m: 0.015
    center_max_runtime_sec: 120.0
    filter_alpha: 0.70
    control_hz: 10.0
    default_timeout_sec: 45.0
    fine_timeout_sec: 30.0
    stop_publish_repeat: 3
    enable_motion: true
    debug_log_period_sec: 0.3

    # Safety limits. These crop the raw OAK+URDF command before publishing.
    oak_hard_stop_m: 0.38
    shelf_hard_stop_distance_m: 0.35
    front_stop_m: 0.30
    side_stop_m: 0.20
    enable_scan_guard: true
    enable_map_guard: false
    map_occupied_threshold: 65
    predict_time_sec: 0.6
    footprint_radius_m: 0.25
    max_target_msg_age_sec: 0.35
    min_servo_timeout_sec: 45.0
