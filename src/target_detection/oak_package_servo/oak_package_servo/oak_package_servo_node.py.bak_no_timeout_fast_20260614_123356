# -*- coding: utf-8 -*-
"""OAK package visual servo controller.

Main idea:
  OAK camera_xyz_mm -> P_oak = [z, -x, -y]
  E_oak -> R_base_oak * E_oak -> standard ROS/Nav2 Twist

This node does not publish TF and does not apply chassis swap/invert rules.
It publishes standard ROS Twist to /cmd_vel_auto by default; robot2's
cmd_vel_mode_mux handles the physical chassis mapping.
"""

import json
import math
import time
from dataclasses import dataclass
from typing import Any, Dict, Iterable, List, Optional, Tuple

import rclpy
from rclpy.duration import Duration
from rclpy.node import Node
from rclpy.time import Time
from std_msgs.msg import String
from geometry_msgs.msg import Twist
from sensor_msgs.msg import LaserScan
from nav_msgs.msg import OccupancyGrid
from tf2_ros import Buffer, TransformListener


def clamp(v: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, v))


def norm_angle(a: float) -> float:
    return math.atan2(math.sin(a), math.cos(a))


def quat_to_mat(q) -> List[List[float]]:
    x, y, z, w = float(q.x), float(q.y), float(q.z), float(q.w)
    xx, yy, zz = x * x, y * y, z * z
    xy, xz, yz = x * y, x * z, y * z
    wx, wy, wz = w * x, w * y, w * z
    return [
        [1.0 - 2.0 * (yy + zz), 2.0 * (xy - wz), 2.0 * (xz + wy)],
        [2.0 * (xy + wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz - wx)],
        [2.0 * (xz - wy), 2.0 * (yz + wx), 1.0 - 2.0 * (xx + yy)],
    ]


def mat_vec(m: List[List[float]], v: Tuple[float, float, float]) -> Tuple[float, float, float]:
    return (
        m[0][0] * v[0] + m[0][1] * v[1] + m[0][2] * v[2],
        m[1][0] * v[0] + m[1][1] * v[1] + m[1][2] * v[2],
        m[2][0] * v[0] + m[2][1] * v[1] + m[2][2] * v[2],
    )


def mat_t_vec(m: List[List[float]], v: Tuple[float, float, float]) -> Tuple[float, float, float]:
    return (
        m[0][0] * v[0] + m[1][0] * v[1] + m[2][0] * v[2],
        m[0][1] * v[0] + m[1][1] * v[1] + m[2][1] * v[2],
        m[0][2] * v[0] + m[1][2] * v[1] + m[2][2] * v[2],
    )


def parse_xyz_mm(value: Any) -> Optional[Tuple[float, float, float]]:
    if value is None:
        return None
    if isinstance(value, dict):
        if all(k in value for k in ('x', 'y', 'z')):
            return float(value['x']), float(value['y']), float(value['z'])
        return None
    if isinstance(value, (list, tuple)) and len(value) >= 3:
        return float(value[0]), float(value[1]), float(value[2])
    return None


def iter_detection_items(payload: Dict[str, Any]) -> Iterable[Dict[str, Any]]:
    if isinstance(payload.get('items'), list):
        for item in payload['items']:
            if isinstance(item, dict):
                yield item
    if isinstance(payload.get('results'), list):
        for item in payload['results']:
            if isinstance(item, dict):
                yield item


def code_matches(request_code: str, detected_code: str) -> bool:
    """Accept both short package code and full pickup code.

    Example:
      request_code='0311' should match detected_code='S03-L2-0311'.
      request_code='S03-L2-0311' should also match detected_code='S03-L2-0311'.
    """
    req = str(request_code or '').strip()
    det = str(detected_code or '').strip()
    if not req:
        return True
    if not det:
        return False
    if det == req:
        return True
    if det.endswith('-' + req):
        return True
    if req.endswith('-' + det):
        return True
    # Last fallback: split by '-' and compare the final code field.
    if '-' in det and det.split('-')[-1] == req:
        return True
    if '-' in req and req.split('-')[-1] == det:
        return True
    return False


def strict_target_code_matches(target_code: str, detected_code: str) -> bool:
    """Strict target lock.

    If target_code is full, for example S03-L2-0311, only exact match is accepted.
    If target_code is short, for example 0311, only suffix -0311 is accepted.
    This prevents selecting S03-L1-0310 / S03-L2-0312 when the target is S03-L2-0311.
    """
    target = str(target_code or '').strip()
    det = str(detected_code or '').strip()
    if not target or not det:
        return False

    if '-' in target:
        return det == target

    return det == target or det.endswith('-' + target)


def extract_item_center_px(item):
    for key in ('center_px', 'center_pixel', 'center', 'bbox_center', 'qr_center', 'dm_center'):
        v = item.get(key)
        if isinstance(v, dict):
            for ax, ay in (('x', 'y'), ('u', 'v'), ('cx', 'cy')):
                if ax in v and ay in v:
                    return float(v[ax]), float(v[ay])
        if isinstance(v, (list, tuple)) and len(v) >= 2:
            return float(v[0]), float(v[1])

    # Common bbox formats.
    for key in ('bbox', 'box', 'bbox_xyxy', 'xyxy'):
        b = item.get(key)
        if isinstance(b, dict):
            if all(k in b for k in ('x1', 'y1', 'x2', 'y2')):
                return (float(b['x1']) + float(b['x2'])) * 0.5, (float(b['y1']) + float(b['y2'])) * 0.5
            if all(k in b for k in ('xmin', 'ymin', 'xmax', 'ymax')):
                return (float(b['xmin']) + float(b['xmax'])) * 0.5, (float(b['ymin']) + float(b['ymax'])) * 0.5
        if isinstance(b, (list, tuple)) and len(b) >= 4:
            return (float(b[0]) + float(b[2])) * 0.5, (float(b[1]) + float(b[3])) * 0.5

    return None


def extract_intrinsics_for_servo(payload):
    intr = payload.get('intrinsics') if isinstance(payload.get('intrinsics'), dict) else {}
    fx = float(intr.get('fx', payload.get('fx', 1319.569942)))
    fy = float(intr.get('fy', payload.get('fy', 1278.941324)))
    cx = float(intr.get('cx', payload.get('cx', 926.520878)))
    cy = float(intr.get('cy', payload.get('cy', 346.934588)))
    return fx, fy, cx, cy




def servo_target_match_0311(target_code: str, detected_code: str) -> bool:
    """Match only the requested package.

    target_code can be:
      0311
      S03-L2-0311

    detected_code is usually:
      S03-L2-0311

    It must NOT match 0310 / 0312 / 0309.
    """
    target = str(target_code or '').strip()
    det = str(detected_code or '').strip()
    if not target or not det:
        return False

    if '-' in target:
        return det == target

    return det == target or det.endswith('-' + target)


def servo_extract_rgb_center_px(item):
    """Extract RGB pixel center of the detected DataMatrix item.

    Supports several possible JSON formats from oak_parcel_pose.
    """
    for key in (
        'center_px',
        'center_pixel',
        'center',
        'bbox_center',
        'qr_center',
        'dm_center',
        'pixel_center',
    ):
        v = item.get(key)
        if isinstance(v, dict):
            for ax, ay in (('x', 'y'), ('u', 'v'), ('cx', 'cy')):
                if ax in v and ay in v:
                    return float(v[ax]), float(v[ay])
        if isinstance(v, (list, tuple)) and len(v) >= 2:
            return float(v[0]), float(v[1])

    # If only bbox is available, use bbox center.
    for key in ('bbox', 'box', 'bbox_xyxy', 'xyxy'):
        b = item.get(key)
        if isinstance(b, dict):
            if all(k in b for k in ('x1', 'y1', 'x2', 'y2')):
                return (float(b['x1']) + float(b['x2'])) * 0.5, (float(b['y1']) + float(b['y2'])) * 0.5
            if all(k in b for k in ('xmin', 'ymin', 'xmax', 'ymax')):
                return (float(b['xmin']) + float(b['xmax'])) * 0.5, (float(b['ymin']) + float(b['ymax'])) * 0.5
        if isinstance(b, (list, tuple)) and len(b) >= 4:
            return (float(b[0]) + float(b[2])) * 0.5, (float(b[1]) + float(b[3])) * 0.5

    return None


def servo_get_rgb_intrinsics(payload):
    intr = payload.get('intrinsics') if isinstance(payload.get('intrinsics'), dict) else {}
    fx = float(intr.get('fx', payload.get('fx', 1319.569942)))
    fy = float(intr.get('fy', payload.get('fy', 1278.941324)))
    cx = float(intr.get('cx', payload.get('cx', 926.520878)))
    cy = float(intr.get('cy', payload.get('cy', 346.934588)))
    return fx, fy, cx, cy


@dataclass
class ActiveRequest:
    stage: str = ''
    package_code: str = ''
    shelf_id: str = ''
    shelf_front_yaw: Optional[float] = None
    request_id: str = ''
    start_time: float = 0.0
    timeout_sec: float = 12.0


class OakPackageServoNode(Node):
    def __init__(self) -> None:
        super().__init__('oak_package_servo_node')

        # Topics and frames.
        self.declare_parameter('request_topic', '/target_detection/package_servo/request')
        self.declare_parameter('status_topic', '/target_detection/package_servo/status')
        self.declare_parameter('datamatrix_topic', '/oak/datamatrix_3d_result_json')
        self.declare_parameter('cmd_vel_topic', '/cmd_vel_auto')
        self.declare_parameter('scan_topic', '/scan')
        self.declare_parameter('map_topic', '/map')
        self.declare_parameter('semantic_shelf_topic', '/semantic/current_shelf')
        self.declare_parameter('base_frame', 'base_link')
        self.declare_parameter('oak_frame', 'oak-cam-Link')
        self.declare_parameter('map_frame', 'map')

        # Controller.
        self.declare_parameter('standoff_m', 0.55)
        self.declare_parameter('min_standoff_m', 0.40)
        self.declare_parameter('fine_standoff_m', 0.55)
        self.declare_parameter('kx', 0.35)
        self.declare_parameter('ky', 0.35)
        self.declare_parameter('kyaw', 0.8)
        self.declare_parameter('max_vx', 0.05)
        self.declare_parameter('max_vy', 0.05)
        self.declare_parameter('max_wz', 0.25)
        self.declare_parameter('x_tolerance_m', 0.035)
        self.declare_parameter('y_tolerance_m', 0.025)
        self.declare_parameter('fine_y_tolerance_m', 0.018)
        self.declare_parameter('yaw_tolerance_rad', 0.05)
        self.declare_parameter('target_lock_min_frames', 3)
        self.declare_parameter('target_lost_timeout_sec', 0.8)
        self.declare_parameter('center_error_sign', 1.0)
        self.declare_parameter('filter_alpha', 0.3)
        self.declare_parameter('control_hz', 20.0)
        self.declare_parameter('default_timeout_sec', 12.0)
        self.declare_parameter('fine_timeout_sec', 6.0)
        self.declare_parameter('stop_publish_repeat', 3)
        self.declare_parameter('enable_motion', True)
        self.declare_parameter('debug_log_period_sec', 0.5)

        # Safety.
        self.declare_parameter('oak_hard_stop_m', 0.38)
        self.declare_parameter('shelf_hard_stop_distance_m', 0.35)
        self.declare_parameter('front_stop_m', 0.30)
        self.declare_parameter('side_stop_m', 0.20)
        self.declare_parameter('enable_scan_guard', True)
        self.declare_parameter('enable_map_guard', False)
        self.declare_parameter('map_occupied_threshold', 65)
        self.declare_parameter('predict_time_sec', 0.6)
        self.declare_parameter('footprint_radius_m', 0.25)

        self.request_topic = str(self.get_parameter('request_topic').value)
        self.status_topic = str(self.get_parameter('status_topic').value)
        self.datamatrix_topic = str(self.get_parameter('datamatrix_topic').value)
        self.cmd_vel_topic = str(self.get_parameter('cmd_vel_topic').value)
        self.scan_topic = str(self.get_parameter('scan_topic').value)
        self.map_topic = str(self.get_parameter('map_topic').value)
        self.semantic_shelf_topic = str(self.get_parameter('semantic_shelf_topic').value)
        self.base_frame = str(self.get_parameter('base_frame').value)
        self.oak_frame = str(self.get_parameter('oak_frame').value)
        self.map_frame = str(self.get_parameter('map_frame').value)

        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self)

        self.status_pub = self.create_publisher(String, self.status_topic, 10)
        self.cmd_pub = self.create_publisher(Twist, self.cmd_vel_topic, 10)
        self.req_sub = self.create_subscription(String, self.request_topic, self.on_request, 10)
        self.dm_sub = self.create_subscription(String, self.datamatrix_topic, self.on_datamatrix, 10)
        self.scan_sub = self.create_subscription(LaserScan, self.scan_topic, self.on_scan, 10)
        self.map_sub = self.create_subscription(OccupancyGrid, self.map_topic, self.on_map, 1)
        self.shelf_sub = self.create_subscription(String, self.semantic_shelf_topic, self.on_semantic_shelf, 10)

        self.active = ActiveRequest()
        self.latest_dm_payload: Optional[Dict[str, Any]] = None
        self.latest_target_raw_oak: Optional[Tuple[float, float, float]] = None
        self.filtered_p_oak: Optional[Tuple[float, float, float]] = None
        self.target_seen_time = 0.0
        self.lock_count = 0
        self.latest_scan: Optional[LaserScan] = None
        self.latest_map: Optional[OccupancyGrid] = None
        self.latest_semantic_shelf: Dict[str, Any] = {}
        self.last_log_time = 0.0
        self.last_status: Dict[str, Any] = {}
        self.last_cmd_safe = Twist()
        self.last_chosen_code = ''
        self.last_chosen_source = ''

        hz = float(self.get_parameter('control_hz').value)
        self.timer = self.create_timer(1.0 / max(1.0, hz), self.on_timer)

        self.get_logger().info('oak_package_servo_node started')
        self.get_logger().info(f'request_topic={self.request_topic}, status_topic={self.status_topic}')
        self.get_logger().info(f'datamatrix_topic={self.datamatrix_topic}, cmd_vel_topic={self.cmd_vel_topic}')
        self.get_logger().info(f'frames: base={self.base_frame}, oak={self.oak_frame}, map={self.map_frame}')

    def now_sec(self) -> float:
        return self.get_clock().now().nanoseconds * 1e-9

    def on_request(self, msg: String) -> None:
        try:
            data = json.loads(msg.data)
        except Exception as exc:
            self.get_logger().warn(f'bad request json: {exc}: {msg.data}')
            return

        command = str(data.get('command') or data.get('stage') or data.get('action') or '').lower()
        if command in ('stop', 'cancel', 'halt'):
            self.publish_stop()
            self.active = ActiveRequest()
            self.publish_status('idle', reason='stop requested')
            return

        stage_map = {
            'cache': 'cache',
            'center': 'center',
            'center_align': 'center',
            'approach': 'approach',
            'fine': 'fine',
            'fine_align': 'fine',
        }
        stage = stage_map.get(command, command)
        if stage not in ('cache', 'center', 'approach', 'fine'):
            self.get_logger().warn(f'unsupported servo command: {command}')
            self.publish_status('failed', stage=stage or command, reason='unsupported_command')
            return

        pickup_code = str(data.get('pickup_code') or '').strip()
        raw_package_code = str(data.get('package_code') or data.get('code') or '').strip()
        shelf_id = str(data.get('shelf_id') or '').strip()
        layer_id = str(data.get('layer_id') or '').strip()

        # Servo target must prefer the full pickup code.
        # Example: S03-L2-0311, not only 0311.
        if pickup_code and '-' in pickup_code:
            package_code = pickup_code
        elif raw_package_code and shelf_id and layer_id:
            package_code = f'{shelf_id}-{layer_id}-{raw_package_code}'
        else:
            package_code = raw_package_code or pickup_code
        shelf_front_yaw = None
        for key in ('shelf_front_yaw', 'yaw', 'target_yaw'):
            if key in data:
                try:
                    shelf_front_yaw = float(data[key])
                    break
                except Exception:
                    pass
        timeout = float(data.get('timeout_sec') or self.get_parameter('default_timeout_sec').value)
        if stage == 'fine':
            timeout = float(data.get('timeout_sec') or self.get_parameter('fine_timeout_sec').value)
        req_id = str(data.get('request_id') or f'{stage}_{int(time.time() * 1000)}')

        self.active = ActiveRequest(
            stage=stage,
            package_code=package_code,
            shelf_id=shelf_id,
            shelf_front_yaw=shelf_front_yaw,
            request_id=req_id,
            start_time=self.now_sec(),
            timeout_sec=timeout,
        )
        if stage != 'cache':
            self.lock_count = 0
        self.last_chosen_code = ''
        self.last_chosen_source = ''
        self.publish_status('running', stage=stage, reason='request accepted')
        self.get_logger().info(
            f'[request] stage={stage} package_code={package_code} shelf_id={shelf_id} '
            f'shelf_front_yaw={shelf_front_yaw} timeout={timeout:.1f}'
        )

    def on_datamatrix(self, msg: String) -> None:
        try:
            payload = json.loads(msg.data)
            if isinstance(payload, dict):
                self.latest_dm_payload = payload
        except Exception:
            return

    def on_scan(self, msg: LaserScan) -> None:
        self.latest_scan = msg

    def on_map(self, msg: OccupancyGrid) -> None:
        self.latest_map = msg

    def on_semantic_shelf(self, msg: String) -> None:
        try:
            data = json.loads(msg.data)
            if isinstance(data, dict):
                self.latest_semantic_shelf = data
        except Exception:
            pass

    def find_target_oak(self) -> Optional[Tuple[float, float, float]]:
        payload = self.latest_dm_payload
        if not payload:
            self.last_chosen_code = ''
            self.last_chosen_source = 'no_payload'
            return None

        target_code = self.active.package_code

        target_rgb_center = None
        target_rgb_code = ''

        for item in iter_detection_items(payload):
            code = str(item.get('code') or item.get('text') or item.get('data') or '').strip()

            # Only the requested package can be used.
            # Example: target 0311 / S03-L2-0311 cannot use 0310 or 0312.
            if not servo_target_match_0311(target_code, code):
                continue

            # First priority: use 0311's valid 3D.
            xyz = parse_xyz_mm(item.get('camera_xyz_mm'))
            if xyz is not None:
                cam_x_mm, cam_y_mm, cam_z_mm = xyz
                self.last_chosen_code = code
                self.last_chosen_source = 'target_3d'
                return (cam_z_mm / 1000.0, -cam_x_mm / 1000.0, -cam_y_mm / 1000.0)

            # Second priority for center stage:
            # 0311 depth invalid, but RGB can still give left-right pixel error.
            if self.active.stage == 'center':
                c = servo_extract_rgb_center_px(item)
                if c is not None:
                    target_rgb_center = c
                    target_rgb_code = code
                    break

        if self.active.stage == 'center' and target_rgb_center is not None:
            fx, fy, cx, cy = servo_get_rgb_intrinsics(payload)
            u, v = target_rgb_center

            # Use cache depth only as scale. Center stage does not approach.
            z_m = 0.95
            if getattr(self, 'cached_p_oak', None) is not None and self.cached_p_oak[0] > 0.05:
                z_m = self.cached_p_oak[0]
            elif self.filtered_p_oak is not None and self.filtered_p_oak[0] > 0.05:
                z_m = self.filtered_p_oak[0]
            elif self.latest_target_raw_oak is not None and self.latest_target_raw_oak[0] > 0.05:
                z_m = self.latest_target_raw_oak[0]

            # RGB pixel horizontal error -> camera_x -> OAK y.
            cam_x_m = (u - cx) * z_m / max(1.0, fx)
            cam_y_m = (v - cy) * z_m / max(1.0, fy)

            self.last_chosen_code = target_rgb_code
            self.last_chosen_source = 'target_rgb_2d'
            return (z_m, -cam_x_m, -cam_y_m)

        self.last_chosen_code = ''
        self.last_chosen_source = 'target_not_found'
        return None


    def get_tf_rotation(self, target: str, source: str) -> Optional[List[List[float]]]:
        try:
            ts = self.tf_buffer.lookup_transform(target, source, Time(), timeout=Duration(seconds=0.25))
            return quat_to_mat(ts.transform.rotation)
        except Exception as exc:
            self.throttle_warn('tf', f'TF lookup failed {target} <- {source}: {exc}', 1.0)
            return None

    def get_current_oak_yaw_error(self) -> Tuple[float, bool]:
        target_yaw = self.active.shelf_front_yaw
        if target_yaw is None:
            # Optional fallback from semantic current shelf JSON.
            for key in ('shelf_front_yaw', 'yaw', 'front_yaw'):
                if key in self.latest_semantic_shelf:
                    try:
                        target_yaw = float(self.latest_semantic_shelf[key])
                        break
                    except Exception:
                        pass
        if target_yaw is None:
            return 0.0, False

        r_map_oak = self.get_tf_rotation(self.map_frame, self.oak_frame)
        if r_map_oak is None:
            return 0.0, False
        fwd_map = mat_vec(r_map_oak, (1.0, 0.0, 0.0))
        oak_yaw = math.atan2(fwd_map[1], fwd_map[0])
        return norm_angle(float(target_yaw) - oak_yaw), True

    def get_base_map_yaw(self) -> Optional[float]:
        try:
            ts = self.tf_buffer.lookup_transform(self.map_frame, self.base_frame, Time(), timeout=Duration(seconds=0.15))
            r = quat_to_mat(ts.transform.rotation)
            fwd = mat_vec(r, (1.0, 0.0, 0.0))
            return math.atan2(fwd[1], fwd[0])
        except Exception:
            return None

    def update_target_filter(self) -> Tuple[Optional[Tuple[float, float, float]], float, bool]:
        now = self.now_sec()
        p = self.find_target_oak()
        if p is not None:
            self.latest_target_raw_oak = p
            self.target_seen_time = now
            self.lock_count += 1
            alpha = float(self.get_parameter('filter_alpha').value)
            alpha = clamp(alpha, 0.0, 1.0)
            if self.filtered_p_oak is None:
                self.filtered_p_oak = p
            else:
                old = self.filtered_p_oak
                self.filtered_p_oak = (
                    (1.0 - alpha) * old[0] + alpha * p[0],
                    (1.0 - alpha) * old[1] + alpha * p[1],
                    (1.0 - alpha) * old[2] + alpha * p[2],
                )
        lost_sec = now - self.target_seen_time if self.target_seen_time > 0 else 999.0
        locked = self.lock_count >= int(self.get_parameter('target_lock_min_frames').value)
        return self.filtered_p_oak, lost_sec, locked

    def scan_guard_blocks(self, cmd: Twist) -> Tuple[Twist, List[str]]:
        reasons = []
        if not bool(self.get_parameter('enable_scan_guard').value):
            return cmd, reasons
        scan = self.latest_scan
        if scan is None:
            return cmd, reasons
        front_stop = float(self.get_parameter('front_stop_m').value)
        side_stop = float(self.get_parameter('side_stop_m').value)
        front_min = self.min_range_in_sector(scan, -20.0, 20.0)
        left_min = self.min_range_in_sector(scan, 55.0, 125.0)
        right_min = self.min_range_in_sector(scan, -125.0, -55.0)
        if front_min is not None and front_min < front_stop and cmd.linear.x > 0.0:
            cmd.linear.x = 0.0
            reasons.append(f'scan_front_stop:{front_min:.2f}')
        if left_min is not None and left_min < side_stop and cmd.linear.y > 0.0:
            cmd.linear.y = 0.0
            reasons.append(f'scan_left_stop:{left_min:.2f}')
        if right_min is not None and right_min < side_stop and cmd.linear.y < 0.0:
            cmd.linear.y = 0.0
            reasons.append(f'scan_right_stop:{right_min:.2f}')
        return cmd, reasons

    @staticmethod
    def min_range_in_sector(scan: LaserScan, deg_min: float, deg_max: float) -> Optional[float]:
        vals = []
        for i, r in enumerate(scan.ranges):
            if not math.isfinite(r):
                continue
            if r < scan.range_min or r > scan.range_max:
                continue
            ang = scan.angle_min + i * scan.angle_increment
            deg = math.degrees(ang)
            if deg_min <= deg <= deg_max:
                vals.append(float(r))
        return min(vals) if vals else None

    def map_guard(self, cmd: Twist) -> Tuple[Twist, List[str]]:
        reasons = []
        if not bool(self.get_parameter('enable_map_guard').value):
            return cmd, reasons
        grid = self.latest_map
        if grid is None:
            return cmd, reasons
        yaw = self.get_base_map_yaw()
        if yaw is None:
            return cmd, reasons
        # Very conservative check: predict base center only. Footprint expansion is left as safety margin.
        try:
            tf = self.tf_buffer.lookup_transform(self.map_frame, self.base_frame, Time(), timeout=Duration(seconds=0.15))
        except Exception:
            return cmd, reasons
        dt = float(self.get_parameter('predict_time_sec').value)
        dx = math.cos(yaw) * cmd.linear.x * dt - math.sin(yaw) * cmd.linear.y * dt
        dy = math.sin(yaw) * cmd.linear.x * dt + math.cos(yaw) * cmd.linear.y * dt
        x = tf.transform.translation.x + dx
        y = tf.transform.translation.y + dy
        if self.map_occupied(grid, x, y):
            cmd.linear.x = 0.0
            cmd.linear.y = 0.0
            reasons.append('map_predicted_collision')
        return cmd, reasons

    def map_occupied(self, grid: OccupancyGrid, x: float, y: float) -> bool:
        res = grid.info.resolution
        ox = grid.info.origin.position.x
        oy = grid.info.origin.position.y
        mx = int((x - ox) / res)
        my = int((y - oy) / res)
        if mx < 0 or my < 0 or mx >= grid.info.width or my >= grid.info.height:
            return False
        idx = my * grid.info.width + mx
        val = int(grid.data[idx])
        return val >= int(self.get_parameter('map_occupied_threshold').value)

    def publish_stop(self) -> None:
        msg = Twist()
        for _ in range(int(self.get_parameter('stop_publish_repeat').value)):
            self.cmd_pub.publish(msg)
        self.last_cmd_safe = msg

    def throttle_warn(self, key: str, text: str, period: float) -> None:
        now = time.time()
        attr = f'_last_warn_{key}'
        last = getattr(self, attr, 0.0)
        if now - last >= period:
            self.get_logger().warn(text)
            setattr(self, attr, now)

    def on_timer(self) -> None:
        if not self.active.stage:
            return
        stage = self.active.stage
        now = self.now_sec()
        if stage == 'cache':
            p, lost_sec, locked = self.update_target_filter()
            if p is not None:
                self.publish_status('succeeded', stage=stage, p_oak=p, reason='cached')
                self.active = ActiveRequest()
                return
            if now - self.active.start_time > self.active.timeout_sec:
                self.publish_status('failed', stage=stage, reason='no_target')
                self.active = ActiveRequest()
                return
            self.publish_status('running', stage=stage, reason='waiting_target')
            return

        if now - self.active.start_time > self.active.timeout_sec:
            self.publish_stop()
            self.publish_status('failed', stage=stage, reason='timeout')
            self.active = ActiveRequest()
            return

        p_oak, lost_sec, locked = self.update_target_filter()
        if p_oak is None:
            self.publish_stop()
            self.publish_status('running', stage=stage, reason='waiting_target', target_lost_sec=lost_sec)
            return
        if lost_sec >= float(self.get_parameter('target_lost_timeout_sec').value):
            self.publish_stop()
            self.publish_status('failed', stage=stage, reason='target_lost_timeout', target_lost_sec=lost_sec)
            self.active = ActiveRequest()
            return

        r_base_oak = self.get_tf_rotation(self.base_frame, self.oak_frame)
        if r_base_oak is None:
            self.publish_stop()
            self.publish_status('running', stage=stage, reason='waiting_tf', target_lost_sec=lost_sec)
            return

        standoff = max(float(self.get_parameter('standoff_m').value), float(self.get_parameter('min_standoff_m').value))
        if stage == 'fine':
            standoff = max(float(self.get_parameter('fine_standoff_m').value), float(self.get_parameter('min_standoff_m').value))

        if stage == 'center':
            center_sign = float(self.get_parameter('center_error_sign').value)
            e_oak = (0.0, center_sign * p_oak[1], 0.0)
            tol_x = 999.0
            tol_y = float(self.get_parameter('y_tolerance_m').value)
        else:
            e_oak = (p_oak[0] - standoff, p_oak[1], 0.0)
            tol_x = float(self.get_parameter('x_tolerance_m').value)
            tol_y = float(self.get_parameter('fine_y_tolerance_m').value if stage == 'fine' else self.get_parameter('y_tolerance_m').value)

        e_base = mat_vec(r_base_oak, e_oak)
        yaw_error, yaw_ok_src = self.get_current_oak_yaw_error()

        kx = float(self.get_parameter('kx').value)
        ky = float(self.get_parameter('ky').value)
        kyaw = float(self.get_parameter('kyaw').value)

        cmd = Twist()
        # Important: even center alignment uses both base x/y after URDF rotation.
        # This keeps OAK-side or OAK-diagonal installation correct.
        gain_x = ky if stage == 'center' else kx
        cmd.linear.x = gain_x * e_base[0]
        cmd.linear.y = ky * e_base[1]
        cmd.angular.z = kyaw * yaw_error if yaw_ok_src else 0.0

        raw_tuple = (cmd.linear.x, cmd.linear.y, cmd.angular.z)
        cmd, safety_reasons = self.apply_safety(cmd, p_oak, r_base_oak)
        cmd.linear.x = clamp(cmd.linear.x, -float(self.get_parameter('max_vx').value), float(self.get_parameter('max_vx').value))
        cmd.linear.y = clamp(cmd.linear.y, -float(self.get_parameter('max_vy').value), float(self.get_parameter('max_vy').value))
        cmd.angular.z = clamp(cmd.angular.z, -float(self.get_parameter('max_wz').value), float(self.get_parameter('max_wz').value))

        reached = locked and abs(e_oak[1]) <= tol_y and abs(yaw_error) <= float(self.get_parameter('yaw_tolerance_rad').value)
        if stage in ('approach', 'fine'):
            reached = reached and abs(e_oak[0]) <= tol_x
        if reached:
            self.publish_stop()
            self.publish_status(
                'succeeded', stage=stage, p_oak=p_oak, e_oak=e_oak, e_base=e_base,
                yaw_error=yaw_error, cmd_raw=raw_tuple, cmd_safe=(0.0, 0.0, 0.0),
                safety=safety_reasons, reason='reached', target_lost_sec=lost_sec,
            )
            self.active = ActiveRequest()
            return

        if bool(self.get_parameter('enable_motion').value):
            self.cmd_pub.publish(cmd)
        self.last_cmd_safe = cmd
        self.publish_status(
            'running', stage=stage, p_oak=p_oak, e_oak=e_oak, e_base=e_base,
            yaw_error=yaw_error, cmd_raw=raw_tuple,
            cmd_safe=(cmd.linear.x, cmd.linear.y, cmd.angular.z),
            safety=safety_reasons, target_lost_sec=lost_sec, target_locked=locked,
        )

    def apply_safety(self, cmd: Twist, p_oak: Tuple[float, float, float], r_base_oak: List[List[float]]) -> Tuple[Twist, List[str]]:
        reasons: List[str] = []
        # OAK hard stop: if too close, remove any command component that moves along OAK +x.
        oak_hard_stop = float(self.get_parameter('oak_hard_stop_m').value)
        if p_oak[0] < oak_hard_stop:
            cmd_oak = mat_t_vec(r_base_oak, (cmd.linear.x, cmd.linear.y, 0.0))
            if cmd_oak[0] > 0.0:
                # Remove the OAK-forward component from base command.
                forward_base = mat_vec(r_base_oak, (cmd_oak[0], 0.0, 0.0))
                cmd.linear.x -= forward_base[0]
                cmd.linear.y -= forward_base[1]
                reasons.append('oak_hard_stop')
        cmd, r1 = self.scan_guard_blocks(cmd)
        reasons.extend(r1)
        cmd, r2 = self.map_guard(cmd)
        reasons.extend(r2)
        return cmd, reasons

    def publish_status(self, status: str, **kwargs: Any) -> None:
        data: Dict[str, Any] = {
            'stamp': self.now_sec(),
            'status': status,
            'stage': kwargs.pop('stage', self.active.stage),
            'request_id': self.active.request_id,
            'package_code': self.active.package_code,
            'shelf_id': self.active.shelf_id,
        }
        data.update(kwargs)
        data['chosen_code'] = getattr(self, 'last_chosen_code', '')
        data['chosen_source'] = getattr(self, 'last_chosen_source', '')
        # Flatten numeric tuples for grep/echo readability.
        for name in ('p_oak', 'e_oak', 'e_base', 'cmd_raw', 'cmd_safe'):
            v = data.get(name)
            if isinstance(v, tuple):
                data[name] = {'x': v[0], 'y': v[1], 'z': v[2]}
        self.last_status = data
        msg = String()
        msg.data = json.dumps(data, ensure_ascii=False)
        self.status_pub.publish(msg)

        now = time.time()
        period = float(self.get_parameter('debug_log_period_sec').value)
        if now - self.last_log_time >= period or status in ('succeeded', 'failed'):
            self.last_log_time = now
            p = data.get('p_oak') or {}
            e = data.get('e_oak') or {}
            b = data.get('e_base') or {}
            c = data.get('cmd_safe') or {}
            self.get_logger().info(
                f"[servo] stage={data.get('stage')} status={status} "
                f"p_oak=({float(p.get('x', 0.0)):+.3f},{float(p.get('y', 0.0)):+.3f}) "
                f"e_oak=({float(e.get('x', 0.0)):+.3f},{float(e.get('y', 0.0)):+.3f}) "
                f"e_base=({float(b.get('x', 0.0)):+.3f},{float(b.get('y', 0.0)):+.3f}) "
                f"yaw_err={float(data.get('yaw_error', 0.0)):+.3f} "
                f"cmd=({float(c.get('x', 0.0)):+.3f},{float(c.get('y', 0.0)):+.3f},{float(c.get('z', 0.0)):+.3f}) "
                f"reason={data.get('reason', '')} safety={data.get('safety', [])}"
            )


def main(args=None) -> None:
    rclpy.init(args=args)
    node = OakPackageServoNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            if rclpy.ok():
                node.publish_stop()
        except Exception:
            pass
        try:
            node.destroy_node()
        except Exception:
            pass
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
