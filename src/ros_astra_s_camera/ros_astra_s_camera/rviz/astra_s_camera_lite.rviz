Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RGB Image1
        - /Depth Image1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Name: RGB Image
      Enabled: true
      Value: true
      Topic:
        Value: /camera/rgb/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Min Value: 0
      Max Value: 255
      Median window: 1

    - Class: rviz_default_plugins/Image
      Name: Depth Image
      Enabled: true
      Value: true
      Topic:
        Value: /camera/depth/image
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Min Value: 0
      Max Value: 5000
      Median window: 1

    - Class: rviz_default_plugins/PointStamped
      Name: Target Point
      Enabled: false
      Value: false
      Topic:
        Value: /astra_s/target_point
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 25; 0
      Radius: 0.05
      History Length: 1

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_link
    Frame Rate: 15
  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select

  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Value: Orbit
      Target Frame: camera_link
      Distance: 2
      Pitch: 0.55
      Yaw: 2.8
      Near Clip Distance: 0.01
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Enable Stereo Rendering:
        Value: false
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
    Saved: []

Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 820
  Width: 1180
  X: 50
  Y: 50
