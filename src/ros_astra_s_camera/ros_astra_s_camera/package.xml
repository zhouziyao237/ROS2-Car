<?xml version="1.0"?>
<package format="3">
  <name>ros_astra_s_camera</name>
  <version>0.1.0</version>
  <description>Astra S OpenNI2 camera package with RGB-D millimeter localization, custom messages, RViz config, and depth calibration.</description>

  <maintainer email="your_email@example.com">your_name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>ros_astra_s_camera_msgs</exec_depend>
  <exec_depend>openni2_camera</exec_depend>
  <exec_depend>camera_calibration</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
