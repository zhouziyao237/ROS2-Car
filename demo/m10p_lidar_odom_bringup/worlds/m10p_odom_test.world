<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="m10p_odom_test_world">
    <physics name="default_physics" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Boundary walls: enough large-scale structure for scan matching. -->
    <model name="north_wall">
      <static>true</static><pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.12 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.12 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.12 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 8 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 8 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- Asymmetric obstacles reduce ICP degeneracy compared with an empty square room. -->
    <model name="box_1">
      <static>true</static><pose>1.7 1.0 0.35 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 0.9 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.9 0.7</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static><pose>-1.4 1.8 0.3 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.45 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.45 0.6</size></box></geometry><material><ambient>0.2 0.6 0.8 1</ambient></material></visual>
      </link>
    </model>
    <model name="cylinder_1">
      <static>true</static><pose>1.0 -1.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry><material><ambient>0.2 0.8 0.3 1</ambient></material></visual>
      </link>
    </model>
    <model name="thin_wall_oblique">
      <static>true</static><pose>-1.8 -1.3 0.35 0 0 0.8</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.3 0.08 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.3 0.08 0.7</size></box></geometry><material><ambient>0.6 0.4 0.9 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
