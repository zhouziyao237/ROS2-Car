<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="scan_sensor" params="prefix use_sim:=true">

    <!-- 连杆定义（保持不变） -->
    <link name="${prefix}_Link">
      <inertial>
        <origin xyz="-0.00250631530381207 4.56584853758546E-06 0.00608264669062357" rpy="0 0 0"/>
        <mass value="0.0374307357500632"/>
        <inertia ixx="2.80476493090254E-05" ixy="-2.19899695277469E-09" ixz="-1.07121854785562E-06"
                 iyy="3.36164872297249E-05" iyz="-6.8396885171025E-10" izz="4.50845442757731E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://chassis/meshes/scan_Link.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.376470588235294 0.376470588235294 0.376470588235294 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://chassis/meshes/scan_Link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_Joint" type="fixed">
      <origin xyz="0.177 0 0.050075" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_Link"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- 仿真专用：Gazebo 雷达插件 -->
    <xacro:if value="${use_sim}">
      <gazebo reference="${prefix}_Link">
        <sensor name="laserscan" type="ray">   <!-- 若仍无扫描线，可保留 gpu_ray，但 ray 更通用 -->
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <pose>0 0 0 0 0 0</pose>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1.0</resolution>
                <min_angle>0.0</min_angle>
                <max_angle>6.28318</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8.0</max>
              <resolution>0.015</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
          <plugin name="laserscan" filename="libgazebo_ros_ray_sensor.so">
            <!-- ROS 2 推荐直接使用 <topic>，不再需要 <remapping> -->
            <topic>scan</topic>
            <frame_name>${prefix}_Link</frame_name>
            <output_type>sensor_msgs/LaserScan</output_type>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>