<robot name="chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== 仿真/实物切换参数 ========== -->

  <!-- 接收从 launch 传入的物理参数（需与 launch 中 xacro 参数名一致） -->
  <xacro:arg name="wheel_mu1" default="0.8"/>
  <xacro:arg name="wheel_mu2" default="0.6"/>
  <xacro:arg name="wheel_kp" default="100000.0"/>
  <xacro:arg name="wheel_kd" default="10.0"/>

  <xacro:arg name="use_sim" default="true"/>
  <xacro:property name="mecanum_config" value="$(find chassis)/config/robot_config.yaml" />

  <xacro:include filename="$(find chassis)/urdf/scan_sensor.xacro" />
  <xacro:include filename="$(find chassis)/urdf/mecanum.xacro" />

  <!-- 调用宏，传入物理参数 -->
  <xacro:mecanum_drive
      use_sim="$(arg use_sim)"
      config_path="$(find chassis)/config/robot_config.yaml"
      wheel_mu1="$(arg wheel_mu1)"
      wheel_mu2="$(arg wheel_mu2)"
      wheel_kp="$(arg wheel_kp)"
      wheel_kd="$(arg wheel_kd)"
  />

  <xacro:scan_sensor prefix="scan" use_sim="$(arg use_sim)"/>
  <xacro:mecanum_drive use_sim="$(arg use_sim)" config_path="${mecanum_config}"/>

