<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mecanum_drive" params="use_sim:=true">
    <xacro:if value="${use_sim}">
      <gazebo>
        <!-- 麦轮驱动插件 -->
        <plugin name="mecanum_drive" filename="libgazebo_ros_mecanum_drive.so">
          <ros>
            <remapping>cmd_vel:=cmd_vel</remapping>
          </ros>
          <left_front_joint>FL_Joint</left_front_joint>
          <right_front_joint>FR_Joint</right_front_joint>
          <left_rear_joint>BL_Joint</left_rear_joint>
          <right_rear_joint>BR_Joint</right_rear_joint>
          <wheel_radius>0.0375</wheel_radius>
          <wheel_separation>0.4166</wheel_separation>
          <wheel_base>0.1550</wheel_base>
          <robot_base_frame>base_footprint</robot_base_frame>
          <odometry_frame>odom</odometry_frame>
          <publish_wheel_tf>false</publish_wheel_tf>
          <publish_odometry>true</publish_odometry>
          <publish_odom_tf>true</publish_odom_tf>
        </plugin>

        <!-- 关节状态发布插件 -->
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
          <ros>
            <remapping>~/out:=joint_states</remapping>
          </ros>
          <update_rate>30</update_rate>
          <joint_name>FL_Joint</joint_name>
          <joint_name>FR_Joint</joint_name>
          <joint_name>BL_Joint</joint_name>
          <joint_name>BR_Joint</joint_name>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>