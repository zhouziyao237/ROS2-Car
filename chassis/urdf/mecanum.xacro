<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mecanum_drive" params="use_sim:=true config_path:=''">
    <xacro:if value="${use_sim}">
      <gazebo>
        <plugin name="my_mecanum_plugin" filename="libmecanum_drive_plugin.so">
          <config_file>${config_path}</config_file>
        </plugin>
      </gazebo>
      <gazebo>
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
          <ros>
            <remapping>~/out:=joint_states</remapping>
          </ros>
          <update_rate>50</update_rate>
          <joint_name>FL_Joint</joint_name>
          <joint_name>FR_Joint</joint_name>
          <joint_name>BL_Joint</joint_name>
          <joint_name>BR_Joint</joint_name>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>