<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mecanum_drive" params="use_sim:=true config_path:=''
               wheel_mu1:=0.8 wheel_mu2:=0.6 wheel_kp:=100000.0 wheel_kd:=10.0">
    <xacro:if value="${use_sim}">
      <!-- 自定义麦轮驱动插件 -->
      <gazebo>
        <plugin name="my_mecanum_plugin" filename="libmecanum_drive_plugin.so">
          <config_file>${config_path}</config_file>
        </plugin>
      </gazebo>

      <!-- 关节状态发布插件 -->
      <gazebo>
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
          <ros>
            <remapping>~/out:=joint_states</remapping>
          </ros>
          <update_rate>50</update_rate>
          <joint_name>FL_Joint</joint_name>
          <joint_name>FR_Joint</joint_name>
          <joint_name>BL_Joint</joint_name>
          <joint_name>BR_Joint</joint_name>
        </plugin>
      </gazebo>

      <!-- 轮子物理属性（统一配置） -->
      <gazebo reference="FL_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>
      <gazebo reference="FR_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>
      <gazebo reference="BL_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>
      <gazebo reference="BR_Link">
        <mu1>${wheel_mu1}</mu1>
        <mu2>${wheel_mu2}</mu2>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>